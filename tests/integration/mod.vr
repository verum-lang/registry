// Verum Registry - Integration Tests Module
//
// Exports all integration test modules for the verum-registry.
// These tests verify end-to-end functionality across all API endpoints.

module verum_registry.tests.integration;

mount core.*;

// Package lifecycle tests
public mount verum_registry.tests.integration.package_tests.*;

// User authentication and profile tests
public mount verum_registry.tests.integration.user_tests.*;

// Token-based authentication tests
public mount verum_registry.tests.integration.auth_tests.*;

// Package ownership management tests
public mount verum_registry.tests.integration.ownership_tests.*;

// Admin operations tests
public mount verum_registry.tests.integration.admin_tests.*;

// Resilience patterns tests
public mount verum_registry.tests.integration.resilience_tests.*;

// Input validation tests
public mount verum_registry.tests.integration.validation_tests.*;

// Publish flow end-to-end tests
public mount verum_registry.tests.integration.publish_flow_test.*;

// Security service tests
public mount verum_registry.tests.integration.security_test.*;

// Sumdb transparent log tests
public mount verum_registry.tests.integration.sumdb_test.*;
