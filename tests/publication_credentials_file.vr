// T1636: actual file loading and deterministic typed reader boundaries.
module verum_registry.tests.publication_credentials_file;

mount core.io.protocols.{Read, IoResult, IoErrorKind, StreamError};
mount verum_registry.protocol.authority.{Authority, AuthorityRole, NamePattern, PackageName};
mount verum_registry.node.publication_auth.{
    CredentialStore, CredentialConfigError, authenticate, authorize, credential_config_limit,
};
mount verum_registry.node.publication_credentials_file.{CredentialLoadError, read_credentials, load_credentials};

type ReaderMode is | Normal | Fail | NegativeCount | ExcessCount;
type FixtureReader is { bytes: List<Byte>, position: Int, chunk: Int, mode: ReaderMode };

implement Read for FixtureReader {
    fn read(&mut self, buffer: &mut [Byte]) -> IoResult<Int> {
        match self.mode {
            ReaderMode.Fail => return Result.Err(StreamError.with_message(IoErrorKind.PermissionDenied, "fixture read error")),
            ReaderMode.NegativeCount => return Result.Ok(-1),
            ReaderMode.ExcessCount => return Result.Ok(buffer.len() + 1),
            ReaderMode.Normal => {},
        }
        let mut count = 0;
        while count < buffer.len() && count < self.chunk && self.position < self.bytes.len() {
            buffer[count] = self.bytes[self.position];
            self.position = self.position + 1;
            count = count + 1;
        }
        Result.Ok(count)
    }
}

fn authorities() -> List<Authority> {
    [Authority { id: "local", role: AuthorityRole.Local, owns: [
        NamePattern.Exact("widget"), NamePattern.Exact("other-widget"), NamePattern.Scope("@acme"),
    ] }]
}

fn bytes(source: &Text) -> List<Byte> {
    let mut result: List<Byte> = List.new();
    for byte in source.bytes() { result.push(byte); }
    result
}

fn reader(source: &Text, chunk: Int) -> FixtureReader {
    FixtureReader { bytes: bytes(source), position: 0, chunk: chunk, mode: ReaderMode.Normal }
}

fn empty_configuration() -> Text { "{\"version\":1,\"principals\":[],\"credentials\":[]}" }

fn credential(store: &CredentialStore) {
    let token = "vrp1_000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f";
    let publisher = match authenticate(store, &token) {
        Result.Ok(value) => value, _ => panic("loaded credential must verify"),
    };
    match authorize(publisher, &PackageName("widget"), &authorities()) {
        Result.Ok(value) => assert_eq(value.principal_id(), "alice"),
        _ => panic("loaded credential scope"),
    }
}

fn file_boundary() {
    // The runner copies this exact, hashed test-only asset into the project.
    match load_credentials(&"tests/fixtures/publication_auth/credentials-v1.json", &authorities()) {
        Result.Ok(store) => credential(&store),
        Result.Err(_) => panic("fixture file must load through actual File.open/Read"),
    }
    match load_credentials(&"tests/fixtures/publication_auth/absent.json", &authorities()) {
        Result.Err(CredentialLoadError.Io(error)) => assert(error.kind() is IoErrorKind.NotFound),
        _ => panic("missing file cannot become an empty store"),
    }
}

fn reader_boundary() {
    for chunk in [1, 7, 4096] {
        let mut input = reader(&empty_configuration(), chunk);
        assert(read_credentials(&mut input, &authorities()) is Result.Ok(_));
        assert_eq(input.position, input.bytes.len());
    }
    let mut failed = reader(&empty_configuration(), 1); failed.mode = ReaderMode.Fail;
    match read_credentials(&mut failed, &authorities()) {
        Result.Err(CredentialLoadError.Io(error)) => {
            assert(error.kind() is IoErrorKind.PermissionDenied);
            match error.message() { Maybe.Some(text) => assert_eq(text, "fixture read error"), _ => panic("lost I/O error payload") }
        },
        _ => panic("read error cannot become config syntax or empty success"),
    }
    for mode in [ReaderMode.NegativeCount, ReaderMode.ExcessCount] {
        let mut invalid = reader(&empty_configuration(), 1); invalid.mode = mode;
        match read_credentials(&mut invalid, &authorities()) {
            Result.Err(CredentialLoadError.Io(error)) => assert(error.kind() is IoErrorKind.Other),
            _ => panic("invalid read count authorized buffer indexing"),
        }
    }
    let mut utf8 = FixtureReader { bytes: [255_u8], position: 0, chunk: 1, mode: ReaderMode.Normal };
    assert(read_credentials(&mut utf8, &authorities()) is Result.Err(CredentialLoadError.Config(CredentialConfigError.InvalidUtf8)));
    let mut empty = reader(&"", 1);
    assert(read_credentials(&mut empty, &authorities()) is Result.Err(CredentialLoadError.Config(CredentialConfigError.Syntax(_))));
    let mut truncated = reader(&"{\"version\":1", 1);
    assert(read_credentials(&mut truncated, &authorities()) is Result.Err(CredentialLoadError.Config(CredentialConfigError.Syntax(_))));
    let source = empty_configuration();
    let padding = " ".repeat(credential_config_limit() - source.len());
    let bounded = f"{source}{padding}";
    let mut at_limit = reader(&bounded, 4096);
    assert(read_credentials(&mut at_limit, &authorities()) is Result.Ok(_));
    let mut excess = reader(&f"{bounded} ", 4096);
    assert(read_credentials(&mut excess, &authorities()) is Result.Err(CredentialLoadError.Config(CredentialConfigError.TooLarge)));
}

fn main() {
    reader_boundary();
    file_boundary();
    print("publication-credentials-file: ok");
}
