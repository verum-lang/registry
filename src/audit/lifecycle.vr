// =============================================================================
// verum_registry/audit/lifecycle.vr — corpus-wide Lifecycle observatory
// =============================================================================
//
// Spec: §12.3; architecture-types/cve/seven-symbols.md
//
// The Lifecycle distribution is a load-bearing health metric: a
// healthy Verum corpus shows a strong tail of `[T]` Theorem cogs and
// minimal `[H]` Hypothesis / `[I]` Interpretation entries. The
// distribution surfaced here drives the registry's quarterly
// transparency report.
//
// Additionally, this module exposes detection of AP-009
// LifecycleRegression — when a high-rank cog cites a low-rank cog
// (e.g., a Theorem citing a Hypothesis). This is a corpus-wide
// invariant — individual publishes are checked at Phase 5b but the
// observatory recomputes on schedule to catch transitive violations
// (AP-021 / AP-024).
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Theorem("canonical"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "corpus-wide Lifecycle distribution + AP-009 poset-violation detection".to_text(),
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.audit.lifecycle;

mount core.*;
mount base.{Result, Ok, Err, Maybe, Some, None, Text, Int};
mount collections.{List, Map};
mount architecture.types.Lifecycle;

mount verum_registry.audit.anti_patterns.AuditError;

// =============================================================================
// Distribution
// =============================================================================

@derive(Clone, Debug)
public type LifecycleDistribution is {
    /// `[T]` Theorem count.
    theorem: Int { >= 0 },
    /// `[D]` Definition count.
    definition: Int { >= 0 },
    /// `[C]` Conditional count.
    conditional: Int { >= 0 },
    /// `[P]` Postulate count.
    postulate: Int { >= 0 },
    /// `[H]` Hypothesis count.
    hypothesis: Int { >= 0 },
    /// `[I]` Interpretation count.
    interpretation: Int { >= 0 },
    /// `[✗]` Retracted count.
    retracted: Int { >= 0 },
    /// Total surveyed.
    total: Int { >= 0 },
};

/// Compute the Lifecycle distribution across all currently-published
/// (non-yanked) versions in the registry.
pub async fn lifecycle_distribution_for_corpus() -> Result<LifecycleDistribution, AuditError>
    using [Database]
{
    let rows = sql#"""
        SELECT cve_lifecycle, COUNT(*) AS n
        FROM versions
        WHERE NOT yanked
        GROUP BY cve_lifecycle
    """.fetch_all().await
        .map_err(|e| AuditError.QueryFailed(f"{e}"))?;

    let mut dist = LifecycleDistribution {
        theorem: 0, definition: 0, conditional: 0, postulate: 0,
        hypothesis: 0, interpretation: 0, retracted: 0, total: 0,
    };
    let mut i: Int = 0;
    while i < rows.len() {
        let r = &rows[i];
        let n = r.n;
        dist.total = dist.total + n;
        match r.cve_lifecycle.as_str() {
            // Theorem variants are written as "Theorem(<version>)".
            s if s.starts_with("Theorem") => dist.theorem        = dist.theorem + n,
            "Definition"                  => dist.definition     = dist.definition + n,
            "Conditional"                 => dist.conditional    = dist.conditional + n,
            "Postulate"                   => dist.postulate      = dist.postulate + n,
            "Hypothesis"                  => dist.hypothesis     = dist.hypothesis + n,
            "Interpretation"              => dist.interpretation = dist.interpretation + n,
            "Retracted"                   => dist.retracted      = dist.retracted + n,
            _ => {}
        }
        i = i + 1;
    }
    Ok(dist)
}

@derive(FromRow)
type LifecycleRow is {
    cve_lifecycle: Text,
    n: Int,
};

// =============================================================================
// Poset violations (AP-009 transitive)
// =============================================================================

@derive(Clone, Debug)
public type PosetViolation is {
    /// The high-rank cog citing the lower-rank cog.
    high_rank_cog: Text,
    high_rank: Text,
    /// The low-rank cited cog (transitive — at any depth).
    low_rank_cog: Text,
    low_rank: Text,
    /// Citation depth (1 = direct dependency).
    depth: Int { >= 1 },
};

/// Walk the dependency graph and report every (cog, dep) pair where
/// the cog has rank > dep's rank in the CVE poset
/// `T > D = C = P > H > I > ✗`.
///
/// This is the registry-side detector for AP-021 (transitive
/// Lifecycle regression) and AP-024 (Lifecycle regression via
/// transitive deps). Per-publish checks at Phase 5b only see direct
/// dependencies; the corpus-wide observatory catches transitive cases.
pub async fn detect_poset_violations(max_depth: Int) -> Result<List<PosetViolation>, AuditError>
    using [Database]
{
    let rows = sql#"""
        WITH RECURSIVE dep_walk AS (
            SELECT
                p.id || '@' || v.version AS source_cog,
                v.cve_lifecycle           AS source_lifecycle,
                d.dep_id                   AS target_cog_name,
                1::INTEGER                 AS depth
            FROM versions v
            JOIN packages p ON p.id = v.package_id
            CROSS JOIN LATERAL (
                SELECT key AS dep_id FROM jsonb_object_keys(v.dependencies)
            ) AS d
            WHERE NOT v.yanked
          UNION ALL
            SELECT
                w.source_cog,
                w.source_lifecycle,
                d2.dep_id,
                w.depth + 1
            FROM dep_walk w
            JOIN packages p2 ON p2.id = split_part(w.target_cog_name, '@', 1)
            JOIN versions v2 ON v2.package_id = p2.id
            CROSS JOIN LATERAL (
                SELECT key AS dep_id FROM jsonb_object_keys(v2.dependencies)
            ) AS d2
            WHERE w.depth < ${max_depth}
              AND NOT v2.yanked
        )
        SELECT
            dw.source_cog,
            dw.source_lifecycle,
            dw.target_cog_name AS target_cog,
            v3.cve_lifecycle    AS target_lifecycle,
            dw.depth
        FROM dep_walk dw
        JOIN packages p3 ON p3.id = split_part(dw.target_cog_name, '@', 1)
        JOIN versions v3 ON v3.package_id = p3.id
        WHERE NOT v3.yanked
          AND lifecycle_rank(dw.source_lifecycle) > lifecycle_rank(v3.cve_lifecycle)
        ORDER BY dw.depth, dw.source_cog
    """.fetch_all().await
        .map_err(|e| AuditError.QueryFailed(f"{e}"))?;

    let mut out: List<PosetViolation> = List.with_capacity(rows.len());
    let mut i: Int = 0;
    while i < rows.len() {
        let r = &rows[i];
        out.push(PosetViolation {
            high_rank_cog: r.source_cog.clone(),
            high_rank:     r.source_lifecycle.clone(),
            low_rank_cog:  r.target_cog.clone(),
            low_rank:      r.target_lifecycle.clone(),
            depth:         r.depth,
        });
        i = i + 1;
    }
    Ok(out)
}

@derive(FromRow)
type PosetRow is {
    source_cog: Text,
    source_lifecycle: Text,
    target_cog: Text,
    target_lifecycle: Text,
    depth: Int,
};
