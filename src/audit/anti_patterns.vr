    out.push(AntiPatternId.AP_010_CveIncomplete);
    out.push(AntiPatternId.AP_011_AbsoluteBoundaryAttempt);
    out.push(AntiPatternId.AP_012_LinearCapabilityFlavour);
    out.push(AntiPatternId.AP_013_AffineCapabilityFlavour);
    out.push(AntiPatternId.AP_014_RelevantCapabilityFlavour);
    out.push(AntiPatternId.AP_015_BoundaryInvariantViolation);
    out.push(AntiPatternId.AP_016_WireEncodingMismatch);
    out.push(AntiPatternId.AP_017_AuthenticationGap);
    out.push(AntiPatternId.AP_018_DeterminismViolation);
    out.push(AntiPatternId.AP_019_FoundationDowngradeTransitive);
    out.push(AntiPatternId.AP_020_TimeBoundContractViolation);
    out.push(AntiPatternId.AP_021_TransitiveLifecycleRegression);
    out.push(AntiPatternId.AP_022_ProtocolMismatch);
    out.push(AntiPatternId.AP_023_CapabilityTransferLeak);
    out.push(AntiPatternId.AP_024_LifecycleRegressionTransitive);
    out.push(AntiPatternId.AP_025_DeclarationDrift);
    out.push(AntiPatternId.AP_026_FoundationContentMisalignment);
    out.push(AntiPatternId.AP_027_TemporalInconsistency);
    out.push(AntiPatternId.AP_028_CounterfactualBrittleness);
    out.push(AntiPatternId.AP_029_MissedAdjoint);
    out.push(AntiPatternId.AP_030_UniversalPropertyViolation);
    out.push(AntiPatternId.AP_031_PhantomEvolution);
    out.push(AntiPatternId.AP_032_YonedaInequivalentRefactor);
