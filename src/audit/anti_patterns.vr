// =============================================================================
// verum_registry/audit/anti_patterns.vr — 40-AP catalog enumeration
// =============================================================================
//
// Spec: §12.2; architecture-types/anti-patterns/overview.md
//
// Every published cog is checked against the AP-001..AP-040 catalog
// via `verum_kernel::arch_anti_pattern::check_all_anti_patterns`.
// Findings are persisted as part of the CogAuditRecord and exposed
// at `GET /api/audit/anti-patterns/:scope/:name/:version`.
//
// The catalog is **append-only**: AP-001 always means
// CapabilityEscalation; codes are never renumbered. The full id list
// lives in `core.architecture.anti_patterns::all_anti_pattern_ids`
// and is mirrored here for type-safe persistence.
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Theorem("canonical"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "40-AP catalog enumeration + corpus-wide observatory".to_text(),
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.audit.anti_patterns;

mount core.*;
mount base.{Result, Ok, Err, Maybe, Some, None, Text, Bool, Int};
mount collections.{List, Map};
mount architecture.types.Severity;
mount architecture.anti_patterns.AntiPatternCode as ArchAntiPatternId;

// =============================================================================
// Catalog
// =============================================================================

/// Full enumeration of AP-001..AP-040 names. Stable identifiers;
/// new entries are *appended*, never renumbered.
@derive(Eq, Clone, Debug)
public type AntiPatternId is
    // Classical / Composition (AP-001..AP-010)
    | AP_001_CapabilityEscalation
    | AP_002_CapabilityLeak
    | AP_003_DependencyCycle
    | AP_004_TierMixing
    | AP_005_FoundationDrift
    | AP_006_RegisterMixing
    | AP_007_StratumAdmissibility
    | AP_008_TxStraddling
    | AP_009_LifecycleRegression
    | AP_010_CveIncomplete
    // Boundary / Ontology (AP-011..AP-026)
    | AP_011_AbsoluteBoundaryAttempt
    | AP_012_LinearCapabilityFlavour
    | AP_013_AffineCapabilityFlavour
    | AP_014_RelevantCapabilityFlavour
    | AP_015_BoundaryInvariantViolation
    | AP_016_WireEncodingMismatch
    | AP_017_AuthenticationGap
    | AP_018_DeterminismViolation
    | AP_019_FoundationDowngradeTransitive
    | AP_020_TimeBoundContractViolation
    | AP_021_TransitiveLifecycleRegression
    | AP_022_ProtocolMismatch
    | AP_023_CapabilityTransferLeak
    | AP_024_LifecycleRegressionTransitive
    | AP_025_DeclarationDrift
    | AP_026_FoundationContentMisalignment
    // Modal-Temporal (AP-027..AP-032)
    | AP_027_TemporalInconsistency
    | AP_028_CounterfactualBrittleness
    | AP_029_MissedAdjoint
    | AP_030_UniversalPropertyViolation
    | AP_031_PhantomEvolution
    | AP_032_YonedaInequivalentRefactor
    // CVE Articulation Hygiene (AP-033..AP-040)
    | AP_033_RetractedCitationUse
    | AP_034_HypothesisWithoutMaturationPlan
    | AP_035_InterpretationInMatureCorpus
    | AP_036_ObserverImpersonation
    | AP_037_BoundlessAudit
    | AP_038_ImplicitSubstrate
    | AP_039_AnchoringOverextension
    | AP_040_SelfReferenceWithoutOperator;

/// Stable string identifier per the spec (AP-NNN format).
public fn ap_id_text(id: &AntiPatternId) -> Text {
    match id {
        AntiPatternId.AP_001_CapabilityEscalation         => "AP-001".to_text(),
        AntiPatternId.AP_002_CapabilityLeak               => "AP-002".to_text(),
        AntiPatternId.AP_003_DependencyCycle              => "AP-003".to_text(),
        AntiPatternId.AP_004_TierMixing                   => "AP-004".to_text(),
        AntiPatternId.AP_005_FoundationDrift              => "AP-005".to_text(),
        AntiPatternId.AP_006_RegisterMixing               => "AP-006".to_text(),
        AntiPatternId.AP_007_StratumAdmissibility         => "AP-007".to_text(),
        AntiPatternId.AP_008_TxStraddling                 => "AP-008".to_text(),
        AntiPatternId.AP_009_LifecycleRegression          => "AP-009".to_text(),
        AntiPatternId.AP_010_CveIncomplete                => "AP-010".to_text(),
        AntiPatternId.AP_011_AbsoluteBoundaryAttempt      => "AP-011".to_text(),
        AntiPatternId.AP_012_LinearCapabilityFlavour      => "AP-012".to_text(),
        AntiPatternId.AP_013_AffineCapabilityFlavour      => "AP-013".to_text(),
        AntiPatternId.AP_014_RelevantCapabilityFlavour    => "AP-014".to_text(),
        AntiPatternId.AP_015_BoundaryInvariantViolation   => "AP-015".to_text(),
        AntiPatternId.AP_016_WireEncodingMismatch         => "AP-016".to_text(),
        AntiPatternId.AP_017_AuthenticationGap            => "AP-017".to_text(),
        AntiPatternId.AP_018_DeterminismViolation         => "AP-018".to_text(),
        AntiPatternId.AP_019_FoundationDowngradeTransitive => "AP-019".to_text(),
        AntiPatternId.AP_020_TimeBoundContractViolation   => "AP-020".to_text(),
        AntiPatternId.AP_021_TransitiveLifecycleRegression => "AP-021".to_text(),
        AntiPatternId.AP_022_ProtocolMismatch             => "AP-022".to_text(),
        AntiPatternId.AP_023_CapabilityTransferLeak       => "AP-023".to_text(),
        AntiPatternId.AP_024_LifecycleRegressionTransitive => "AP-024".to_text(),
        AntiPatternId.AP_025_DeclarationDrift             => "AP-025".to_text(),
        AntiPatternId.AP_026_FoundationContentMisalignment => "AP-026".to_text(),
        AntiPatternId.AP_027_TemporalInconsistency        => "AP-027".to_text(),
        AntiPatternId.AP_028_CounterfactualBrittleness    => "AP-028".to_text(),
        AntiPatternId.AP_029_MissedAdjoint                => "AP-029".to_text(),
        AntiPatternId.AP_030_UniversalPropertyViolation   => "AP-030".to_text(),
        AntiPatternId.AP_031_PhantomEvolution             => "AP-031".to_text(),
        AntiPatternId.AP_032_YonedaInequivalentRefactor   => "AP-032".to_text(),
        AntiPatternId.AP_033_RetractedCitationUse         => "AP-033".to_text(),
        AntiPatternId.AP_034_HypothesisWithoutMaturationPlan => "AP-034".to_text(),
        AntiPatternId.AP_035_InterpretationInMatureCorpus => "AP-035".to_text(),
        AntiPatternId.AP_036_ObserverImpersonation        => "AP-036".to_text(),
        AntiPatternId.AP_037_BoundlessAudit               => "AP-037".to_text(),
        AntiPatternId.AP_038_ImplicitSubstrate            => "AP-038".to_text(),
        AntiPatternId.AP_039_AnchoringOverextension       => "AP-039".to_text(),
        AntiPatternId.AP_040_SelfReferenceWithoutOperator => "AP-040".to_text(),
    }
}

/// Short human-readable name (CamelCase form).
