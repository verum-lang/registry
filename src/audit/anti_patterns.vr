    let id_text = ap_id_text(id);
    let camel = match id {
        AntiPatternId.AP_001_CapabilityEscalation         => "CapabilityEscalation",
        AntiPatternId.AP_002_CapabilityLeak               => "CapabilityLeak",
        AntiPatternId.AP_003_DependencyCycle              => "DependencyCycle",
        AntiPatternId.AP_004_TierMixing                   => "TierMixing",
        AntiPatternId.AP_005_FoundationDrift              => "FoundationDrift",
        AntiPatternId.AP_006_RegisterMixing               => "RegisterMixing",
        AntiPatternId.AP_007_StratumAdmissibility         => "StratumAdmissibility",
        AntiPatternId.AP_008_TxStraddling                 => "TxStraddling",
        AntiPatternId.AP_009_LifecycleRegression          => "LifecycleRegression",
        AntiPatternId.AP_010_CveIncomplete                => "CveIncomplete",
        AntiPatternId.AP_011_AbsoluteBoundaryAttempt      => "AbsoluteBoundaryAttempt",
        AntiPatternId.AP_012_LinearCapabilityFlavour      => "LinearCapabilityFlavour",
        AntiPatternId.AP_013_AffineCapabilityFlavour      => "AffineCapabilityFlavour",
        AntiPatternId.AP_014_RelevantCapabilityFlavour    => "RelevantCapabilityFlavour",
        AntiPatternId.AP_015_BoundaryInvariantViolation   => "BoundaryInvariantViolation",
        AntiPatternId.AP_016_WireEncodingMismatch         => "WireEncodingMismatch",
        AntiPatternId.AP_017_AuthenticationGap            => "AuthenticationGap",
        AntiPatternId.AP_018_DeterminismViolation         => "DeterminismViolation",
        AntiPatternId.AP_019_FoundationDowngradeTransitive => "FoundationDowngradeTransitive",
        AntiPatternId.AP_020_TimeBoundContractViolation   => "TimeBoundContractViolation",
        AntiPatternId.AP_021_TransitiveLifecycleRegression => "TransitiveLifecycleRegression",
        AntiPatternId.AP_022_ProtocolMismatch             => "ProtocolMismatch",
        AntiPatternId.AP_023_CapabilityTransferLeak       => "CapabilityTransferLeak",
        AntiPatternId.AP_024_LifecycleRegressionTransitive => "LifecycleRegressionTransitive",
        AntiPatternId.AP_025_DeclarationDrift             => "DeclarationDrift",
        AntiPatternId.AP_026_FoundationContentMisalignment => "FoundationContentMisalignment",
        AntiPatternId.AP_027_TemporalInconsistency        => "TemporalInconsistency",
        AntiPatternId.AP_028_CounterfactualBrittleness    => "CounterfactualBrittleness",
        AntiPatternId.AP_029_MissedAdjoint                => "MissedAdjoint",
        AntiPatternId.AP_030_UniversalPropertyViolation   => "UniversalPropertyViolation",
        AntiPatternId.AP_031_PhantomEvolution             => "PhantomEvolution",
        AntiPatternId.AP_032_YonedaInequivalentRefactor   => "YonedaInequivalentRefactor",
        AntiPatternId.AP_033_RetractedCitationUse         => "RetractedCitationUse",
        AntiPatternId.AP_034_HypothesisWithoutMaturationPlan => "HypothesisWithoutMaturationPlan",
        AntiPatternId.AP_035_InterpretationInMatureCorpus => "InterpretationInMatureCorpus",
        AntiPatternId.AP_036_ObserverImpersonation        => "ObserverImpersonation",
        AntiPatternId.AP_037_BoundlessAudit               => "BoundlessAudit",
        AntiPatternId.AP_038_ImplicitSubstrate            => "ImplicitSubstrate",
        AntiPatternId.AP_039_AnchoringOverextension       => "AnchoringOverextension",
        AntiPatternId.AP_040_SelfReferenceWithoutOperator => "SelfReferenceWithoutOperator",
    };
    f"{id_text}/{camel}"
}

