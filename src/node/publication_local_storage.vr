module verum_registry.node.publication_local_storage;

mount core.io.file.File;
mount core.io.path.Path;
mount core.io.fs.{symlink_metadata, hard_link, remove_file};
mount core.io.protocols.{Read, Write, StreamError, IoErrorKind};
mount verum_registry.node.publication_storage_contract.{
    PublicationStorageError, RecordWrite, key_valid, header, decode_record,
};
mount core.encoding.hex.encode;
mount core.random.secure.fill_secure;

/// Immutable records in an operator-owned directory on one local filesystem.
/// Each record contains the complete publication transaction. This storage
/// boundary checks integrity; semantic admission belongs to its caller.
public type PublicationLocalStorage is {
    private directory: Text,
    private limit: Int,
};

fn read_record(file: &mut File, limit: Int) -> Result<List<Byte>, PublicationStorageError> {
    let mut result: List<Byte> = List.new();
    let mut buffer: [Byte; 4096] = [0_u8; 4096];
    loop {
        let count = match file.read(&mut buffer[..]) {
            Result.Ok(count) => count,
            Result.Err(error) => return Result.Err(PublicationStorageError.Io(error)),
        };
        if count == 0 { return Result.Ok(result); }
        if count < 0 || count > buffer.len() || count > limit - result.len() {
            return Result.Err(PublicationStorageError.Corrupt);
        }
        let mut index = 0;
        while index < count { result.push(buffer[index]); index = index + 1; }
    }
}

fn write_bytes(file: &mut File, bytes: &[Byte]) -> Result<(), PublicationStorageError> {
    let mut position = 0;
    while position < bytes.len() {
        let remaining = bytes.len() - position;
        let count = match file.write(&bytes[position..]) {
            Result.Ok(count) => count,
            Result.Err(error) => return Result.Err(PublicationStorageError.Io(error)),
        };
        if count <= 0 || count > remaining {
            return Result.Err(PublicationStorageError.Io(StreamError.new(IoErrorKind.WriteZero)));
        }
        position = position + count;
    }
    Result.Ok(())
}

fn sync_directory(directory: &Text) -> Result<(), PublicationStorageError> {
    let file = match File.open(directory) {
        Result.Ok(file) => file,
        Result.Err(error) => return Result.Err(PublicationStorageError.Io(error)),
    };
    match file.sync_all() {
        Result.Ok(()) => Result.Ok(()),
        Result.Err(error) => Result.Err(PublicationStorageError.Io(error)),
    }
}

implement PublicationLocalStorage {
    /// The directory must already exist. Opening a missing or unreadable store
    /// never silently substitutes an empty one.
    public fn open(directory: &Text, limit: Int) -> Result<PublicationLocalStorage, PublicationStorageError> {
        if limit < 1 || limit > 100663296 { return Result.Err(PublicationStorageError.TooLarge); }
        if directory.len() == 0 { return Result.Err(PublicationStorageError.InvalidDirectory); }
        for byte in directory.bytes() {
            if byte == 0 { return Result.Err(PublicationStorageError.InvalidDirectory); }
        }
        let metadata = match symlink_metadata(&Path.new(directory)) {
            Result.Ok(metadata) => metadata,
            Result.Err(error) => return Result.Err(PublicationStorageError.Io(error)),
        };
        if !metadata.is_dir() || metadata.is_symlink() {
            return Result.Err(PublicationStorageError.InvalidDirectory);
        }
        sync_directory(directory)?;
        let mut owned = Text.with_capacity(directory.len());
        owned.push_str(directory);
        Result.Ok(PublicationLocalStorage { directory: owned, limit: limit })
    }

    /// A key is a lowercase SHA-256 coordinate digest, never a filesystem path.
    /// Staging files cannot be read through this API.
    public fn load(&self, key: &Text) -> Result<Maybe<List<Byte>>, PublicationStorageError> {
        if !key_valid(key) { return Result.Err(PublicationStorageError.InvalidKey); }
        let path = f"{self.directory}/{key}.publication";
        let metadata = match symlink_metadata(&Path.new(&path)) {
            Result.Ok(metadata) => metadata,
            Result.Err(error) => {
                if error.kind() is IoErrorKind.NotFound { return Result.Ok(Maybe.None); }
                return Result.Err(PublicationStorageError.Io(error));
            },
        };
        if !metadata.is_file() || metadata.is_symlink() {
            return Result.Err(PublicationStorageError.Corrupt);
        }
        let mut file = match File.open(&path) {
            Result.Ok(file) => file,
            Result.Err(error) => return Result.Err(PublicationStorageError.Io(error)),
        };
        let bytes = read_record(&mut file, self.limit + 48)?;
        Result.Ok(Maybe.Some(decode_record(key, &bytes, self.limit)?))
    }

    /// Commit one complete, immutable record. The atomic hard link arbitrates
    /// concurrent writers; the final name is never replaced or written in place.
    /// Success follows both file and directory sync. On an uncertain I/O failure,
    /// retry the same key and complete record.
    public fn commit(&self, key: &Text, value: &List<Byte>) -> Result<RecordWrite, PublicationStorageError> {
        if !key_valid(key) { return Result.Err(PublicationStorageError.InvalidKey); }
        if value.len() > self.limit { return Result.Err(PublicationStorageError.TooLarge); }
        let encoded_header = header(key, value);
        let mut attempt = 0;
        while attempt < 16 {
            let mut nonce: List<Byte> = List.new();
            let mut index = 0;
            while index < 16 { nonce.push(0_u8); index = index + 1; }
            fill_secure(&mut nonce);
            let temporary = f"{self.directory}/.pending-{encode(nonce.as_slice())}";
            let mut file = match File.create_new(&temporary) {
                Result.Ok(file) => file,
                Result.Err(error) => {
                    if error.kind() is IoErrorKind.AlreadyExists { attempt = attempt + 1; continue; }
                    return Result.Err(PublicationStorageError.Io(error));
                },
            };
            let written = write_bytes(&mut file, encoded_header.as_slice())
                .and_then(|_| write_bytes(&mut file, value.as_slice()));
            if let Result.Err(error) = written {
                let _ = remove_file(&Path.new(&temporary));
                return Result.Err(error);
            }
            if let Result.Err(error) = file.sync_all() {
                let _ = remove_file(&Path.new(&temporary));
                return Result.Err(PublicationStorageError.Io(error));
            }
            let final_path = f"{self.directory}/{key}.publication";
            let linked = hard_link(&Path.new(&temporary), &Path.new(&final_path));
            // Removing an unreferenced staging name cannot invalidate a final
            // hard link. A crash may leave an orphan, never a partial release.
            let _ = remove_file(&Path.new(&temporary));
            let outcome = match linked {
                Result.Ok(()) => RecordWrite.Created,
                Result.Err(error) => {
                    if !(error.kind() is IoErrorKind.AlreadyExists) {
                        return Result.Err(PublicationStorageError.Io(error));
                    }
                    let existing = match self.load(key)? {
                        Maybe.Some(existing) => existing,
                        Maybe.None => return Result.Err(PublicationStorageError.Corrupt),
                    };
                    if existing.len() != value.len() { return Result.Err(PublicationStorageError.Conflict); }
                    index = 0;
                    while index < value.len() {
                        if existing[index] != value[index] { return Result.Err(PublicationStorageError.Conflict); }
                        index = index + 1;
                    }
                    RecordWrite.Existing
                },
            };
            sync_directory(&self.directory)?;
            return Result.Ok(outcome);
        }
        Result.Err(PublicationStorageError.Io(StreamError.new(IoErrorKind.AlreadyExists)))
    }
}
