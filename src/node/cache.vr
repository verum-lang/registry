// =============================================================================
// verum_registry.node.cache — what a node keeps, and what it says offline
// =============================================================================
// Spec: registry-federation-protocol §2.4 (consistency), §4.1 (offline)
//
// Two rules live here, and both are about honesty rather than speed:
//
//   * A cached answer KEEPS THE ATTRIBUTION it was fetched with. A cache
//     that forgets where an answer came from turns an upstream package
//     into a local one on the way to disk, which is the same
//     misrepresentation §2.3 refuses at the proof level.
//
//   * An unreachable upstream answers `UpstreamUnreachable`, never
//     `NotFound`. "I cannot see" and "it does not exist" are different
//     facts, and a build system that conflates them either fails a build
//     that should have used the cache, or hides a typo as an outage.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module verum_registry.node.cache;

mount verum_registry.protocol.authority.{AuthorityRole, PackageName};
mount verum_registry.protocol.evidence.{Manifest, Verified};

// -----------------------------------------------------------------------------
// What a cache holds
// -----------------------------------------------------------------------------

/// One cached coordinate, with everything needed to answer for it later
/// WITHOUT contacting anyone — including who answered originally.
public type CachedEntry is {
    verified: Verified,
    /// When this node fetched it, so a consistency answer can be dated.
    fetched_at: Int,
};

/// Whether the upstream can be reached right now.
public type Link is
    | Online
    | Offline;

/// A node's local cache.
public type Cache is {
    entries: List<CachedEntry>,
};

/// What a lookup can answer. Note what is NOT here: there is no variant
/// meaning "absent, probably" — the two absences are named separately.
public type Answer is
    /// Served from cache, with the attribution it was fetched with.
    | Hit(CachedEntry)
    /// The upstream is unreachable and this node has never seen the name.
    | UpstreamUnreachable
    /// The upstream was reachable and does not have it.
    | NotFound;

// -----------------------------------------------------------------------------
// Lookup (spec §4.1)
// -----------------------------------------------------------------------------

implement Cache {
    public fn empty() -> Cache {
        Cache { entries: List.new() }
    }

    /// Store a verified coordinate. The attribution rides along inside
    /// `Verified`; there is no path that stores an artefact and forgets
    /// it, because there is no way to build a `CachedEntry` without one.
    public fn store(&mut self, verified: Verified, fetched_at: Int) {
        self.entries.push(CachedEntry {
            verified: verified,
            fetched_at: fetched_at,
        });
    }

    /// Answer for `name` given the current link state.
    ///
    /// A cached entry is served in BOTH link states — that is the point
    /// of §4.1: an office with a broken uplink keeps building. Only a
    /// name this node has never seen depends on the link, and then the
    /// two absences are told apart.
    public fn lookup(&self, name: &PackageName, link: &Link) -> Answer {
        for e in self.entries.iter() {
            if e.verified.manifest.name.0 == name.0 {
                return Answer.Hit(CachedEntry {
                    verified: e.verified.clone(),
                    fetched_at: e.fetched_at,
                });
            }
        }
        match link {
            Offline => Answer.UpstreamUnreachable,
            Online  => Answer.NotFound,
        }
    }

    /// How many entries this node holds — the figure a consistency
    /// answer is dated against.
    public fn len(&self) -> Int {
        self.entries.len()
    }
}

// -----------------------------------------------------------------------------
// The obligation this module carries (spec §6)
// -----------------------------------------------------------------------------
//
// STATE: these obligations are STATED and NOT YET DISCHARGED. The prover
// currently proves a goal only when the predicate is a single expression
// over primitive parameters — a `let` binding, a field access or a method
// call defeats it regardless of how easy the claim is (`b.n == b.n` over a
// struct fails). That is a limit of the prover's reach, not a doubt about
// these properties, and it is filed with the ladder that measures it. The
// theorems stay: an obligation nobody has discharged is an audit finding,
// which is the honest record, and it becomes a proof the day the reach
// covers it — without anyone having to remember to come back and add one.

/// Does this answer carry the attribution the entry was stored with?
///
/// The failure it excludes is a cache that serves an upstream package as
/// though the local node had published it — the same misrepresentation
/// the evidence rules refuse at the proof level, arriving instead through
/// the back door of a lookup that forgot where the answer came from.
public fn answer_keeps_attribution(a: &Answer, expected_authority: &Text) -> Bool {
    match a {
        Hit(e) => e.verified.authority_id == expected_authority.clone(),
        // The two absences carry no attribution because they carry no
        // artefact. Vacuously true, and stated rather than omitted so
        // the predicate is total over `Answer`.
        UpstreamUnreachable => true,
        NotFound => true,
    }
}

/// Storing then looking a name up answers with the attribution it was
/// stored with — in BOTH link states, since serving from cache while
/// offline is the point of having one.
public fn store_then_lookup_keeps_attribution(
    verified: Verified,
    link: &Link,
) -> Bool {
    let expected = verified.authority_id.clone();
    let wanted = PackageName(verified.manifest.name.0.clone());
    let mut c = Cache.empty();
    c.store(verified, 0);
    answer_keeps_attribution(&c.lookup(&wanted, link), &expected)
}

@verify(formal)
public theorem cache_keeps_attribution(verified: Verified, link: &Link)
    ensures store_then_lookup_keeps_attribution(verified, link)
    // `CachedEntry` has no field for an authority of its own: the
    // attribution lives inside the `Verified` it holds, so there is
    // nothing for `store` to drop and nothing for `lookup` to re-derive.
    // The Hit arm copies that same `Verified`, and the link state selects
    // only WHICH ABSENCE is reported when the name is unknown — it never
    // selects a different attribution.
    proof by auto;
