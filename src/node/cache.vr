// =============================================================================
// verum_registry.node.cache — what a node keeps, and what it says offline
// =============================================================================
// Spec: registry-federation-protocol §2.4 (consistency), §4.1 (offline)
//
// Two rules live here, and both are about honesty rather than speed:
//
//   * A cached answer KEEPS THE ATTRIBUTION it was fetched with. A cache
//     that forgets where an answer came from turns an upstream package
//     into a local one on the way to disk, which is the same
//     misrepresentation §2.3 refuses at the proof level.
//
//   * An unreachable upstream answers `UpstreamUnreachable`, never
//     `NotFound`. "I cannot see" and "it does not exist" are different
//     facts, and a build system that conflates them either fails a build
//     that should have used the cache, or hides a typo as an outage.
//
// TWO THINGS ARE NOT PARAMETERS HERE, and both are deliberate.
//
// WHEN it is comes from the `Clock` context. Every stored answer is
// dated, and a date threaded by hand is a date some path forgets — the
// forgetting is invisible because the type still checks, `0` being a
// perfectly good `Int`.
//
// WHETHER THE UPSTREAM IS REACHABLE comes from the `Uplink` context.
// Reachability changes between two calls, so a value captured once and
// passed down is a fact about the past presented as a fact about the
// present — exactly the confusion §4.1 refuses at the answer level,
// arriving through the parameter list instead.
//
// SHAPE: the entries are a `Map` keyed by package name, not a list. A
// registry holds millions of coordinates, and a linear scan is not a
// smaller version of an index — it is a different asymptote, and one
// that only shows up at the scale where it is expensive to change. The
// lookup below is one probe whatever the node holds.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module verum_registry.node.cache;

mount verum_registry.protocol.authority.{AuthorityRole, PackageName};
mount verum_registry.protocol.evidence.{Manifest, Verified};
mount verum_registry.node.ambient.{Clock, Uplink};

// -----------------------------------------------------------------------------
// What a cache holds
// -----------------------------------------------------------------------------

/// One cached coordinate, with everything needed to answer for it later
/// WITHOUT contacting anyone — including who answered originally.
public type CachedEntry is {
    verified: Verified,
    /// When this node fetched it, so a consistency answer can be dated.
    /// Read from the clock at store time, never supplied by a caller.
    fetched_at: Int,
};

/// A node's local cache, indexed by the name a lookup asks for.
public type Cache is {
    entries: Map<Text, CachedEntry>,
};

/// What a lookup can answer. Note what is NOT here: there is no variant
/// meaning "absent, probably" — the two absences are named separately.
public type Answer is
    /// Served from cache, with the attribution it was fetched with.
    | Hit(CachedEntry)
    /// The upstream is unreachable and this node has never seen the name.
    | UpstreamUnreachable
    /// The upstream was reachable and does not have it.
    | NotFound;

// -----------------------------------------------------------------------------
// Lookup (spec §4.1)
// -----------------------------------------------------------------------------

implement Cache {
    public fn empty() -> Cache {
        Cache { entries: Map.new() }
    }

    /// Store a verified coordinate, dated by the clock.
    ///
    /// The attribution rides along inside `Verified`; there is no path
    /// that stores an artefact and forgets it, because there is no way
    /// to build a `CachedEntry` without one.
    public fn store(&mut self, verified: Verified) using [Clock] {
        let key = verified.manifest.name.0.clone();
        self.entries.insert(key, CachedEntry {
            verified: verified,
            fetched_at: Clock.now(),
        });
    }

    /// Answer for `name`.
    ///
    /// A cached entry is served whether or not the upstream is up — that
    /// is the point of §4.1: an office with a broken uplink keeps
    /// building. Only a name this node has never seen depends on the
    /// link, and then the two absences are told apart.
    public fn lookup(&self, name: &PackageName) -> Answer using [Uplink] {
        match self.entries.get(name.0.clone()) {
            Some(e) => Answer.Hit(CachedEntry {
                verified: e.verified.clone(),
                fetched_at: e.fetched_at,
            }),
            None => {
                if Uplink.reachable() {
                    Answer.NotFound
                } else {
                    Answer.UpstreamUnreachable
                }
            }
        }
    }

    /// How many entries this node holds — the figure a consistency
    /// answer is dated against.
    ///
    /// The refinement is deliberate and the line between it and a typed
    /// refusal is the design rule this codebase follows: a REFINEMENT
    /// states an invariant of a value the node computes itself, so a
    /// violation is this node's own bug and halting is right. Anything
    /// arriving from a peer is checked by a function that RETURNS a
    /// refusal instead — asserting on a malformed message from an
    /// untrusted party would let that party halt the node.
    public fn len(&self) -> Int{it >= 0} {
        self.entries.len()
    }
}

// -----------------------------------------------------------------------------
// The obligation this module carries (spec §6)
// -----------------------------------------------------------------------------
//
// STATE: these obligations are STATED and NOT YET DISCHARGED, and what
// stops them has moved. They used to be UNSTATEABLE — the predicate's
// parameters and its own declaration disagreed about what sort a record
// or a variant has, so the claim never reached the solver at all, which
// prints almost the same as a claim that failed. That is fixed: `let`
// bindings, field reads, records, variants and `match` over an enum are
// all inside the reach now, and every obligation here is put to the
// solver.
//
// What is left is genuine reach. Each of these predicates walks a LIST
// or matches over a `Result`, and the prover unfolds neither, so it
// answers with a counterexample it invented rather than a proof. That is
// a limit of the prover, not a doubt about the properties.
//
// The theorems stay: an obligation nobody has discharged is an audit
// finding, which is the honest record, and it becomes a proof the day
// the reach covers it — without anyone having to remember to come back.

/// Does this answer carry the attribution the entry was stored with?
///
/// The failure it excludes is a cache that serves an upstream package as
/// though the local node had published it — the same misrepresentation
/// the evidence rules refuse at the proof level, arriving instead through
/// the back door of a lookup that forgot where the answer came from.
public fn answer_keeps_attribution(a: &Answer, expected_authority: &Text) -> Bool {
    match a {
        Hit(e) => e.verified.authority_id == expected_authority.clone(),
        // The two absences carry no attribution because they carry no
        // artefact. Vacuously true, and stated rather than omitted so
        // the predicate is total over `Answer`.
        UpstreamUnreachable => true,
        NotFound => true,
    }
}

/// Storing then looking a name up answers with the attribution it was
/// stored with — whatever the link state, since serving from cache while
/// offline is the point of having one.
public fn store_then_lookup_keeps_attribution(
    verified: Verified,
) -> Bool using [Clock, Uplink] {
    let expected = verified.authority_id.clone();
    let wanted = PackageName(verified.manifest.name.0.clone());
    let mut c = Cache.empty();
    c.store(verified);
    answer_keeps_attribution(&c.lookup(&wanted), &expected)
}

@verify(formal)
public theorem cache_keeps_attribution(verified: Verified)
    ensures store_then_lookup_keeps_attribution(verified)
    // `CachedEntry` has no field for an authority of its own: the
    // attribution lives inside the `Verified` it holds, so there is
    // nothing for `store` to drop and nothing for `lookup` to re-derive.
    // The Hit arm copies that same `Verified`, and the link state selects
    // only WHICH ABSENCE is reported when the name is unknown — it never
    // selects a different attribution.
    proof by auto;
