module verum_registry.node.publication_storage;

mount core.database.postgres.config.PgConfig;
mount verum_registry.node.publication_local_storage.PublicationLocalStorage;
mount verum_registry.node.publication_postgres_storage.PublicationPostgresStorage;
public mount verum_registry.node.publication_storage_contract.{PublicationStorageError, RecordWrite};

type PublicationBackend is
    | Local(PublicationLocalStorage)
    | Postgres(PublicationPostgresStorage);

/// The storage choice is fixed at startup. An unavailable backend never
/// substitutes another store or reports a missing release.
public type PublicationStorage is { private backend: PublicationBackend };

implement PublicationStorage {
    public fn open(directory: &Text, limit: Int) -> Result<PublicationStorage, PublicationStorageError> {
        Result.Ok(PublicationStorage { backend: PublicationBackend.Local(PublicationLocalStorage.open(directory, limit)?) })
    }

    public fn open_postgres(config: PgConfig, limit: Int, connections: Int)
        -> Result<PublicationStorage, PublicationStorageError> {
        Result.Ok(PublicationStorage { backend: PublicationBackend.Postgres(PublicationPostgresStorage.open(config, limit, connections)?) })
    }

    public fn load(&self, key: &Text) -> Result<Maybe<List<Byte>>, PublicationStorageError> {
        match &self.backend {
            PublicationBackend.Local(storage) => storage.load(key),
            PublicationBackend.Postgres(storage) => storage.load(key),
        }
    }

    public fn commit(&self, key: &Text, value: &List<Byte>) -> Result<RecordWrite, PublicationStorageError> {
        match &self.backend {
            PublicationBackend.Local(storage) => storage.commit(key, value),
            PublicationBackend.Postgres(storage) => storage.commit(key, value),
        }
    }
}
