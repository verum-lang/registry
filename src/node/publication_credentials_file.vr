// Spec: Cog Publication Protocol v1 — explicit bounded credential configuration.
module verum_registry.node.publication_credentials_file;

mount core.io.file.{File};
mount core.io.protocols.{Read, StreamError};
mount verum_registry.protocol.authority.{Authority};
mount verum_registry.node.publication_auth.{
    CredentialStore, CredentialConfigError, credential_config_limit, decode_credentials,
};

public type CredentialLoadError is
    | Io(StreamError)
    | Config(CredentialConfigError);

/// Read one bounded configuration through a typed reader. Useful both for the
/// real file and deterministic short-read/error controls; no JSON scanner here.
public fn read_credentials<R: Read>(
    reader: &mut R, authorities: &List<Authority>,
) -> Result<CredentialStore, CredentialLoadError> {
    let mut contents: List<Byte> = List.new();
    let mut buffer: [Byte; 4096] = [0_u8; 4096];
    loop {
        let count = match reader.read(&mut buffer[..]) {
            Result.Ok(count) => count,
            Result.Err(error) => return Result.Err(CredentialLoadError.Io(error)),
        };
        if count == 0 { break; }
        // A broken reader cannot authorize an out-of-range buffer access.
        if count < 0 || count > 4096 {
            return Result.Err(CredentialLoadError.Io(StreamError.Other("invalid credential read count")));
        }
        if count > credential_config_limit() - contents.len() {
            return Result.Err(CredentialLoadError.Config(CredentialConfigError.TooLarge));
        }
        let mut index = 0;
        while index < count {
            contents.push(buffer[index]);
            index = index + 1;
        }
    }
    let source = match Text.from_utf8(contents.as_slice()) {
        Result.Ok(text) => text,
        Result.Err(_) => return Result.Err(CredentialLoadError.Config(CredentialConfigError.InvalidUtf8)),
    };
    match decode_credentials(&source, authorities) {
        Result.Ok(store) => Result.Ok(store),
        Result.Err(error) => Result.Err(CredentialLoadError.Config(error)),
    }
}

/// No search path or empty fallback: every open/read/config failure is returned.
/// The caller must obtain this snapshot before it constructs a serving handler.
public fn load_credentials(
    path: &Text, authorities: &List<Authority>,
) -> Result<CredentialStore, CredentialLoadError> {
    let mut file = match File.open(path) {
        Result.Ok(file) => file,
        Result.Err(error) => return Result.Err(CredentialLoadError.Io(error)),
    };
    read_credentials(&mut file, authorities)
}
