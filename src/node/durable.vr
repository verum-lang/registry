// =============================================================================
// verum_registry.node.durable — surviving a restart
// =============================================================================
// Spec: registry-federation-protocol §4.2 (slices), §2 (evidence)
//
// A node that forgets everything when it restarts is not a cache; it is
// a proxy with extra steps. But persistence is where a cache usually
// stops being trustworthy, because the thing written to disk is the
// thing an attacker — or a bad disk — can change.
//
// THE RULE: WHAT COMES BACK IS RE-VERIFIED, NOT RESTORED.
//
// A node does not persist "entries it trusts". It persists the EVIDENCE
// it was given, and on load it runs the same `verify` a fresh fetch
// runs. A store edited between runs does not produce a trusted entry; it
// produces a refusal naming the coordinate.
//
// That is why this module is thin. Persistence is an AIR GAP IN TIME
// rather than in space, so it is the same `Slice` the air gap already
// carries, and the same all-or-nothing import: everything is verified
// before anything is stored, and a tampered record refuses the load
// rather than poisoning a node that then serves it.
//
// The serialisation is deliberately a placeholder while the slice is
// about the RULE — a line-per-item rendering with a fixed field order,
// which is canonical in the property that matters here (the same slice
// renders identically) and is not what a real deployment should ship.
// `core.encoding.cbor` is where that goes.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module verum_registry.node.durable;

mount verum_registry.protocol.authority.{AuthorityRole, PackageName};
mount verum_registry.protocol.evidence.{
    Digest, InclusionProof, Manifest, SignatureBundle,
};
mount verum_registry.node.cache.{Cache};
mount verum_registry.node.slice.{ImportError, Slice, SliceItem, import_slice};
mount verum_registry.node.ambient.{Clock};

// -----------------------------------------------------------------------------
// Where a node keeps what it holds
// -----------------------------------------------------------------------------

/// Durable storage for a node's held evidence.
///
/// A context, for the same reason the clock is one: which store a node
/// uses is a fact about the world it runs in, not an argument to the
/// rules. A test provides a store that lives in memory and a deployment
/// provides one backed by a file, and nothing between them changes.
///
/// `load` answers `Maybe<Text>` rather than `Result`: a node starting
/// for the FIRST TIME has no store, and that is not an error. A store
/// that exists and cannot be read is a different matter and belongs in
/// the backend, which is the only layer that knows what a read failure
/// even means for it.
public context Storage {
    fn load() -> Maybe<Text>;
    fn save(contents: Text) -> Bool;
}

/// Why a node could not come back up.
public type RestoreError is
    /// The stored text is not a rendering this version can read. Names
    /// the line, because an operator's next move is to look at it.
    | Unreadable(Int)
    /// The evidence in the store did not check out. Carries the import
    /// refusal unchanged — a tampered store and a malformed slice are
    /// the same failure and deserve the same words.
    | Refused(ImportError);

// -----------------------------------------------------------------------------
// Rendering (placeholder — see the module note)
// -----------------------------------------------------------------------------

/// One item, as one line. Fixed field order, no optional whitespace.
public pure fn render_item(item: &SliceItem) -> Text {
    let role = match item.role {
        Upstream => "upstream",
        Local => "local",
    };
    f"{item.manifest.name.0}|{item.manifest.version}|{item.manifest.artefact.0}|{item.manifest.published_at}|{item.signature.manifest_digest.0}|{item.signature.signer}|{item.proof.manifest_digest.0}|{item.proof.log_id}|{item.proof.tree_size}|{item.authority_id}|{role}|{item.log_id}"
}

/// A whole slice, one item per line.
public pure fn render(slice: &Slice) -> Text {
    let mut out = "";
    for item in slice.items.iter() {
        out = f"{out}{render_item(item)}\n";
    }
    out
}

/// Read one line back. `None` when the line does not have the shape
/// this version writes — which the caller turns into `Unreadable` with
/// the line number, rather than skipping it silently. A store that has
/// half-loaded is worse than one that refused.
public pure fn parse_item(line: &Text) -> Maybe<SliceItem> {
    let parts = line.split("|");
    if parts.len() != 12 {
        return Maybe.None;
    }
    // A field that does not parse makes the LINE unreadable, which the
    // caller reports with its number. Defaulting it would have produced
    // a record whose digest no longer matches its own evidence — a
    // refusal one layer later, naming the coordinate instead of the
    // line, which is the wrong thing to hand an operator.
    let published_at = match parts[3].parse_int() {
        Ok(n) => n,
        Err(_) => return Maybe.None,
    };
    let tree_size = match parts[8].parse_int() {
        Ok(n) => n,
        Err(_) => return Maybe.None,
    };
    let role = if parts[10] == "upstream" {
        AuthorityRole.Upstream
    } else {
        AuthorityRole.Local
    };
    Maybe.Some(SliceItem {
        manifest: Manifest {
            name: PackageName(parts[0].clone()),
            version: parts[1].clone(),
            artefact: Digest(parts[2].clone()),
            published_at: published_at,
        },
        signature: SignatureBundle {
            manifest_digest: Digest(parts[4].clone()),
            signer: parts[5].clone(),
        },
        proof: InclusionProof {
            manifest_digest: Digest(parts[6].clone()),
            log_id: parts[7].clone(),
            tree_size: tree_size,
        },
        authority_id: parts[9].clone(),
        role: role,
        log_id: parts[11].clone(),
        requires: List.new(),
    })
}

// -----------------------------------------------------------------------------
// Coming back up (spec §4.2, applied to time rather than space)
// -----------------------------------------------------------------------------

/// Write what this node holds.
public fn persist(slice: &Slice) -> Bool using [Storage] {
    Storage.save(render(slice))
}

/// Come back up from the store.
///
/// The evidence is RE-VERIFIED, not restored: `import_slice` runs the
/// same `verify` a fresh fetch runs, and a record edited between runs
/// produces a refusal naming the coordinate rather than a trusted entry.
/// A node with no store yet is not an error — it comes up empty.
/// ASYNC because `import_slice` is: re-verification fans out, and this
/// function waits for it. The property travels up the call chain by
/// itself — nothing here chose to be asynchronous, it inherited the fact
/// from what it calls.
public async fn restore(cache: &mut Cache) -> Result<Int, RestoreError>
    using [Storage, Clock]
{
    let stored = match Storage.load() {
        Maybe.Some(text) => text,
        Maybe.None => return Result.Ok(0),
    };

    let mut items: List<SliceItem> = List.new();
    let mut line_no = 0;
    for line in stored.split("\n").iter() {
        line_no = line_no + 1;
        if line.len() == 0 {
            continue;
        }
        match parse_item(line) {
            Maybe.Some(item) => items.push(item),
            Maybe.None => return Result.Err(RestoreError.Unreadable(line_no)),
        }
    }

    match import_slice(cache, &Slice { items: items }).await {
        Ok(n) => Result.Ok(n),
        Err(e) => Result.Err(RestoreError.Refused(e)),
    }
}
