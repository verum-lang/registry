// =============================================================================
// verum_registry.node.slice — carrying a registry across an air gap
// =============================================================================
// Spec: registry-federation-protocol §4.2
//
// A slice is a self-contained, verifiable export. Two rules decide
// whether it is trustworthy on the far side, and both are easy to break
// without noticing:
//
//   * A SLICE DOES NOT GRANT ITS BEARER AUTHORITY. Imported coordinates
//     keep the authority they were EXPORTED with, so a disconnected node
//     cannot launder an upstream package into looking locally published
//     by carrying it in on a disk. The attribution rides inside
//     `Verified`, so keeping it is not a step an importer can forget.
//
//   * IMPORT IS ALL-OR-NOTHING. Every artefact is verified BEFORE
//     anything is stored. A partial import leaves a node whose cache
//     disagrees with its own manifest, and the disagreement surfaces
//     later, somewhere else, as a missing dependency.
//
// Slices are closed under dependencies by default, because the
// alternative is discovering the gap on the side with no network.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module verum_registry.node.slice;

mount verum_registry.protocol.authority.{AuthorityRole, PackageName};
mount verum_registry.protocol.evidence.{
    Digest, EvidenceError, InclusionProof, Manifest, SignatureBundle,
    Verified, digest_of, verify,
};
mount verum_registry.node.cache.{Cache};
mount verum_registry.node.ambient.{Clock};

// -----------------------------------------------------------------------------
// What travels
// -----------------------------------------------------------------------------

/// One coordinate and everything needed to believe it on the far side.
/// There is no field for "already checked": the far side checks again,
/// because the exporter is a party the importer did not choose.
public type SliceItem is {
    public manifest: Manifest,
    public signature: SignatureBundle,
    public proof: InclusionProof,
    /// The authority that answered when this was fetched — carried, not
    /// re-derived on import.
    public authority_id: Text,
    public role: AuthorityRole,
    /// The log the proof belongs to, so the far side can check the same
    /// thing this side did.
    public log_id: Text,
    /// What this coordinate needs. Used to decide closure.
    public requires: List<Text>,
};

public type Slice is {
    public items: List<SliceItem>,
};

/// Why an import was refused. Every case names the coordinate, because
/// an operator on a disconnected machine cannot ask anyone.
public type ImportError is
    /// One item's evidence did not check out. Nothing was stored.
    | ItemRefused(Text, EvidenceError)
    /// The slice is not closed: an item needs something the slice does
    /// not carry. Named so the exporter can be told what to add.
    | NotClosed(Text, Text)
    /// Everything verified and was stored in memory, and the write to
    /// durable storage failed. DISTINCT from the refusals above, because
    /// the node's state is different: it HOLDS the coordinates and will
    /// lose them on restart. An operator needs to tell "nothing was
    /// accepted" from "accepted, and it will not survive".
    | NotPersisted;

// -----------------------------------------------------------------------------
// Closure (spec §4.2)
// -----------------------------------------------------------------------------

implement Slice {
    /// Is every requirement of every item carried by this slice?
    ///
    /// Checked BEFORE verification, so the answer to "will this work on
    /// the far side" does not depend on how far the import got.
    public fn closure_gap(&self) -> Maybe<ImportError> {
        for item in self.items.iter() {
            for need in item.requires.iter() {
                let mut found = false;
                for other in self.items.iter() {
                    if other.manifest.name.0 == need.clone() {
                        found = true;
                    }
                }
                if !found {
                    return Maybe.Some(ImportError.NotClosed(
                        item.manifest.name.0.clone(),
                        need.clone(),
                    ));
                }
            }
        }
        Maybe.None
    }
}

// -----------------------------------------------------------------------------
// Import (spec §4.2)
// -----------------------------------------------------------------------------

/// Verify every item, then store every item — in that order.
///
/// The two loops are not an accident of style. Verifying inside the
/// storing loop would leave a partially-populated node when the third
/// item fails, and a node whose contents disagree with its own manifest
/// reports the disagreement later, somewhere unrelated.
/// ASYNC, and the signature says so because the body does it. The fan-out
/// below spawns one verification per item and joins every one before the
/// storing loop; `.await` is how a parent waits for its children, and a
/// parent that waits is an async function. Verum will not let this be
/// written any other way — an `.await` outside an async context is
/// `E504`, not a silent block.
/// IMPORTING IS NOT EVICTING, and the type says so.
///
/// `&mut` grants the right to CHANGE a value and says nothing about
/// which changes, so an importer holding a plain `&mut Cache` may just
/// as well drop a coordinate somebody else vouched for. `[Store]` and
/// `[Evict]` split the two, and neither can do the other's job:
///
///     fn import_slice(cache: &mut Cache with [Store], …)
///     fn prune_before(cache: &mut Cache with [Evict], …)
///
/// A caller holding `[Evict]` cannot reach this function, and the
/// compiler says so at the call rather than a reviewer noticing. This is
/// the distinction ownership alone cannot draw: Rust's `&mut`, Java's
/// `final` and Go's unexported fields all stop at "may it be changed",
/// and the question here is "changed HOW".
public async fn import_slice(
    cache: &mut Cache with [Store],
    slice: &Slice,
) -> Result<Int{it >= 0}, ImportError> using [Clock] {
    match slice.closure_gap() {
        Maybe.Some(e) => return Result.Err(e),
        Maybe.None    => {}
    }

    // Pass 1 — verify everything, store nothing.
    //
    // FANNED OUT, and the two rules are the same rule. Structured
    // concurrency says a parent does not finish before its children;
    // all-or-nothing says nothing is stored until everything is
    // verified. Spawning one verification per item and joining them all
    // before the storing loop makes the second a consequence of the
    // first rather than a discipline someone has to keep — there is no
    // arrangement of this code in which a store runs while a
    // verification is outstanding.
    //
    // It is also the shape that scales: a slice carries as many
    // coordinates as an air-gapped site needs, and their verifications
    // are independent by construction — each reads one item and shares
    // nothing.
    let mut pending = List.new();
    let mut names: List<Text> = List.new();
    for item in slice.items.iter() {
        let m = Manifest {
            name: PackageName(item.manifest.name.0.clone()),
            version: item.manifest.version.clone(),
            artefact: Digest(item.manifest.artefact.0.clone()),
            published_at: item.manifest.published_at,
        };
        let sig = SignatureBundle {
            manifest_digest: Digest(item.signature.manifest_digest.0.clone()),
            signer: item.signature.signer.clone(),
        };
        let prf = InclusionProof {
            manifest_digest: Digest(item.proof.manifest_digest.0.clone()),
            log_id: item.proof.log_id.clone(),
            tree_size: item.proof.tree_size,
        };
        let who = item.authority_id.clone();
        let role = item.role.clone();
        let expected = item.log_id.clone();
        names.push(item.manifest.name.0.clone());
        pending.push(spawn(async {
            verify(m, &sig, &prf, who, role, &expected)
        }));
    }

    // The join. Every child has finished by the time this loop ends,
    // which is what makes the refusal below total: a slice is refused
    // for the FIRST item whose evidence did not check out, and no item
    // has been stored.
    let mut verified: List<Verified> = List.new();
    let mut refusal: Maybe<ImportError> = Maybe.None;
    let mut idx = 0;
    for h in pending {
        match h.await {
            Ok(v) => verified.push(v),
            Err(e) => {
                if refusal is None {
                    refusal = Maybe.Some(ImportError.ItemRefused(names[idx].clone(), e));
                }
            }
        }
        idx = idx + 1;
    }
    match refusal {
        Some(error) => return Result.Err(error),
        None => {}
    }

    // Pass 2 — store, keeping the attribution each item arrived with.
    let mut stored = 0;
    for v in verified.iter() {
        cache.store(v.clone());
        stored = stored + 1;
    }
    Result.Ok(stored)
}

/// Build a slice item from a coordinate this node holds.
///
/// The authority and log ride along; an exporter that re-stamped them
/// with its own identity would be the laundering this rule exists to
/// prevent, and there is no parameter here that would let it.
public fn export_item(v: &Verified, requires: List<Text>) -> SliceItem {
    let manifest = v.manifest();
    let d = digest_of(&manifest);
    SliceItem {
        manifest: manifest,
        signature: SignatureBundle {
            manifest_digest: Digest(d.0.clone()),
            signer: "exported",
        },
        proof: InclusionProof {
            manifest_digest: Digest(d.0.clone()),
            log_id: v.log_id(),
            tree_size: 1,
        },
        authority_id: v.authority_id(),
        role: v.role(),
        log_id: v.log_id(),
        requires: requires,
    }
}
