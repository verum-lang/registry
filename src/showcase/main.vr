// =============================================================================
// registry showcase — one entry, three chapters
//
// Each chapter is its own module, and this file is the program. Independent
// example files sharing a directory would be the natural shape, but several
// files each declaring `main` currently run an arbitrary one of them (T0979) —
// so the showcase is organised the way an application is, which is honest
// anyway: one entry point, modules beside it.
// =============================================================================

mount showcase.versions.{demo as versions_demo};
mount showcase.effects.{demo as effects_demo};
mount showcase.ownership.{demo as ownership_demo};
mount showcase.capabilities.{demo as capabilities_demo};
mount showcase.references.{demo as references_demo};
mount showcase.sizes.{demo as sizes_demo};
mount showcase.theorems.{demo as theorems_demo};

fn main() {
    print("— versions and proofs —");
    versions_demo();
    print("— effects and purity —");
    effects_demo();
    print("— ownership and tokens —");
    ownership_demo();
    print("— capabilities in the signature —");
    capabilities_demo();
    print("— three tiers of reference —");
    references_demo();
    print("— a size is part of the type —");
    sizes_demo();
    print("— theorems about the design —");
    theorems_demo();
}
