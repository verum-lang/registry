module showcase.effects;

// =============================================================================
// registry showcase — computational properties as the contract between layers
//
// Verum INFERS five properties (Pure, IO, Async, Fallible, Mutates) from the
// body. `pure` is not a promise the author makes and the compiler believes: it
// is a claim the compiler CHECKS. That inversion is what makes a layered
// service design enforceable instead of conventional.
//
// In a registry the layering matters: version arithmetic and name validation
// must be reproducible and testable without a database, while storage and
// logging obviously are not. The `pure` keyword draws that line where the
// reviewer can see it AND where the compiler can hold it.
// =============================================================================

type PackageName is { text: Text };

// -----------------------------------------------------------------------------
// THE PURE CORE — decisions only. No IO, no mutation of anything the caller
// can observe. The compiler refuses this function if that stops being true.
// -----------------------------------------------------------------------------

pure fn name_is_valid(n: PackageName) -> Bool {
    let len = n.text.len();
    len > 0 && len <= 64
}

pure fn score(downloads: Int, days_since_publish: Int) -> Int
    requires downloads >= 0
    requires days_since_publish >= 0
    ensures result >= 0
{
    if days_since_publish == 0 {
        downloads
    } else {
        downloads / (days_since_publish + 1)
    }
}

// A `pure fn` MAY write to its own locals — that is not an effect, because no
// caller can observe it. Without this the keyword would be unusable for the
// ordinary way of writing a loop.
pure fn total(values: List<Int>) -> Int {
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < values.len() {
        acc = acc + values[i];
        i = i + 1;
    }
    acc
}

// What a `pure fn` may NOT do — each of these is a compile error, and the four
// were measured one at a time on a release binary:
//
//   pure fn a() -> Int { print("x"); 1 }        E503 … side effects: IO
//   pure fn b() -> Int { impure_helper() }      E503 … side effects: IO
//   pure fn c() -> Int { spawn { 1 }; 2 }       E503 … side effects: Spawns
//   pure fn d(x: &mut Int) -> Int { *x = 1; 1 } E503 … side effects: Mutates
//
// The last one only started failing today (T0792): the inferrer unioned the
// properties of an assignment's operands and never looked at the assignment.
// A `pure` signature promising that a lent-out `&mut` comes back unchanged was
// not being checked at all.

// -----------------------------------------------------------------------------
// SAYING MORE THAN `pure` — a promise about capabilities NOT used.
// -----------------------------------------------------------------------------
//
// `pure` says the result is a function of the arguments. A NEGATIVE context
// says something else, and stronger: this named capability is never reached
// for, whatever the body does. Written as a group, one name carries several
// such promises.
//
// This is the part with no equivalent in the languages a reader is likely to
// come from. A Rust `fn` cannot say "and I never touch the clock"; a Haskell
// type can say what an action MAY do, not what it declines to do. Here the
// refusal is in the signature, and the compiler checks it.

context Clock {
    fn now(&self) -> Int;
}

context Random {
    fn next(&self) -> Int;
}

using Deterministic = [!Clock, !Random];

// Reads: pure, AND it will not consult the clock, AND it will not draw a
// random number. A caller reviewing a pricing rule can stop reading here.
pure fn ranked(downloads: Int, age: Int) -> Int using Deterministic {
    score(downloads, age)
}

// The group spelling was REFUSED until 2026-08-31 (T0986). `using [!Clock]`
// spelled out worked; the same promise written as a group did not, because a
// group's own reference carries `is_negative: false` and the purity gate read
// the NAME instead of looking through it to its members. One rule, two
// spellings of one thing, two answers — and the stronger statement was the
// unsayable one.
//
// A group that MIXES a promise with an injection is still refused, which is
// what keeps this honest:
//
//   using Mixed = [!Clock, Random];
//   pure fn f() -> Int using Mixed { 42 }
//       E503 … declares context `Random` through group `Mixed`

// -----------------------------------------------------------------------------
// THE EFFECTFUL EDGE — no `pure`, because it prints. The compiler knows.
// -----------------------------------------------------------------------------

fn report(n: PackageName, downloads: Int, age: Int) {
    if name_is_valid(n) {
        print(f"{n.text}: score {score(downloads, age)}");
    } else {
        print("invalid package name");
    }
}

public fn demo() {
    let good = PackageName { text: "left-pad" };
    report(good, 900, 2);

    let empty = PackageName { text: "" };
    report(empty, 0, 0);

    print(f"total {total([1, 2, 3, 4])}");
    print(f"ranked {ranked(900, 2)}");
}
