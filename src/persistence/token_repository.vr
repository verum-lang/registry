// =============================================================================
// verum_registry/persistence/token_repository.vr
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Theorem("v2.0"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "api_tokens repository",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.persistence.token_repository;

mount core.*;
mount base.{Result, Ok, Err, Maybe, Some, None, Text};
mount collections.List;
mount database.common.error.DbError;
mount database.postgres.async_pool.AsyncPgPool;
mount database.postgres.row.Row;
mount time.rfc3339.*;
mount encoding.json.*;

mount verum_registry.domain.{
    ApiToken, TokenId, TokenScope, UserId,
};
mount verum_registry.persistence.sql_params.*;

public type TokenRepository is {
    pool: AsyncPgPool,
};

public fn token_repository_new(pool: AsyncPgPool) -> TokenRepository {
    TokenRepository { pool }
}

public async fn lookup_token(
    repo: &TokenRepository,
    id: &TokenId,
) -> Result<Maybe<ApiToken>, DbError> {
    let conn = repo.pool.acquire().await?;
    let row_opt = conn.query_one_opt(
        """SELECT id, user_id, secret_hash, scopes,
                    expires_at, revoked_at, last_used_at
              FROM api_tokens WHERE id = $1""",
        [tv_ref(id)],
    ).await?;
    match row_opt {
        Some(row) => Ok(Some(decode_token_row(&row)?)),
        None      => Ok(None),
    }
}

public async fn create_token(
    repo: &TokenRepository,
    token: &ApiToken,
) -> Result<(), DbError> {
    let conn = repo.pool.acquire().await?;
    let scopes_json = stringify(&token.scopes);
    conn.execute_with_params(
        """INSERT INTO api_tokens (
                id, user_id, secret_hash, scopes,
                expires_at, revoked_at, last_used_at
            ) VALUES ($1, $2, $3, $4::jsonb, $5, $6, $7)""",
        [
            tv_ref(&token.id),
            tv_ref(&token.user_id),
            tv_ref(&token.secret_hash),
            tv(scopes_json),
            tv_timestamp(&token.expires_at),
            tv_timestamp_opt(&token.revoked_at),
            tv_timestamp_opt(&token.last_used_at),
        ],
    ).await?;
    Ok(())
}

public async fn revoke_token(
    repo: &TokenRepository,
    id: &TokenId,
) -> Result<(), DbError> {
    let conn = repo.pool.acquire().await?;
    conn.execute_with_params(
        """UPDATE api_tokens SET revoked_at = now() WHERE id = $1""",
        [tv_ref(id)],
    ).await?;
    Ok(())
}

public async fn update_token_last_used(
    repo: &TokenRepository,
    id: &TokenId,
) -> Result<(), DbError> {
    let conn = repo.pool.acquire().await?;
    conn.execute_with_params(
        """UPDATE api_tokens SET last_used_at = now() WHERE id = $1""",
        [tv_ref(id)],
    ).await?;
    Ok(())
}

fn decode_token_row(row: &Row) -> Result<ApiToken, DbError> {
    let scopes_text = row.get_text("scopes").unwrap_or_else(|_| "[]".to_text());
    let scopes: List<TokenScope> = json_parse(&scopes_text)
        .map_err(|e| DbError.DecodeFailed { fault: f"scopes json: {e}" })?
        .try_into()
        .map_err(|e| DbError.DecodeFailed { fault: f"scopes: {e}" })?;
    Ok(ApiToken {
        id:           row.get_text("id")?,
        user_id:      row.get_text("user_id")?,
        secret_hash:  row.get_text("secret_hash")?,
        scopes:       scopes,
        expires_at:   row.get_timestamp("expires_at")?,
        revoked_at:   row.get_timestamp_opt("revoked_at")?,
        last_used_at: row.get_timestamp_opt("last_used_at")?,
    })
}
