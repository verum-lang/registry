// =============================================================================
// verum_registry/persistence/mod.vr — persistence layer (spec §7)
// =============================================================================
//
// Postgres queries via the compile-time `sql#"..."` meta-fn. Affine
// `Transaction` enforces commit/rollback at compile time. S3 wraps
// the configured bucket. Redis adapts the cache. MeiliSearch adapts
// search.
//
// **ATS-V articulation.** Persistence is the registry's *durable
// boundary*. Stratum = LCls (uses classical logic for transactional
// invariants). Tier = Aot (real I/O). Capabilities exposed:
// Read+Write filesystem (for TLS material), Persist for each
// concrete medium (Postgres, S3, Ledger=sumdb), Network (outbound
// for cache + search). Composes against every concrete storage
// adapter in the stdlib.
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LCls,
    at_tier:       Tier.Aot,
    lifecycle:     Lifecycle.Theorem("canonical"),
    exposes: [
        Capability.Persist(PersistenceMedium.Postgres),
        Capability.Persist(PersistenceMedium.S3),
        Capability.Persist(PersistenceMedium.Ledger),
        Capability.Network(NetProtocol.Tcp, NetDirection.Outbound),
    ],
    requires: [
        Capability.Read(ResourceTag.Filesystem),
    ],
    composes_with: [
        "core.database.postgres".to_text(),
        "core.database.postgres.migrations".to_text(),
        "core.cache.redis".to_text(),
        "core.search.meilisearch".to_text(),
        "core.storage.s3".to_text(),
    ],
    strict:        true,
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "persistence-layer entry point — Postgres + S3 + Redis + MeiliSearch + sumdb".to_text(),
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.persistence;

mount core.*;
mount base.{Result, Ok, Err, Text};
mount database.postgres.{AsyncPgPool, AsyncPoolConfig};
mount database.postgres.async_pool.{connect as pg_async_connect};

mount verum_registry.config.{
    PostgresConfig, S3Config, RedisConfig, MeilisearchConfig,
};

public mount verum_registry.persistence.package_repository.{
    PackageRepository, lookup_package, upsert_package,
    increment_downloads, set_score, lookup_recent_packages,
};
public mount verum_registry.persistence.version_repository.{
    VersionRepository, lookup_version, list_versions,
    insert_version, yank_version, unyank_version,
};
public mount verum_registry.persistence.user_repository.{
    UserRepository, lookup_user_by_id, lookup_user_by_username,
    create_user, link_oidc_identity,
};
public mount verum_registry.persistence.token_repository.{
    TokenRepository, lookup_token, create_token, revoke_token,
    update_token_last_used,
};
public mount verum_registry.persistence.owner_repository.{
    OwnerRepository, list_owners, add_owner, remove_owner,
    is_owner, is_maintainer_or_owner,
};
public mount verum_registry.persistence.sumdb_repository.{
    SumdbRepository, append_entry, lookup_entry,
    save_tree_head, latest_tree_head,
};
public mount verum_registry.persistence.advisory_repository.{
    AdvisoryRepository, list_advisories_for_package,
    insert_advisory, lookup_advisory,
};
public mount verum_registry.persistence.object_store.{
    ObjectStore, put_source_archive, get_source_archive,
    delete_source_archive,
};
public mount verum_registry.persistence.passkey_repository.{PasskeyRepository};
public mount verum_registry.persistence.tuf_metadata_repository.{TufMetadataRepository};
public mount verum_registry.persistence.sigstore_bundle_repository.{SigstoreBundleRepository};
public mount verum_registry.persistence.cog_audit_repository.{CogAuditRepository};

// =============================================================================
// Connection openers
// =============================================================================

public async fn open_postgres(c: &PostgresConfig) -> Result<AsyncPgPool, Text> {
    let pool_cfg = AsyncPoolConfig {
        min_size: c.min_connections as UInt32,
        max_size: c.max_connections as UInt32,
        mailbox_capacity: 64,
        prepare_on_open: None,
    };
    pg_async_connect(&c.url, pool_cfg)
        .await
        .map_err(|e| f"postgres: {e}")
}

public async fn open_object_store(c: &S3Config) -> Result<ObjectStore, Text> {
    ObjectStore.connect(c).await
}

public async fn open_cache(c: &RedisConfig) -> Result<cache.adapters.redis.RedisCacheAdapter, Text> {
    cache.adapters.redis.connect_url(&c.url)
        .await
        .map_err(|e| f"redis: {e}")
}

public async fn open_search(c: &MeilisearchConfig) -> Result<MeilisearchClient, Text> {
    search.meilisearch.connect(&c.url, &c.api_key)
        .await
        .map_err(|e| f"meilisearch: {e}")
}
