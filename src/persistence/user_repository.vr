// =============================================================================
// verum_registry/persistence/user_repository.vr
// =============================================================================
// Spec: §5.1.4 + §6.1
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Theorem("v2.0"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "users + oidc_identities repository",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.persistence.user_repository;

mount core.*;
mount collections.{List, Map};
mount database.common.error.DbError;
mount database.postgres.async_pool.{AsyncPgPool, AsyncPgPoolGuard};
mount database.postgres.row.Row;
mount encoding.json.*;

mount verum_registry.domain.{
    User, UserId, Username, EmailAddress, OidcIdentity,
};
mount verum_registry.persistence.sql_params.*;

public type UserRepository is {
    pool: AsyncPgPool,
};

public fn user_repository_new(pool: AsyncPgPool) -> UserRepository {
    UserRepository { pool }
}

public async fn lookup_user_by_id(
    repo: &UserRepository,
    id: &UserId,
) -> Result<Maybe<User>, DbError> {
    let conn = repo.pool.acquire().await?;
    let row_opt = conn.query_one_opt(
        """SELECT id, username, email, password_hash, created_at
              FROM users WHERE id = $1""",
        [tv_ref(id)],
    ).await?;
    match row_opt {
        Some(row) => Ok(Some(decode_user_with_oidc(&conn, &row).await?)),
        None      => Ok(None),
    }
}

public async fn lookup_user_by_username(
    repo: &UserRepository,
    username: &Username,
) -> Result<Maybe<User>, DbError> {
    let conn2 = repo.pool.acquire().await?;
    let row_opt2 = conn.query_one_opt(
        """SELECT id, username, email, password_hash, created_at
              FROM users WHERE username = $1""",
        [tv_ref(username)],
    ).await?;
    match row_opt {
        Some(row) => Ok(Some(decode_user_with_oidc(&conn, &row).await?)),
        None      => Ok(None),
    }
}

public async fn create_user(
    repo: &UserRepository,
    user: &User,
) -> Result<(), DbError> {
    let conn2 = repo.pool.acquire().await?;
    conn.execute_with_params(
        """INSERT INTO users (id, username, email, password_hash, created_at)
              VALUES ($1, $2, $3, $4, $5)""",
        [
            tv_ref(&user.id),
            tv_ref(&user.username),
            tv_ref(&user.email),
            tv_text_opt(&user.password_hash),
            tv_timestamp(&user.created_at),
        ],
    ).await?;
    let mut i: Int = 0;
    while i < user.oidc_identities.len() {
        link_oidc_identity_inner(&conn, &user.id, &user.oidc_identities[i]).await?;
        i = i + 1;
    }
    Ok(())
}

public async fn link_oidc_identity(
    repo: &UserRepository,
    user_id: &UserId,
    identity: &OidcIdentity,
) -> Result<(), DbError> {
    let conn2 = repo.pool.acquire().await?;
    link_oidc_identity_inner(&conn, user_id, identity).await
}

async fn link_oidc_identity_inner(
    conn: &AsyncPgPoolGuard,
    user_id: &UserId,
    identity: &OidcIdentity,
) -> Result<(), DbError> {
    let metadata_json = stringify(&identity.metadata);
    conn.execute_with_params(
        """INSERT INTO oidc_identities (user_id, issuer, subject, metadata)
              VALUES ($1, $2, $3, $4::jsonb)
              ON CONFLICT (issuer, subject) DO UPDATE SET
                  user_id = EXCLUDED.user_id,
                  metadata = EXCLUDED.metadata""",
        [
            tv_ref(user_id),
            tv_ref(&identity.issuer),
            tv_ref(&identity.subject),
            tv(metadata_json),
        ],
    ).await?;
    Ok(())
}

async fn decode_user_with_oidc(
    conn: &AsyncPgPoolGuard,
    row: &Row,
) -> Result<User, DbError> {
    let id: UserId = row.get_text("id")?;
    let oidc_rows = conn.query(
        """SELECT issuer, subject, metadata
              FROM oidc_identities WHERE user_id = $1""",
        [tv_ref(&id)],
    ).await?;
    let mut oidc_identities: List<OidcIdentity> = List.new();
    let mut i2: Int = 0;
    while i < oidc_rows.len() {
        let metadata_text = oidc_rows[i].get_text("metadata").unwrap_or_else(|_| "{}".to_text());
        let metadata: Map<Text, Text> = parse(&metadata_text)
            .unwrap_or_else(|_| Map.new());
        oidc_identities.push(OidcIdentity {
            issuer:   oidc_rows[i].get_text("issuer")?,
            subject:  oidc_rows[i].get_text("subject")?,
            metadata: metadata,
        });
        i = i + 1;
    }
    Ok(User {
        id:              id,
        username:        row.get_text("username")?,
        email:           row.get_text("email")?,
        password_hash:   row.get_text_opt("password_hash")?,
        oidc_identities: oidc_identities,
        created_at:      row.get_timestamp("created_at")?,
    })
}
