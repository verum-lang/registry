// =============================================================================
// verum_registry/persistence/tuf_metadata_repository.vr (spec v3.0 §6.1)
// =============================================================================
// CRUD for `tuf_root_history` + `tuf_signed_metadata`.
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Theorem("v3.0"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "Postgres CRUD for TUF root_history + signed_metadata",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.persistence.tuf_metadata_repository;

mount core.*;
mount base.{Result, Ok, Err, Maybe, Some, None, Text, Int};
mount collections.List;
mount time.rfc3339.*;
mount database.common.error.DbError;
mount database.postgres.async_pool.AsyncPgPool;
mount database.postgres.row.Row;
mount security.tuf.types.RoleName;

mount verum_registry.domain.tuf_state.{
    TufRootSnapshot, TufSignedMetadata, Hex64, role_to_db_text,
};
mount verum_registry.persistence.sql_params.*;

public type TufMetadataRepository is {
    pool: AsyncPgPool,
};

public fn tuf_metadata_repository_new(pool: AsyncPgPool) -> TufMetadataRepository {
    TufMetadataRepository { pool }
}

implement TufMetadataRepository {
    // =========================================================================
    // Root history
    // =========================================================================

    public async fn insert_root(
        &self,
        snap: &TufRootSnapshot,
    ) -> Result<(), DbError>
    {
        let conn = self.pool.acquire().await?;
        conn.execute_with_params(
            """INSERT INTO tuf_root_history (
                   version, content_bytes, content_sha256, expires_at, created_at
               ) VALUES ($1, $2, $3, $4, $5)""",
            [
                tv_int(snap.version),
                tv_bytes(&snap.content_bytes),
                tv_ref(&snap.content_sha256),
                tv_timestamp(&snap.expires_at),
                tv_timestamp(&snap.created_at),
            ],
        ).await?;
        Ok(())
    }

    public async fn get_root(
        &self,
        version: Int,
    ) -> Result<Maybe<TufRootSnapshot>, DbError>
    {
        let conn = self.pool.acquire().await?;
        let row_opt = conn.query_one_opt(
            """SELECT version, content_bytes, content_sha256, expires_at, created_at
               FROM tuf_root_history
               WHERE version = $1
               LIMIT 1""",
            [tv_int(version)],
        ).await?;
        match row_opt {
            None      => Ok(None),
            Some(row) => Ok(Some(decode_root_row(&row)?)),
        }
    }

    public async fn latest_root(&self) -> Result<Maybe<TufRootSnapshot>, DbError>
    {
        let conn = self.pool.acquire().await?;
        let row_opt = conn.query_one_opt(
            """SELECT version, content_bytes, content_sha256, expires_at, created_at
               FROM tuf_root_history
               ORDER BY version DESC
               LIMIT 1""",
            no_params(),
        ).await?;
        match row_opt {
            None      => Ok(None),
            Some(row) => Ok(Some(decode_root_row(&row)?)),
        }
    }

    // =========================================================================
    // Signed metadata (timestamp / snapshot / targets)
    // =========================================================================

    public async fn insert_signed(
        &self,
        meta: &TufSignedMetadata,
    ) -> Result<(), DbError>
    {
        let conn = self.pool.acquire().await?;
        conn.execute_with_params(
            """INSERT INTO tuf_signed_metadata (
                   role, version, content_bytes, content_sha256, expires_at, created_at
               ) VALUES ($1, $2, $3, $4, $5, $6)""",
            [
                tv_ref(&meta.role),
                tv_int(meta.version),
                tv_bytes(&meta.content_bytes),
                tv_ref(&meta.content_sha256),
                tv_timestamp(&meta.expires_at),
                tv_timestamp(&meta.created_at),
            ],
        ).await?;
        Ok(())
    }

    public async fn get_signed(
        &self,
        role: &RoleName,
        version: Int,
    ) -> Result<Maybe<TufSignedMetadata>, DbError>
    {
        let conn = self.pool.acquire().await?;
        let role_text = role_to_db_text(role);
        let row_opt = conn.query_one_opt(
            """SELECT role, version, content_bytes, content_sha256, expires_at, created_at
               FROM tuf_signed_metadata
               WHERE role = $1 AND version = $2
               LIMIT 1""",
            [tv(role_text), tv_int(version)],
        ).await?;
        match row_opt {
            None      => Ok(None),
            Some(row) => Ok(Some(decode_signed_row(&row)?)),
        }
    }

    public async fn latest_signed(
        &self,
        role: &RoleName,
    ) -> Result<Maybe<TufSignedMetadata>, DbError>
    {
        let conn = self.pool.acquire().await?;
        let role_text = role_to_db_text(role);
        let row_opt = conn.query_one_opt(
            """SELECT role, version, content_bytes, content_sha256, expires_at, created_at
               FROM tuf_signed_metadata
               WHERE role = $1
               ORDER BY version DESC
               LIMIT 1""",
            [tv(role_text)],
        ).await?;
        match row_opt {
            None      => Ok(None),
            Some(row) => Ok(Some(decode_signed_row(&row)?)),
        }
    }

    public async fn next_version(
        &self,
        role: &RoleName,
    ) -> Result<Int, DbError>
    {
        let conn = self.pool.acquire().await?;
        let role_text = role_to_db_text(role);
        let row = conn.query_one(
            """SELECT COALESCE(MAX(version), 0) + 1 AS next_v
               FROM tuf_signed_metadata
               WHERE role = $1""",
            [tv(role_text)],
        ).await?;
        row.get_int("next_v")
    }
}

// =============================================================================
// Row → domain
// =============================================================================

fn decode_root_row(row: &Row) -> Result<TufRootSnapshot, DbError> {
    Ok(TufRootSnapshot {
        version:        row.get_int("version")?,
        content_bytes:  row.get_bytes("content_bytes")?,
        content_sha256: Hex64(row.get_text("content_sha256")?),
        expires_at:     row.get_timestamp("expires_at")?,
        created_at:     row.get_timestamp("created_at")?,
    })
}

fn decode_signed_row(row: &Row) -> Result<TufSignedMetadata, DbError> {
    Ok(TufSignedMetadata {
        role:           row.get_text("role")?,
        version:        row.get_int("version")?,
        content_bytes:  row.get_bytes("content_bytes")?,
        content_sha256: Hex64(row.get_text("content_sha256")?),
        expires_at:     row.get_timestamp("expires_at")?,
        created_at:     row.get_timestamp("created_at")?,
    })
}
