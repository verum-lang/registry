// =============================================================================
// verum_registry/domain/owner.vr — PackageOwner + OwnerRole
// =============================================================================
// Spec: §5.1.6
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "package-ownership domain types",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.domain.owner;

mount core.*;
mount time.rfc3339.Rfc3339Time;

mount verum_registry.domain.package.PackageScope;
mount verum_registry.domain.user.UserId;

@derive(Serialize, Deserialize, Eq, Clone)
public type OwnerRole is
      RoleOwner        // can transfer ownership, delete, manage maintainers
    | RoleMaintainer;  // can publish + yank

public fn owner_role_tag(r: &OwnerRole) -> Text {
    match r {
        RoleOwner       => "owner".to_text(),
        RoleMaintainer  => "maintainer".to_text(),
    }
}

@derive(Serialize, Deserialize, Eq, Clone)
public type PackageOwner is {
    package_id: PackageScope,
    user_id: UserId,
    role: OwnerRole,
    granted_at: Rfc3339Time,
    granted_by: UserId,
};

implement PackageOwner {
    /// True if this owner can publish new versions.
    public fn can_publish(&self) -> Bool { true }  // both roles can

    /// True if this owner can transfer ownership (only RoleOwner).
    public fn can_transfer_ownership(&self) -> Bool {
        match self.role { RoleOwner => true, _ => false }
    }

    /// True if this owner can manage other owners (only RoleOwner).
    public fn can_manage_owners(&self) -> Bool {
        match self.role { RoleOwner => true, _ => false }
    }

    /// True if this owner can yank versions.
    public fn can_yank(&self) -> Bool { true }  // both roles can
}
