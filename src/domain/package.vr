// =============================================================================
// verum_registry/domain/package.vr — PackageRecord
// =============================================================================
// Spec: §5.1.1 / §5.1.2
//
// Refinement-typed records over Verum stdlib primitives. The registry
// owns the *shape* of these records — the underlying types
// (`SemVer`, `Rfc3339Time`, `Url`, `UserId`) are stdlib-provided.
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "PackageRecord domain type with refinement-typed fields",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.domain.package;

mount core.*;
mount base.{Text, Maybe};
mount collections.List;
mount base.semver.SemVer;
mount time.rfc3339.Rfc3339Time;
mount text.url.Url;
mount cog.manifest.{CogName};

mount verum_registry.domain.user.UserId;

// =============================================================================
// PackageScope — alias of CogName (the manifest-side name regex)
// =============================================================================

/// Scoped or unscoped package identifier:
///   * `name`        for unscoped (verified-publisher namespace)
///   * `@org/name`   for scoped
public type PackageScope is CogName;

// =============================================================================
// Refinement-typed leaves
// =============================================================================

/// Search keyword — lowercase alphanumeric + hyphen, 1–32 chars.
@derive(Serialize, Deserialize, Eq, Clone, Hash)
public type Keyword is Text {
    self.matches("^[a-z][a-z0-9-]{0,31}$")
};

/// SPDX license expression.
///
/// **Validation note**: requires `core.security.spdx::is_valid_expression`
/// (forthcoming as part of stdlib G7-adjacent work). Until that lands,
/// we accept any non-empty Text and validate at the service-layer
/// boundary; the refinement is registered as a documentation contract.
@derive(Serialize, Deserialize, Eq, Clone)
public type SpdxExpression is Text {
    self.len() > 0
};

// =============================================================================
// PackageRecord
// =============================================================================

@derive(Serialize, Deserialize, Eq, Clone)
public type PackageRecord is {
    /// Globally-unique scope/name.
    id: PackageScope,
    /// One-line description (≤ 500 bytes; rejects newlines).
    description: Text { len <= 500 },
    /// Canonical homepage URL (optional).
    homepage: Maybe<Url>,
    /// Source repository URL (optional).
    repository: Maybe<Url>,
    /// SPDX license expression.
    license: SpdxExpression,
    /// Search keywords — at most 5.
    keywords: List<Keyword> { len <= 5 },
    /// Latest stable version (highest non-prerelease, non-yanked).
    latest_version: SemVer,
    /// Total cumulative downloads.
    downloads: Int { >= 0 },
    /// Quality score (0–100; computed by publish pipeline; spec §11.4).
    score: Int { >= 0, <= 100 },
    /// Creation timestamp.
    created_at: Rfc3339Time,
    /// Last update timestamp.
    updated_at: Rfc3339Time,
    /// Owner user IDs (AT LEAST ONE — refinement-enforced).
    owners: List<UserId> { len >= 1 },
};
