// =============================================================================
// verum_registry/domain/errors.vr — domain error taxonomy
// =============================================================================
// Spec: §8.4 (error envelope)
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "structured error taxonomy for service-layer failures",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.domain.errors;

mount core.*;
mount collections.List;
mount base.semver.SemVer;
mount core.cog.manifest.{ManifestError};
mount architecture.types.AntiPatternViolation;

mount verum_registry.domain.package.PackageScope;

// =============================================================================
// PublishError — the eight-phase publish workflow's failure surface
// =============================================================================

public type PublishError is
      ManifestParseFailed(ManifestError)
    | NotAnOwner
    | VersionExists(SemVer)
    | VersionNotMonotone { latest: SemVer, proposed: SemVer }
    | TyposquattingSuspected { proposed: PackageScope, similar: PackageScope, distance: Int }
    | MalwareDetected(Text)
    | ArchiveDecodeFailed(Text)
    | CompileFailed(Text)
    | AntiPatternViolations(List<AntiPatternViolation>)
    | StorageFailed(Text)
    | DatabaseFailed(Text)
    | SumdbAppendFailed(Text)
    | InternalError(Text);

public fn publish_error_code(e: &PublishError) -> Text {
    match e {
        ManifestParseFailed(_)        => "manifest_parse_failed".to_text(),
        NotAnOwner                    => "not_an_owner".to_text(),
        VersionExists(_)              => "version_exists".to_text(),
        VersionNotMonotone { .. }     => "version_not_monotone".to_text(),
        TyposquattingSuspected { .. } => "typosquatting_suspected".to_text(),
        MalwareDetected(_)            => "malware_detected".to_text(),
        ArchiveDecodeFailed(_)        => "archive_decode_failed".to_text(),
        CompileFailed(_)              => "compile_failed".to_text(),
        AntiPatternViolations(_)      => "anti_pattern_violations".to_text(),
        StorageFailed(_)              => "storage_failed".to_text(),
        DatabaseFailed(_)             => "database_failed".to_text(),
        SumdbAppendFailed(_)          => "sumdb_append_failed".to_text(),
        InternalError(_)              => "internal_error".to_text(),
    }
}

/// HTTP status mapping for publish errors.  Spec §8.2 (POST /publish).
public fn publish_error_http_status(e: &PublishError) -> Int {
    match e {
        ManifestParseFailed(_)
        | VersionNotMonotone { .. }
        | ArchiveDecodeFailed(_)
        | CompileFailed(_)
        | AntiPatternViolations(_)
            => 422,  // Unprocessable Entity
        NotAnOwner                    => 403,  // Forbidden
        VersionExists(_)              => 409,  // Conflict
        TyposquattingSuspected { .. }
        | MalwareDetected(_)
            => 409,  // Conflict (manual-review queue)
        StorageFailed(_)
        | DatabaseFailed(_)
        | SumdbAppendFailed(_)
        | InternalError(_)
            => 500,  // Internal Server Error
    }
}

// =============================================================================
// Other service errors
// =============================================================================

public type SearchError is
      InvalidQuery(Text)
    | SearchBackendFailed(Text)
    | RateLimited;

public type SumdbError is
      VersionNotInLog { package_id: PackageScope, version: SemVer }
    | TileNotFound { level: Int, index: Int }
    | LogIntegrityFailed(Text)
    | StorageFailed(Text);

public type AuthError is
      MissingCredentials
    | InvalidApiToken
    | RevokedApiToken
    | ExpiredApiToken
    | InvalidOidcToken(Text)
    | OidcIssuerNotTrusted(Text)
    | RateLimited;

public type ProvenanceError is
      InvalidEnvelope(Text)
    | SignatureFailed(Text)
    | UnsupportedStatement(Text);

public type ResolveError is
      DependencyNotFound { name: Text }
    | NoVersionMatching { name: Text, constraint: Text }
    | ConflictingConstraints(List<Text>)
    | DependencyCycle(List<Text>)
    | InternalError(Text);
