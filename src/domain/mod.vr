// =============================================================================
// verum_registry/domain/mod.vr — domain entities (spec §5)
// =============================================================================
//
// Re-exports domain types so callers `mount verum_registry.domain.*`
// have everything in scope.
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "domain layer entry point — refinement-typed records over stdlib primitives",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.domain;

public mount verum_registry.domain.package.{
    PackageScope, PackageRecord, Keyword, SpdxExpression,
};
public mount verum_registry.domain.version.{
    PackageVersion, Hex64, VerificationLevel,
};
public mount verum_registry.domain.user.{
    User, UserId, Username, EmailAddress,
    ApiToken, TokenId, TokenScope,
    OidcIdentity,
};
public mount verum_registry.domain.owner.{
    PackageOwner, OwnerRole,
};
public mount verum_registry.domain.sumdb.{SumdbEntry};
public mount verum_registry.domain.advisory.{
    SecurityAdvisory, Severity, AdvisoryId,
};
public mount verum_registry.domain.errors.{
    PublishError, SearchError, SumdbError, AuthError,
    ProvenanceError, ResolveError,
};
