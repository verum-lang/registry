// =============================================================================
// verum_registry/domain/mod.vr — domain entities (spec §6)
// =============================================================================
// Re-exports domain types so callers `mount verum_registry.domain.*`
// have everything in scope.
//
// **ATS-V articulation.** Domain layer is the registry's
// *boundary* — the surface where wire formats meet typed Verum
// records. Foundation = ZfcTwoInacc; Stratum = LFnd (foundational —
// only refinement-typed records); Tier = Check (no runtime
// behaviour, only types); Lifecycle = Definition (boundary by
// fiat). No Capability exposed (pure-types layer).
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    at_tier:       Tier.Check,
    lifecycle:     Lifecycle.Definition,
    exposes:       [],
    requires:      [],
    composes_with: [
        "core.architecture.types".to_text(),
        "core.base.semver".to_text(),
        "core.base.ulid".to_text(),
        "core.cog.manifest".to_text(),
        "core.security.webauthn".to_text(),
        "core.security.sigstore".to_text(),
        "core.security.tuf".to_text(),
        "core.security.provenance".to_text(),
        "core.time.rfc3339".to_text(),
    ],
    strict:        true,
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "domain layer entry point — refinement-typed records over stdlib primitives".to_text(),
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.domain;

public mount verum_registry.domain.package.{
    PackageScope, PackageRecord, Keyword, SpdxExpression,
};
public mount verum_registry.domain.version.{
    PackageVersion, PublishIdentity, Hex64, VerificationLevel,
};

// SemVer is the canonical version type; re-exported through `domain`
// so callers that already mount `verum_registry.domain.{…}` for the
// rest of the registry vocabulary don't need a parallel
// `mount core.base.semver.{SemVer}` next to every domain import.
public mount core.base.semver.{SemVer};
public mount verum_registry.domain.user.{
    User, UserId, Username, EmailAddress,
    ApiToken, TokenId, TokenScope,
    OidcIdentity,
};
public mount verum_registry.domain.owner.{
    PackageOwner, OwnerRole,
    RoleOwner, RoleMaintainer,
    owner_role_tag,
};
public mount verum_registry.domain.sumdb.{SumdbEntry};
public mount verum_registry.domain.advisory.{
    SecurityAdvisory, Severity, AdvisoryId,
    SevLow, SevMedium, SevHigh, SevCritical,
};
public mount verum_registry.domain.errors.{
    PublishError, SearchError, SumdbError, AuthError,
    ProvenanceError, ResolveError,
    // Unique-named variant constructors surfaced at the domain
    // re-export level — registers explicitly because re-exporting
    // the sum type itself doesn't yet propagate constructor names.
    // RateLimited / StorageFailed / InternalError are intentionally
    // omitted: those names appear in multiple sum types and would
    // collide; callers reach them via the qualified variant form.
    ManifestParseFailed, NotAnOwner, VersionExists,
    VersionNotMonotone, TyposquattingSuspected, MalwareDetected,
    ArchiveDecodeFailed, CompileFailed, AntiPatternViolations,
    DatabaseFailed, SumdbAppendFailed,
    InvalidQuery, SearchBackendFailed,
    InvalidEnvelope, SignatureFailed, UnsupportedStatement,
    VersionNotInLog, TileNotFound, LogIntegrityFailed,
    DependencyNotFound, NoVersionMatching, ConflictingConstraints,
    DependencyCycle,
    MissingCredentials, InvalidApiToken, RevokedApiToken,
    ExpiredApiToken, InvalidOidcToken, OidcIssuerNotTrusted,
};
public mount verum_registry.domain.passkey.{
    Passkey, passkey_from_verified_credential, passkey_to_verified_credential,
};
public mount verum_registry.domain.sigstore_bundle.{
    SigstoreBundleRecord, sigstore_bundle_record_new,
};
public mount verum_registry.domain.tuf_state.{
    TufRootSnapshot, TufSignedMetadata, role_to_db_text,
};
public mount verum_registry.domain.cog_audit_record.{CogAuditRecord};
