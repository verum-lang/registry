// =============================================================================
// verum_registry/domain/user.vr — User + ApiToken + OidcIdentity
// =============================================================================
// Spec: §5.1.4 / §5.1.5
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "user / api-token / OIDC-identity domain types",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.domain.user;

mount core.*;
mount base.{Text, Maybe};
mount collections.List;
mount base.ulid.Ulid;
mount time.rfc3339.Rfc3339Time;
mount security.password_hash.Argon2idHash;

mount verum_registry.domain.package.PackageScope;

// =============================================================================
// Refinement-typed leaves
// =============================================================================

/// User identifier — monotonic-sortable Crockford-base32 ULID (26 chars).
@derive(Serialize, Deserialize, Eq, Clone, Hash)
public type UserId is Ulid;

/// Public username — lowercase alphanumeric + hyphen + underscore, 2–64.
@derive(Serialize, Deserialize, Eq, Clone, Hash)
public type Username is Text {
    self.matches("^[a-z][a-z0-9_-]{1,63}$")
};

/// RFC 5321 conformant email address.  Full validation deferred to
/// `core.text.email::is_valid` (forthcoming); for now the refinement
/// is a documentation contract and presence of `@`.
@derive(Serialize, Deserialize, Eq, Clone)
public type EmailAddress is Text {
    self.contains("@") && self.len() >= 3
};

@derive(Serialize, Deserialize, Eq, Clone)
public type TokenId is Ulid;

// =============================================================================
// OIDC identity
// =============================================================================

@derive(Serialize, Deserialize, Eq, Clone)
public type OidcIdentity is {
    /// OIDC issuer URL (e.g., `https://token.actions.githubusercontent.com`).
    issuer: Text,
    /// OIDC `sub` claim — provider-internal subject identifier.
    subject: Text,
    /// Provider-specific metadata (repository, workflow, ref, ...).
    metadata: Map<Text, Text>,
};

// =============================================================================
// User
// =============================================================================

@derive(Serialize, Deserialize, Eq, Clone)
public type User is {
    id: UserId,
    username: Username,
    email: EmailAddress,
    /// Argon2id password hash (only used for non-OIDC accounts).
    /// `None` when the user authenticates via OIDC only.
    password_hash: Maybe<Argon2idHash>,
    /// Trusted-publisher OIDC identities the user has linked.
    oidc_identities: List<OidcIdentity>,
    created_at: Rfc3339Time,
};

// =============================================================================
// ApiToken — long-lived credential with scopes + mandatory expiry
// =============================================================================

@derive(Serialize, Deserialize, Eq, Clone)
public type ApiToken is {
    id: TokenId,
    user_id: UserId,
    /// Argon2id hash of the token secret.  The plaintext is shown to
    /// the user once at creation and is never persisted.
    secret_hash: Argon2idHash,
    /// Scopes — typed enum, no string parsing on the hot path.
    scopes: List<TokenScope>,
    /// Hard expiry (REQUIRED — no perpetual tokens).
    expires_at: Rfc3339Time,
    /// Optional soft-revocation timestamp.
    revoked_at: Maybe<Rfc3339Time>,
    /// Last successful use (for audit).
    last_used_at: Maybe<Rfc3339Time>,
};

@derive(Serialize, Deserialize, Eq, Clone)
public type TokenScope is
      ScopePublishPackage(PackageScope)
    | ScopeYankPackage(PackageScope)
    | ScopeReadAll
    | ScopeManageOwners(PackageScope)
    | ScopeAdmin;

public fn token_scope_tag(s: &TokenScope) -> Text {
    match s {
        ScopePublishPackage(_)  => "publish".to_text(),
        ScopeYankPackage(_)     => "yank".to_text(),
        ScopeReadAll            => "read".to_text(),
        ScopeManageOwners(_)    => "manage_owners".to_text(),
        ScopeAdmin              => "admin".to_text(),
    }
}
