// =============================================================================
// verum_registry/domain/version.vr — PackageVersion
// =============================================================================
// Spec: §5.1.3
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "PackageVersion domain type with refinement-typed checksum",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.domain.version;

mount core.*;
mount base.{Text, Maybe};
mount collections.{List, Map};
mount base.semver.SemVer;
mount time.rfc3339.Rfc3339Time;
mount cog.manifest.{DependencySpec, LanguageProfile};
mount architecture.types.Lifecycle;

mount verum_registry.domain.package.PackageScope;
mount verum_registry.domain.user.UserId;

// =============================================================================
// Refinement-typed leaves
// =============================================================================

/// Lowercase hex-encoded SHA-256 (64 chars).
@derive(Serialize, Deserialize, Eq, Clone, Hash)
public type Hex64 is Text {
    where self.len() == 64 && self.matches(r"^[0-9a-f]{64}$")
};

/// Verification level achieved at compile-time.  Mirrors the 9-strategy
/// verification ladder; recorded per version for filtering.  See
/// `core.verify.level::VerificationLevel` for the canonical enum;
/// the registry stores the textual annotation.
@derive(Serialize, Deserialize, Eq, Clone)
public type VerificationLevel is Text {
    where self.matches(r"^(runtime|static|fast|formal|proof|thorough|reliable|certified|coherent_static|coherent_runtime|coherent|synthesize)$")
};

// =============================================================================
// PackageVersion
// =============================================================================

@derive(Serialize, Deserialize, Eq, Clone)
public type PackageVersion is {
    package_id: PackageScope,
    version: SemVer,
    edition: Text,
    language_profile: LanguageProfile,
    dependencies: Map<Text, DependencySpec>,
    dev_dependencies: Map<Text, DependencySpec>,
    build_dependencies: Map<Text, DependencySpec>,
    features: Map<Text, List<Text>>,
    default_features: List<Text>,
    /// SHA-256 of the source archive (hex-encoded, lowercase, 64 chars).
    source_sha256: Hex64,
    /// CVE Lifecycle declared by the cog's `@arch_module(...)`.
    cve_lifecycle: Lifecycle,
    /// Hash of the cog's canonicalised ShapeDeclarations record
    /// — drift detection between manifest and compiled cog.
    shape_declarations_digest: Hex64,
    /// Verification level achieved.
    verification_level: VerificationLevel,
    published_at: Rfc3339Time,
    published_by: UserId,
    yanked: Bool,
    /// Required when `yanked == true` (spec §10.1).  Refinement
    /// enforced at construction.
    yank_reason: Maybe<Text>,
    /// Optional SLSA / in-toto attestation envelope.
    provenance: Maybe<Text>,  // DSSE-encoded JSON; full type forthcoming
                              // as `core.security.provenance::DsseEnvelope`.
};
