// =============================================================================
// verum_registry/domain/version.vr — PackageVersion (spec v3.0 §5.1.3)
// =============================================================================
// v3.0 changes from v2.0:
//   - `published_by: UserId` → `published_by: PublishIdentity` (4 pathways:
//     Sigstore / OidcDirect / ApiToken / WebAuthn).
//   - `provenance: Maybe<Text>` → `bundle_id: Maybe<Ulid>` referencing
//     the SigstoreBundleRecord.
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "PackageVersion domain type with refinement-typed checksum + 4-pathway PublishIdentity",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.domain.version;

mount core.*;
mount base.{Text, Maybe, Some, None, Bool, Int};
mount collections.{List, Map};
mount base.semver.SemVer;
mount base.ulid.Ulid;
mount time.rfc3339.Rfc3339Time;
mount core.cog.manifest.{DependencySpec, LanguageProfile};
mount architecture.types.Lifecycle;

mount verum_registry.domain.package.PackageScope;
mount verum_registry.domain.user.UserId;

// =============================================================================
// Refinement-typed leaves
// =============================================================================

@derive(Serialize, Deserialize, Eq, Clone, Hash)
public type Hex64 is Text {
    self.len() == 64 && self.matches("^[0-9a-f]{64}$")
};

@derive(Serialize, Deserialize, Eq, Clone)
public type VerificationLevel is Text {
    self.matches("^(runtime|static|fast|formal|proof|thorough|reliable|certified|coherent_static|coherent_runtime|coherent|synthesize)$")
};

// =============================================================================
// PublishIdentity (NEW v3.0)
// =============================================================================
//
// Discriminated union over the four authentication pathways the
// registry accepts. The persistence layer stores this as four
// columns (kind + subject + issuer + bundle_id) per spec v3.0
// §6.1 migration 0005 — see `version_repository.vr`'s row→domain
// mapping.

@derive(Serialize, Deserialize, Eq, Clone, Debug)
public type PublishIdentity is
    /// Sigstore-keyless: OIDC subject in the cert SAN.
    | Sigstore {
        issuer:           Text,
        subject:          Text,
        log_index:        Int { >= 0 },
        integrated_time:  Rfc3339Time,
      }
    /// Legacy direct OIDC token (no Sigstore Bundle).
    | OidcDirect {
        issuer:  Text,
        subject: Text,
      }
    /// Long-lived API token used by an offline CI environment.
    | ApiToken(UserId)
    /// Manual web publish authenticated via a WebAuthn passkey.
    | WebAuthn(UserId);

implement PublishIdentity {
    /// Persistence-friendly discriminant for the
    /// `versions.published_by_kind` column.
    public fn kind_text(&self) -> Text {
        match self {
            PublishIdentity.Sigstore { .. }   => "sigstore".to_text(),
            PublishIdentity.OidcDirect { .. } => "oidc_direct".to_text(),
            PublishIdentity.ApiToken(_)       => "api_token".to_text(),
            PublishIdentity.WebAuthn(_)       => "webauthn".to_text(),
        }
    }

    /// OIDC subject when sigstore/oidc_direct; None for token/webauthn.
    public fn oidc_subject(&self) -> Maybe<Text> {
        match self {
            PublishIdentity.Sigstore { subject, .. }   => Some(subject.clone()),
            PublishIdentity.OidcDirect { subject, .. } => Some(subject.clone()),
            _ => None,
        }
    }

    /// OIDC issuer when sigstore/oidc_direct; None for token/webauthn.
    public fn oidc_issuer(&self) -> Maybe<Text> {
        match self {
            PublishIdentity.Sigstore { issuer, .. }   => Some(issuer.clone()),
            PublishIdentity.OidcDirect { issuer, .. } => Some(issuer.clone()),
            _ => None,
        }
    }

    /// User ID when api_token/webauthn; None for sigstore/oidc_direct
    /// (those bind to a Sigstore identity, not a registry user — the
    /// owner-mapping happens via the trusted-publishers config).
    public fn user_id(&self) -> Maybe<UserId> {
        match self {
            PublishIdentity.ApiToken(uid) => Some(uid.clone()),
            PublishIdentity.WebAuthn(uid) => Some(uid.clone()),
            _ => None,
        }
    }
}

// =============================================================================
// PackageVersion (extended for Sigstore)
// =============================================================================

@derive(Serialize, Deserialize, Eq, Clone)
public type PackageVersion is {
    package_id: PackageScope,
    version: SemVer,
    edition: Text,
    language_profile: LanguageProfile,
    dependencies: Map<Text, DependencySpec>,
    dev_dependencies: Map<Text, DependencySpec>,
    build_dependencies: Map<Text, DependencySpec>,
    features: Map<Text, List<Text>>,
    default_features: List<Text>,
    /// SHA-256 of the source archive (hex-encoded, lowercase, 64 chars).
    source_sha256: Hex64,
    cve_lifecycle: Lifecycle,
    shape_declarations_digest: Hex64,
    verification_level: VerificationLevel,
    published_at: Rfc3339Time,
    /// 4-pathway authenticated identity at publish time.
    published_by: PublishIdentity,
    yanked: Bool,
    yank_reason: Maybe<Text>,
    /// FK to SigstoreBundleRecord when published_by = Sigstore;
    /// None otherwise. For non-Sigstore publishes that still carried
    /// a publisher-supplied DSSE envelope, the envelope is stored
    /// directly in the version row (legacy column retained for now).
    bundle_id: Maybe<Ulid>,
};
