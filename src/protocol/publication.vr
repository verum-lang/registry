// Spec: Cog Publication Protocol v1 — exact-byte envelope.
module verum_registry.protocol.publication;

/// A framed upload. JSON schema, digest, archive contents, credentials and
/// durable publication must be validated by subsequent admission stages.
public type PublicationEnvelope is {
    metadata: Text,
    archive: List<Byte>,
};

/// Configured bounds can only be constructed through publication_limits.
public type PublicationLimits is {
    private metadata_bytes: Int,
    private archive_bytes: Int,
};

public type EnvelopeError is
    | InvalidLimits
    | Truncated
    | EmptyMetadata
    | MetadataTooLarge
    | EmptyArchive
    | ArchiveTooLarge
    | TrailingBytes
    | InvalidUtf8;

public pure fn publication_limits(
    metadata_bytes: Int,
    archive_bytes: Int,
) -> Result<PublicationLimits, EnvelopeError> {
    if metadata_bytes < 1 || metadata_bytes > 1048576
        || archive_bytes < 1 || archive_bytes > 67108864 {
        return Result.Err(EnvelopeError.InvalidLimits);
    }
    Result.Ok(PublicationLimits {
        metadata_bytes: metadata_bytes,
        archive_bytes: archive_bytes,
    })
}

/// The HTTP body reader must enforce this bound while receiving bytes,
/// including the two length fields. Headers need their own bound.
public pure fn publication_body_limit(limits: &PublicationLimits) -> Int {
    limits.metadata_bytes + limits.archive_bytes + 12
}

// The caller has checked that every header byte exists. Reading from the
// most significant byte lets us refuse values above the configured bound
// before multiplication, including an unsigned u64 that cannot fit Int.
fn bounded_length(body: &List<Byte>, offset: Int, width: Int, limit: Int) -> Maybe<Int> {
    let mut value = 0;
    let mut remaining = width;
    while remaining > 0 {
        remaining = remaining - 1;
        let byte = body[offset + remaining] as Int;
        if value > limit / 256
            || (value == limit / 256 && byte > limit % 256) {
            return Maybe.None;
        }
        value = value * 256 + byte;
    }
    Maybe.Some(value)
}

/// Decode one complete v1 body. Every offset is bounded before indexing;
/// allocations follow all length, configured-limit and trailing-byte checks.
public fn decode_publication_envelope(
    body: &List<Byte>,
    limits: &PublicationLimits,
) -> Result<PublicationEnvelope, EnvelopeError> {
    if body.len() < 4 {
        return Result.Err(EnvelopeError.Truncated);
    }
    let metadata_len = match bounded_length(body, 0, 4, limits.metadata_bytes) {
        Maybe.Some(value) => value,
        Maybe.None => return Result.Err(EnvelopeError.MetadataTooLarge),
    };
    if metadata_len == 0 {
        return Result.Err(EnvelopeError.EmptyMetadata);
    }
    if body.len() - 4 < metadata_len {
        return Result.Err(EnvelopeError.Truncated);
    }
    let archive_header = 4 + metadata_len;
    if body.len() - archive_header < 8 {
        return Result.Err(EnvelopeError.Truncated);
    }
    let archive_len = match bounded_length(body, archive_header, 8, limits.archive_bytes) {
        Maybe.Some(value) => value,
        Maybe.None => return Result.Err(EnvelopeError.ArchiveTooLarge),
    };
    if archive_len == 0 {
        return Result.Err(EnvelopeError.EmptyArchive);
    }
    let archive_start = archive_header + 8;
    let available = body.len() - archive_start;
    if available < archive_len {
        return Result.Err(EnvelopeError.Truncated);
    }
    if available > archive_len {
        return Result.Err(EnvelopeError.TrailingBytes);
    }

    let mut metadata_bytes: List<Byte> = List.with_capacity(metadata_len);
    let mut index = 0;
    while index < metadata_len {
        metadata_bytes.push(body[4 + index]);
        index = index + 1;
    }
    let metadata = match Text.from_utf8(metadata_bytes.as_slice()) {
        Result.Ok(text) => text,
        Result.Err(_) => return Result.Err(EnvelopeError.InvalidUtf8),
    };
    let mut archive: List<Byte> = List.with_capacity(archive_len);
    index = 0;
    while index < archive_len {
        archive.push(body[archive_start + index]);
        index = index + 1;
    }
    Result.Ok(PublicationEnvelope { metadata: metadata, archive: archive })
}
