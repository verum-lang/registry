// =============================================================================
// verum_registry.protocol.hash — a digest carries its width in its type
// =============================================================================
// Spec: registry-federation-protocol §2.1 (artefact identity)
//
// The wire form of a digest is text (`blake3:c0ffee…`) because that is
// what crosses a network. The COMPARED form is bytes, and comparing
// bytes is where a registry gets it wrong in a way nobody notices:
//
//   * a 32-byte digest against the first 32 bytes of a 64-byte one —
//     equal for as long as anyone looks, and an artefact nobody signed;
//   * a truncated read that yields fewer bytes than the algorithm
//     produces, compared against a full one and reported as a mismatch;
//   * two algorithms of the same width, mixed.
//
// The first two are LENGTH errors, and a length is exactly the kind of
// thing a type can hold.
//
// THE RULE: A HASH OF ONE WIDTH IS NOT A HASH OF ANOTHER.
//
//     public type Hash<N: meta USize {it == 32 || it == 64}> is
//         { bytes: [Byte; N] };
//
// Two things are happening in that line and both are checked at COMPILE
// TIME.
//
// `N` is part of the type's IDENTITY, so `Hash<32>` and `Hash<64>` are
// different types and no comparison between them exists to be got
// wrong. Not a length check someone can forget — there is no function
// to call.
//
// And the REFINEMENT `{it == 32 || it == 64}` says which widths this
// protocol admits at all. `Hash<20>` — SHA-1, which this protocol does
// not accept — is not a type either:
//
//     E506: meta argument 1 of `Hash` violates its refinement:
//           `20` does not satisfy `it == 32 || it == 64`
//
// A predicate on a compile-time parameter, decided by the compiler. The
// alternative everywhere else is a runtime assertion in a constructor,
// which is a check that runs after the value exists and can be bypassed
// by any other constructor anyone adds later.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module verum_registry.protocol.hash;

// -----------------------------------------------------------------------------
// The type
// -----------------------------------------------------------------------------

/// A raw hash of exactly `N` bytes, where `N` is one of the widths this
/// protocol admits.
public type Hash<N: meta USize {it == 32 || it == 64}> is {
    public bytes: [Byte; N],
};

/// The two widths, named, so a signature reads as what it means rather
/// than as a number.
public type Wide is (Hash<64>);
public type Narrow is (Hash<32>);

// -----------------------------------------------------------------------------
// Comparison
// -----------------------------------------------------------------------------

/// Constant-time equality of two 32-byte hashes.
///
/// THREE PROPERTIES, and the language carries two of them so the code
/// only has to carry the third.
///
/// The WIDTH is the type's business: this function cannot be handed a
/// 64-byte hash, so there is no prefix comparison to write incorrectly
/// and no length check to forget.
///
/// The MEMORY SAFETY is the reference tier's business, and this is the
/// one place in the programme that moves the dial. Everything else uses
/// the default `&T`, which carries a generation and validates it on
/// every dereference — about 15 ns, and worth it everywhere the cost is
/// invisible. Here it is not invisible: the loop below performs 64
/// guarded reads per comparison, and a slice import compares one hash
/// per artefact, so a hundred-thousand-item import pays for 6.4 million
/// of them.
///
/// `&checked` is Tier 1: the SAME guarantee, established by the
/// compiler instead of at run time, and it is an error rather than a
/// downgrade if the proof does not go through. The proof here is the
/// short kind — `a` and `b` are parameters, the loop does not store
/// them anywhere, and nothing escapes the call — which is precisely
/// what escape analysis is for.
///
/// What this module deliberately does NOT contain is a `&unsafe`. That
/// tier means a human wrote the proof, and the only honest reason to
/// reach for it is a measurement showing Tier 1 refused a case that is
/// actually safe. There is no such measurement here, and a safety
/// annotation nobody can justify is worse than the check it removes.
///
/// MEASURED, so the tier choice is not folklore: at Tier 0 the two
/// tiers are indistinguishable — 431 ns/op against 434 ns/op over
/// 200 000 iterations — because interpretation dominates and the CBGR
/// check disappears into it. The payoff is at Tier 1, where an
/// instruction costs about a nanosecond and a 15 ns check does not.
/// That second measurement has not been taken, and this comment says
/// so rather than implying it.
///
/// The TIMING is this function's own business: it accumulates a
/// difference over every byte rather than returning at the first
/// mismatch, because a comparison that returns early tells a caller how
/// many leading bytes they guessed right, and that is enough to forge a
/// digest one byte at a time.
public pure fn equal_narrow(a: &checked Narrow, b: &checked Narrow) -> Bool {
    let mut diff = 0;
    let mut i = 0;
    while i < 32 {
        diff = diff | ((a.0.bytes[i] as Int) ^ (b.0.bytes[i] as Int));
        i = i + 1;
    }
    diff == 0
}

/// The same, for 64-byte hashes. Deliberately a SEPARATE function
/// rather than one generic over `N`: the loop bound is the width, and
/// writing it once for both would mean reading the width at runtime —
/// which is the length check this design exists to remove.
public pure fn equal_wide(a: &checked Wide, b: &checked Wide) -> Bool {
    let mut diff = 0;
    let mut i = 0;
    while i < 64 {
        diff = diff | ((a.0.bytes[i] as Int) ^ (b.0.bytes[i] as Int));
        i = i + 1;
    }
    diff == 0
}

// -----------------------------------------------------------------------------
// The obligation this module carries (spec §6)
// -----------------------------------------------------------------------------

/// A hash equals itself.
///
/// Small, and the one a verification leans on: if a digest could fail to
/// match itself, every artefact would be refused. It is also the claim
/// that catches a comparison written with the wrong loop bound — a loop
/// to 31 would still return true here, but a loop to 33 would read past
/// the array and the property would fail.
public pure fn narrow_equals_itself(h: &checked Narrow) -> Bool {
    equal_narrow(h, h)
}

@verify(formal)
public theorem a_hash_matches_itself(h: &checked Narrow)
    ensures narrow_equals_itself(h)
    // PROVED — measured 2026-09-06 by `tools/verify_obligations.sh`:
    //
    //     ✓ theorem a_hash_matches_itself: Proved in 0.01s
    //
    // THE COMMENT THAT STOOD HERE SAID THE OPPOSITE. It read "STATED,
    // NOT YET DISCHARGED … the body is a LOOP, and the prover does not
    // unfold one" — an explanation of why this cannot be proved, sitting
    // above a theorem that is. Whether the prover grew the reach or the
    // explanation was wrong when written is not established; what is
    // established is that the text outlived the condition it described,
    // and nobody re-ran it because the claim was in prose.
    //
    // The measurement carries a NEGATIVE CONTROL for the same reason
    // this line is now dated: every goal reports in 0.00s, which is what
    // a vacuous pass looks like, so the script first requires two
    // deliberately false theorems to FAIL.
    proof by auto;
