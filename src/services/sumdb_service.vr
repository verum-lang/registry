// =============================================================================
// verum_registry/services/sumdb_service.vr — transparency-log service
// =============================================================================
// Spec: §7.3, §9.3
//
// Wraps `core.security.transparency_log` for HTTP exposure. The log is
// persisted in Postgres (sumdb_entries + sumdb_tree_heads tables); the
// service hydrates a `TransparencyLog` instance from those tables on
// startup and appends through the runtime instance after each publish.
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LCls,
    lifecycle:     Lifecycle.Theorem("v2.0"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "registry sumdb — transparency log over published-version checksums",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.services.sumdb_service;

mount core.*;
mount base.{Result, Ok, Err, Maybe, Some, None, Text};
mount collections.List;
mount base.semver.SemVer;
mount security.transparency_log.{
    TransparencyLog, LogLeaf, SignedTreeHead, Tile, TileCoord,
    LogError, new as log_new,
    append, sign_current_tree_head, inclusion_proof, tile_at,
    tiles_for_inclusion,
};
mount security.ecc.ed25519.{generate_seed, public_key};
mount database.postgres.async_pool.AsyncPgPool;
mount time.system_time.now_unix_ns;

mount verum_registry.config.SumdbConfig;
mount verum_registry.domain.{
    PackageScope, Hex64,
    SumdbError, VersionNotInLog, TileNotFound, LogIntegrityFailed, StorageFailed,
};

// =============================================================================
// SumdbLookupResult — public lookup return shape
// =============================================================================

public type SumdbLookupResult is {
    package_id: PackageScope,
    version: SemVer,
    checksum: Hex64,
    /// Sequence index in the log.
    sequence: Int,
    /// Tile coordinates the client must fetch to verify inclusion.
    proof_tiles: List<TileCoord>,
};

// =============================================================================
// SumdbService
// =============================================================================

public type SumdbService is {
    log: TransparencyLog,
};

implement SumdbService {
    /// Hydrate the transparency-log from the sumdb tables.
    pub async fn from_db(pool: &AsyncPgPool, config: &SumdbConfig) -> Result<SumdbService, Text> {
        // Load operator seed from configured path; for new installs,
        // generate at first run.
        let seed = load_or_init_signing_seed(&config.signing_key_path)
            .map_err(|e| f"signing key: {e}")?;
        let pubkey = public_key(&seed);
        let mut log = log_new(seed, pubkey);

        // Replay all sumdb_entries to rebuild the in-memory log.
        let mut conn = pool.acquire().await.map_err(|e| f"{e}")?;
        let rows = conn.query(
            sql#"SELECT package_id, version, checksum, timestamp
                  FROM sumdb_entries
                  ORDER BY sequence"#,
            (),
        ).await.map_err(|e| f"{e}")?;

        let mut i: Int = 0;
        while i < rows.len() {
            let leaf_text = encode_leaf_text(&rows[i])
                .map_err(|e| f"decode entry {i}: {e}")?;
            let _ = append(&mut log, LogLeaf { bytes: leaf_text.as_bytes().to_list() }, now_unix_ns())
                .map_err(|e| f"replay entry {i}: {e}")?;
            i = i + 1;
        }

        Ok(SumdbService { log: log })
    }

    /// Append a new leaf to the log.  Returns the resulting STH.
    pub async fn append_leaf(
        &mut self,
        leaf_bytes: List<Byte>,
    ) -> Result<SignedTreeHead, SumdbError> {
        append(&mut self.log, LogLeaf { bytes: leaf_bytes }, now_unix_ns())
            .map_err(|e| LogIntegrityFailed(f"{e}"))
    }

    pub async fn lookup(
        &self,
        package: &PackageScope,
        version: &SemVer,
    ) -> Result<SumdbLookupResult, SumdbError>
        using [Database, Cache]
    {
        let v_text = base.semver.format_semver(version);
        let cache_key = f"sumdb:{package}@{v_text}";
        if let Ok(Some(cached)) = Cache.get<SumdbLookupResult>(&cache_key).await {
            return Ok(cached);
        }
        let row_opt = Database.query_one_opt(
            sql#"SELECT sequence, package_id, version, checksum
                  FROM sumdb_entries
                  WHERE package_id = $1 AND version = $2"#,
            (package, &v_text),
        ).await.map_err(|e| StorageFailed(f"{e}"))?;
        let row = row_opt.ok_or(VersionNotInLog {
            package_id: package.clone(),
            version: version.clone(),
        })?;

        let sequence = row.get_int64("sequence")
            .map_err(|e| StorageFailed(f"{e}"))? as Int;
        let checksum_text = row.get_text("checksum")
            .map_err(|e| StorageFailed(f"{e}"))?;
        let checksum = Hex64::try_from(checksum_text)
            .map_err(|e| LogIntegrityFailed(f"{e}"))?;

        // Compute tile coordinates the verifier needs.
        let current_size = self.log.leaves.len();
        let tiles = tiles_for_inclusion(sequence, current_size);

        let result = SumdbLookupResult {
            package_id: package.clone(),
            version: version.clone(),
            checksum: checksum,
            sequence: sequence,
            proof_tiles: tiles,
        };
        let _ = Cache.set(&cache_key, &result, Duration.days(365)).await;
        Ok(result)
    }

    pub async fn latest_tree_head(&self) -> Result<SignedTreeHead, SumdbError>
        using [Cache]
    {
        let cache_key = "sumdb:latest".to_text();
        if let Ok(Some(cached)) = Cache.get<SignedTreeHead>(&cache_key).await {
            return Ok(cached);
        }
        let sth = sign_current_tree_head(&self.log, now_unix_ns())
            .map_err(|e| LogIntegrityFailed(f"{e}"))?;
        let _ = Cache.set(&cache_key, &sth, Duration.seconds(60)).await;
        Ok(sth)
    }

    pub async fn tile(&self, coord: TileCoord) -> Result<Tile, SumdbError>
        using [Cache]
    {
        let cache_key = f"sumdb:tile:{coord.level}:{coord.index}";
        if let Ok(Some(cached)) = Cache.get<Tile>(&cache_key).await {
            return Ok(cached);
        }
        let tile = tile_at(&self.log, coord)
            .map_err(|e| TileNotFound { level: coord.level, index: coord.index })?;
        let _ = Cache.set(&cache_key, &tile, Duration.days(365)).await;
        Ok(tile)
    }
}

// =============================================================================
// Helpers
// =============================================================================

fn load_or_init_signing_seed(path: &Text) -> Result<security.ecc.ed25519.Ed25519Seed, Text> {
    match io.fs.read(path) {
        Ok(bytes) if bytes.len() == 32 => {
            let mut seed: [Byte; 32] = [0_u8; 32];
            let mut i: Int = 0;
            while i < 32 { seed[i] = bytes[i]; i = i + 1; }
            Ok(seed)
        }
        Ok(_) => Err(f"signing key file at {path} has wrong length"),
        Err(_) => {
            // Generate a fresh seed and persist it (mode 0600).
            let seed = generate_seed();
            io.fs.write_with_mode(path, &seed.to_list(), 0o600)
                .map_err(|e| f"write signing key: {e}")?;
            Ok(seed)
        }
    }
}

fn encode_leaf_text(row: &Row) -> Result<Text, Text> {
    // Canonical leaf JSON — matches what publish_service emits for
    // the sumdb_leaf_bytes payload.
    let pkg = row.get_text("package_id").map_err(|e| f"{e}")?;
    let ver = row.get_text("version").map_err(|e| f"{e}")?;
    let chk = row.get_text("checksum").map_err(|e| f"{e}")?;
    let ts = row.get_timestamp("timestamp").map_err(|e| f"{e}")?;
    Ok(format_unsupported(r#"{{"package":"{}","version":"{}","checksum":"{}","timestamp":"{}"}}"#,
                pkg, ver, chk, time.rfc3339.format(&ts)))
}
