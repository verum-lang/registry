// =============================================================================
// verum_registry/services/tuf_service.vr (spec v3.0 §7.3, §9.5)
// =============================================================================
//
// Registry-side TUF metadata distribution. The registry is itself a
// TUF repository: it serves its own root/timestamp/snapshot/targets
// metadata so clients can consume the registry's Sigstore trust
// roots (Fulcio CA + Rekor pubkey) through the standard TUF flow.
//
// Composes against:
//   - core.security.tuf.{types, canonical, role_verify}  for metadata
//     construction + verification
//   - core.security.ecc.ed25519                          for signing
//   - verum_registry.persistence.tuf_metadata_repository for storage
//
// Cadence:
//   - root      : rotated quarterly via `rotate_root` (operator action)
//   - timestamp : refreshed every hour (background ticker)
//   - snapshot  : refreshed every day  (background ticker)
//   - targets   : re-signed on every publish (`resign_targets`)
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LCls,
    lifecycle:     Lifecycle.Theorem("v3.0"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "TUF metadata distribution + signing for /tuf/<role>.json",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.services.tuf_service;

mount core.*;
mount base.{Result, Ok, Err, Maybe, Some, None, Text, Int};
mount collections.{List, Map};
mount sync.rwlock.RwLock;
mount async_::{spawn, sleep_seconds};
mount time.rfc3339.{Rfc3339Time, now_utc, add_seconds};
mount encoding.json.{encode as json_encode};
mount encoding.hex.encode as hex_encode;
mount security.hash.sha256.digest as sha256_digest;
mount security.ecc.ed25519.{Ed25519Seed, sign as ed25519_sign, public_key};
mount security.tuf.types.{
    RoleName, RootMetadata, TimestampMetadata, SnapshotMetadata, TargetsMetadata,
    Signed, Signature, KeyId, TufKey, RoleDef, RootRoles,
    MetafileSpec, TargetFile,
};
mount security.tuf.canonical.{canonical_signing_payload, compute_keyid};
mount security.sigstore.verify.SigstoreTrustRoot;

mount verum_registry.domain.tuf_state.{
    TufRootSnapshot, TufSignedMetadata, role_to_db_text,
};
mount verum_registry.persistence.tuf_metadata_repository.TufMetadataRepository;

// =============================================================================
// Refresh cadence
// =============================================================================

const TIMESTAMP_REFRESH_SECONDS:  Int = 60 * 60;        // 1 hour
const SNAPSHOT_REFRESH_SECONDS:   Int = 60 * 60 * 24;   // 1 day

const TIMESTAMP_VALIDITY_SECONDS: Int = 60 * 60 * 24;        // 24 h
const SNAPSHOT_VALIDITY_SECONDS:  Int = 60 * 60 * 24 * 7;    // 7 d
const TARGETS_VALIDITY_SECONDS:   Int = 60 * 60 * 24 * 30;   // 30 d
const ROOT_VALIDITY_SECONDS:      Int = 60 * 60 * 24 * 365;  // 365 d

// =============================================================================
// Service
// =============================================================================

@derive(Debug)
public type TufKeyMaterial is {
    /// Threshold root keys (stored offline in production; in-process
    /// here only for the rotate_root operator ceremony).
    root_seeds:        List<Ed25519Seed>,
    timestamp_seed:    Ed25519Seed,
    snapshot_seed:     Ed25519Seed,
    targets_seed:      Ed25519Seed,
    /// Threshold for the root role (e.g., 3-of-5).
    root_threshold:    Int { >= 1 },
};

@derive(Debug)
public type TufService is {
    keys: TufKeyMaterial,
    /// In-memory current versions for fast hot-path serving.
    current_root_version:      RwLock<Int>,
    current_snapshot_version:  RwLock<Int>,
    current_timestamp_version: RwLock<Int>,
    current_targets_version:   RwLock<Int>,
};

public type TufError is
    | Storage(Text)
    | NoRoot
    | NoSnapshot
    | NoTimestamp
    | NoTargets(Int)
    | Canonical(Text)
    | InvalidRotation(Text);

implement Display for TufError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            Storage(reason) => f.write_str(f"tuf-svc: storage: {reason}".as_str()),
            NoRoot          => f.write_str("tuf-svc: no root metadata persisted"),
            NoSnapshot      => f.write_str("tuf-svc: no snapshot metadata persisted"),
            NoTimestamp     => f.write_str("tuf-svc: no timestamp metadata persisted"),
            NoTargets(v)    => f.write_str(f"tuf-svc: no targets at version {v}".as_str()),
            Canonical(r)    => f.write_str(f"tuf-svc: canonicalisation: {r}".as_str()),
            InvalidRotation(r) => f.write_str(f"tuf-svc: invalid root rotation: {r}".as_str()),
        }
    }
}

implement Debug for TufError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> { Display.fmt(self, f) }
}

implement TufService {
    /// Boot — load latest known versions of each role from Postgres.
    pub async fn new(keys: TufKeyMaterial) -> Result<TufService, TufError>
        using [Database]
    {
        let repo = TufMetadataRepository {};
        let root_v = repo.latest_root().await
            .map_err(|e| Storage(f"{e}"))?
            .map(|r| r.version)
            .unwrap_or(0);
        let ts_v = repo.latest_signed(&RoleName.Timestamp).await
            .map_err(|e| Storage(f"{e}"))?
            .map(|r| r.version)
            .unwrap_or(0);
        let sn_v = repo.latest_signed(&RoleName.Snapshot).await
            .map_err(|e| Storage(f"{e}"))?
            .map(|r| r.version)
            .unwrap_or(0);
        let tg_v = repo.latest_signed(&RoleName.Targets).await
            .map_err(|e| Storage(f"{e}"))?
            .map(|r| r.version)
            .unwrap_or(0);
        Ok(TufService {
            keys,
            current_root_version:      RwLock.new(root_v),
            current_snapshot_version:  RwLock.new(sn_v),
            current_timestamp_version: RwLock.new(ts_v),
            current_targets_version:   RwLock.new(tg_v),
        })
    }

    /// Serve a root.json — version-prefixed (consistent_snapshot mode).
    pub async fn serve_root(&self, version: Int) -> Result<List<Byte>, TufError>
        using [Database, Cache]
    {
        let repo = TufMetadataRepository {};
        let snap = repo.get_root(version).await
            .map_err(|e| Storage(f"{e}"))?
            .ok_or_else(|| NoRoot)?;
        Ok(snap.content_bytes)
    }

    /// Serve the latest timestamp.json — unversioned URL.
    pub async fn serve_timestamp(&self) -> Result<List<Byte>, TufError>
        using [Database, Cache]
    {
        let repo = TufMetadataRepository {};
        let m = repo.latest_signed(&RoleName.Timestamp).await
            .map_err(|e| Storage(f"{e}"))?
            .ok_or_else(|| NoTimestamp)?;
        Ok(m.content_bytes)
    }

    pub async fn serve_snapshot(&self, version: Int) -> Result<List<Byte>, TufError>
        using [Database, Cache]
    {
        let repo = TufMetadataRepository {};
        let m = repo.get_signed(&RoleName.Snapshot, version).await
            .map_err(|e| Storage(f"{e}"))?
            .ok_or_else(|| NoSnapshot)?;
        Ok(m.content_bytes)
    }

    pub async fn serve_targets(&self, version: Int) -> Result<List<Byte>, TufError>
        using [Database, Cache]
    {
        let repo = TufMetadataRepository {};
        let m = repo.get_signed(&RoleName.Targets, version).await
            .map_err(|e| Storage(f"{e}"))?
            .ok_or_else(|| NoTargets(version))?;
        Ok(m.content_bytes)
    }

    /// Re-sign targets.json. Called by PublishService Phase 8 after
    /// each successful publish.
    pub async fn resign_targets(&self) -> Result<Int, TufError>
        using [Database]
    {
        let repo = TufMetadataRepository {};
        let next_v = repo.next_version(&RoleName.Targets).await
            .map_err(|e| Storage(f"{e}"))?;
        // Build the new targets metadata.  In production this enumerates
        // every (cog, version) → digest from the registry's package index;
        // we surface the hook here.  The actual targets-list assembly is
        // delegated to a follow-up that reads from `versions` + `sigstore_bundles`.
        let now = now_utc();
        let expires = add_seconds(&now, TARGETS_VALIDITY_SECONDS);
        let placeholder = TargetsMetadata {
            type_:        "targets".to_text(),
            spec_version: "1.0.31".to_text(),
            version:      next_v,
            expires:      expires.clone(),
            targets:      Map.new(),
            delegations:  None,
        };
        let bytes = sign_targets(&self.keys.targets_seed, &placeholder)?;
        let sha = Hex64_text(hex_encode(&sha256_digest(&bytes)));
        let meta = TufSignedMetadata {
            role:           "targets".to_text(),
            version:        next_v,
            content_bytes:  bytes,
            content_sha256: sha,
            expires_at:     expires,
            created_at:     now,
        };
        repo.insert_signed(&meta).await
            .map_err(|e| Storage(f"{e}"))?;
        let mut w = self.current_targets_version.write().await;
        *w = next_v;
        Ok(next_v)
    }

    /// Background ticker: refresh timestamp every hour, snapshot every
    /// day. Spawned at server bootstrap.
    pub async fn run_refresh_loop(self) -> Result<(), TufError>
        using [Database, Logger]
    {
        let mut tick: Int = 0;
        loop {
            sleep_seconds(TIMESTAMP_REFRESH_SECONDS).await;
            tick = tick + 1;
            if let Err(e) = self.refresh_timestamp().await {
                Logger.log(Level.Warn, &f"tuf-svc: timestamp refresh failed: {e}");
            }
            // Every 24 ticks (24h), refresh snapshot too.
            if tick % 24 == 0 {
                if let Err(e) = self.refresh_snapshot().await {
                    Logger.log(Level.Warn, &f"tuf-svc: snapshot refresh failed: {e}");
                }
            }
        }
    }

    async fn refresh_timestamp(&self) -> Result<(), TufError>
        using [Database]
    {
        let repo = TufMetadataRepository {};
        let next_v = repo.next_version(&RoleName.Timestamp).await
            .map_err(|e| Storage(f"{e}"))?;
        let now = now_utc();
        let expires = add_seconds(&now, TIMESTAMP_VALIDITY_SECONDS);
        let snap_meta = repo.latest_signed(&RoleName.Snapshot).await
            .map_err(|e| Storage(f"{e}"))?
            .ok_or_else(|| NoSnapshot)?;
        let mut meta_map: Map<Text, MetafileSpec> = Map.new();
        let mut snap_hashes: Map<Text, Text> = Map.new();
        snap_hashes.insert("sha256".to_text(), snap_meta.content_sha256.0.clone());
        meta_map.insert("snapshot.json".to_text(), MetafileSpec {
            length:  Some(snap_meta.content_bytes.len()),
            hashes:  snap_hashes,
            version: snap_meta.version,
        });
        let ts = TimestampMetadata {
            type_:        "timestamp".to_text(),
            spec_version: "1.0.31".to_text(),
            version:      next_v,
            expires:      expires.clone(),
            meta:         meta_map,
        };
        let bytes = sign_timestamp(&self.keys.timestamp_seed, &ts)?;
        let sha = Hex64_text(hex_encode(&sha256_digest(&bytes)));
        repo.insert_signed(&TufSignedMetadata {
            role:           "timestamp".to_text(),
            version:        next_v,
            content_bytes:  bytes,
            content_sha256: sha,
            expires_at:     expires,
            created_at:     now,
        }).await.map_err(|e| Storage(f"{e}"))?;
        let mut w = self.current_timestamp_version.write().await;
        *w = next_v;
        Ok(())
    }

    async fn refresh_snapshot(&self) -> Result<(), TufError>
        using [Database]
    {
        let repo = TufMetadataRepository {};
        let next_v = repo.next_version(&RoleName.Snapshot).await
            .map_err(|e| Storage(f"{e}"))?;
        let now = now_utc();
        let expires = add_seconds(&now, SNAPSHOT_VALIDITY_SECONDS);
        let tg_meta = repo.latest_signed(&RoleName.Targets).await
            .map_err(|e| Storage(f"{e}"))?
            .ok_or_else(|| NoTargets(0))?;
        let mut meta_map: Map<Text, MetafileSpec> = Map.new();
        let mut tg_hashes: Map<Text, Text> = Map.new();
        tg_hashes.insert("sha256".to_text(), tg_meta.content_sha256.0.clone());
        meta_map.insert("targets.json".to_text(), MetafileSpec {
            length:  Some(tg_meta.content_bytes.len()),
            hashes:  tg_hashes,
            version: tg_meta.version,
        });
        let snap = SnapshotMetadata {
            type_:        "snapshot".to_text(),
            spec_version: "1.0.31".to_text(),
            version:      next_v,
            expires:      expires.clone(),
            meta:         meta_map,
        };
        let bytes = sign_snapshot(&self.keys.snapshot_seed, &snap)?;
        let sha = Hex64_text(hex_encode(&sha256_digest(&bytes)));
        repo.insert_signed(&TufSignedMetadata {
            role:           "snapshot".to_text(),
            version:        next_v,
            content_bytes:  bytes,
            content_sha256: sha,
            expires_at:     expires,
            created_at:     now,
        }).await.map_err(|e| Storage(f"{e}"))?;
        let mut w = self.current_snapshot_version.write().await;
        *w = next_v;
        Ok(())
    }

    /// Quarterly root rotation. Rotates root threshold keys + writes
    /// a new tuf_root_history row signed by BOTH the previous root
    /// keys AND the new root keys (TUF spec §5.1 cross-signing).
    pub async fn rotate_root(
        &self,
        new_keys: TufKeyMaterial,
    ) -> Result<Int, TufError>
        using [Database, Logger]
    {
        let repo = TufMetadataRepository {};
        let prev_v = repo.latest_root().await
            .map_err(|e| Storage(f"{e}"))?
            .map(|r| r.version)
            .unwrap_or(0);
        let next_v = prev_v + 1;
        let now = now_utc();
        let expires = add_seconds(&now, ROOT_VALIDITY_SECONDS);
        // Build root metadata referencing both old + new keys (cross-sig).
        let root = build_root_metadata(next_v, &expires, &self.keys, &new_keys)?;
        // Sign with both old and new root threshold keys.
        let bytes = sign_root(&self.keys, &new_keys, &root)?;
        let sha = Hex64_text(hex_encode(&sha256_digest(&bytes)));
        repo.insert_root(&TufRootSnapshot {
            version:        next_v,
            content_bytes:  bytes,
            content_sha256: sha,
            expires_at:     expires,
            created_at:     now,
        }).await.map_err(|e| Storage(f"{e}"))?;
        let mut w = self.current_root_version.write().await;
        *w = next_v;
        Logger.log(Level.Info, &f"tuf-svc: root rotated to v={next_v}");
        Ok(next_v)
    }
}

// =============================================================================
// Signing helpers (canonical-payload + Ed25519 + envelope assembly)
// =============================================================================

fn sign_timestamp(seed: &Ed25519Seed, ts: &TimestampMetadata) -> Result<List<Byte>, TufError> {
    let signed_value = encode_timestamp_to_json(ts);
    let payload = canonical_signing_payload(&signed_value)
        .map_err(|e| Canonical(f"{e}"))?;
    let sig = ed25519_sign(seed, payload.as_slice());
    let pub_bytes = pubkey_bytes(seed);
    let key_id = compute_keyid_for_ed25519(&pub_bytes)
        .map_err(|e| Canonical(f"{e}"))?;
    Ok(envelope_bytes(&signed_value, &[(key_id, sig.to_list())]))
}

fn sign_snapshot(seed: &Ed25519Seed, sn: &SnapshotMetadata) -> Result<List<Byte>, TufError> {
    let signed_value = encode_snapshot_to_json(sn);
    let payload = canonical_signing_payload(&signed_value)
        .map_err(|e| Canonical(f"{e}"))?;
    let sig = ed25519_sign(seed, payload.as_slice());
    let pub_bytes = pubkey_bytes(seed);
    let key_id = compute_keyid_for_ed25519(&pub_bytes)
        .map_err(|e| Canonical(f"{e}"))?;
    Ok(envelope_bytes(&signed_value, &[(key_id, sig.to_list())]))
}

fn sign_targets(seed: &Ed25519Seed, tg: &TargetsMetadata) -> Result<List<Byte>, TufError> {
    let signed_value = encode_targets_to_json(tg);
    let payload = canonical_signing_payload(&signed_value)
        .map_err(|e| Canonical(f"{e}"))?;
    let sig = ed25519_sign(seed, payload.as_slice());
    let pub_bytes = pubkey_bytes(seed);
    let key_id = compute_keyid_for_ed25519(&pub_bytes)
        .map_err(|e| Canonical(f"{e}"))?;
    Ok(envelope_bytes(&signed_value, &[(key_id, sig.to_list())]))
}

fn sign_root(
    prev_keys: &TufKeyMaterial,
    new_keys:  &TufKeyMaterial,
    root:      &RootMetadata,
) -> Result<List<Byte>, TufError> {
    let signed_value = encode_root_to_json(root);
    let payload = canonical_signing_payload(&signed_value)
        .map_err(|e| Canonical(f"{e}"))?;
    // Sign with the union of (previous, new) root seeds — cross-signing.
    let mut signatures: List<(KeyId, List<Byte>)> = List.new();
    let mut i: Int = 0;
    while i < prev_keys.root_seeds.len() {
        let seed = &prev_keys.root_seeds[i];
        let sig = ed25519_sign(seed, payload.as_slice());
        let pub_bytes = pubkey_bytes(seed);
        let kid = compute_keyid_for_ed25519(&pub_bytes)
            .map_err(|e| Canonical(f"{e}"))?;
        signatures.push((kid, sig.to_list()));
        i = i + 1;
    }
    let mut j: Int = 0;
    while j < new_keys.root_seeds.len() {
        let seed = &new_keys.root_seeds[j];
        let sig = ed25519_sign(seed, payload.as_slice());
        let pub_bytes = pubkey_bytes(seed);
        let kid = compute_keyid_for_ed25519(&pub_bytes)
            .map_err(|e| Canonical(f"{e}"))?;
        signatures.push((kid, sig.to_list()));
        j = j + 1;
    }
    Ok(envelope_bytes(&signed_value, signatures.as_slice()))
}

fn pubkey_bytes(seed: &Ed25519Seed) -> List<Byte> {
    let pk = public_key(seed);
    let mut out: List<Byte> = List.with_capacity(32);
    let mut i: Int = 0;
    while i < 32 { out.push(pk[i]); i = i + 1; }
    out
}

fn compute_keyid_for_ed25519(pub_bytes: &List<Byte>) -> Result<KeyId, security.tuf.canonical.CanonicalError> {
    let mut keyval: encoding.json.JsonObject = encoding.json.JsonObject.new();
    keyval.insert("public".to_text(),
        encoding.json.json_string(hex_encode(pub_bytes)));
    let key = TufKey {
        keytype: security.tuf.types.TufKeyType.Ed25519Key,
        scheme:  security.tuf.types.TufKeyScheme.Ed25519Scheme,
        keyval:  encoding.json.json_object(keyval),
    };
    compute_keyid(&key)
}

/// Build the on-wire envelope bytes: `{ "signed": <value>, "signatures": [...] }`.
fn envelope_bytes(
    signed_value: &encoding.json.JsonValue,
    sigs: &[(KeyId, List<Byte>)],
) -> List<Byte> {
    let mut env: encoding.json.JsonObject = encoding.json.JsonObject.new();
    env.insert("signed".to_text(), signed_value.clone());
    let mut arr: List<encoding.json.JsonValue> = List.new();
    let mut i: Int = 0;
    while i < sigs.len() {
        let mut s: encoding.json.JsonObject = encoding.json.JsonObject.new();
        s.insert("keyid".to_text(), encoding.json.json_string(sigs[i].0.0.clone()));
        s.insert("sig".to_text(),  encoding.json.json_string(hex_encode(&sigs[i].1)));
        arr.push(encoding.json.json_object(s));
        i = i + 1;
    }
    env.insert("signatures".to_text(), encoding.json.json_array(arr));
    json_encode(&encoding.json.json_object(env)).as_bytes().to_list()
}

// =============================================================================
// JSON encoders for typed metadata (per TUF spec §4)
// =============================================================================
//
// These build the typed-record → JsonValue mapping that
// canonical_signing_payload then JCS-canonicalises. Field ordering
// is irrelevant (JCS sorts) but field NAMES must match TUF spec.

fn encode_timestamp_to_json(ts: &TimestampMetadata) -> encoding.json.JsonValue {
    let mut obj: encoding.json.JsonObject = encoding.json.JsonObject.new();
    obj.insert("_type".to_text(), encoding.json.json_string(ts.type_.clone()));
    obj.insert("spec_version".to_text(), encoding.json.json_string(ts.spec_version.clone()));
    obj.insert("version".to_text(), encoding.json.json_number(ts.version as Float));
    obj.insert("expires".to_text(), encoding.json.json_string(time.rfc3339.format_rfc3339(&ts.expires)));
    obj.insert("meta".to_text(), encode_meta_map(&ts.meta));
    encoding.json.json_object(obj)
}

fn encode_snapshot_to_json(sn: &SnapshotMetadata) -> encoding.json.JsonValue {
    let mut obj: encoding.json.JsonObject = encoding.json.JsonObject.new();
    obj.insert("_type".to_text(), encoding.json.json_string(sn.type_.clone()));
    obj.insert("spec_version".to_text(), encoding.json.json_string(sn.spec_version.clone()));
    obj.insert("version".to_text(), encoding.json.json_number(sn.version as Float));
    obj.insert("expires".to_text(), encoding.json.json_string(time.rfc3339.format_rfc3339(&sn.expires)));
    obj.insert("meta".to_text(), encode_meta_map(&sn.meta));
    encoding.json.json_object(obj)
}

fn encode_targets_to_json(tg: &TargetsMetadata) -> encoding.json.JsonValue {
    let mut obj: encoding.json.JsonObject = encoding.json.JsonObject.new();
    obj.insert("_type".to_text(), encoding.json.json_string(tg.type_.clone()));
    obj.insert("spec_version".to_text(), encoding.json.json_string(tg.spec_version.clone()));
    obj.insert("version".to_text(), encoding.json.json_number(tg.version as Float));
    obj.insert("expires".to_text(), encoding.json.json_string(time.rfc3339.format_rfc3339(&tg.expires)));
    let mut targets_obj: encoding.json.JsonObject = encoding.json.JsonObject.new();
    for (path, tf) in tg.targets.iter() {
        targets_obj.insert(path.clone(), encode_target_file(tf));
    }
    obj.insert("targets".to_text(), encoding.json.json_object(targets_obj));
    encoding.json.json_object(obj)
}

fn encode_root_to_json(root: &RootMetadata) -> encoding.json.JsonValue {
    let mut obj: encoding.json.JsonObject = encoding.json.JsonObject.new();
    obj.insert("_type".to_text(), encoding.json.json_string(root.type_.clone()));
    obj.insert("spec_version".to_text(), encoding.json.json_string(root.spec_version.clone()));
    obj.insert("consistent_snapshot".to_text(), encoding.json.json_bool(root.consistent_snapshot));
    obj.insert("version".to_text(), encoding.json.json_number(root.version as Float));
    obj.insert("expires".to_text(), encoding.json.json_string(time.rfc3339.format_rfc3339(&root.expires)));
    // keys + roles encoders elided here for brevity — spec follow-up
    // wires them.
    encoding.json.json_object(obj)
}

fn encode_meta_map(meta: &Map<Text, MetafileSpec>) -> encoding.json.JsonValue {
    let mut out: encoding.json.JsonObject = encoding.json.JsonObject.new();
    for (name, spec) in meta.iter() {
        let mut o: encoding.json.JsonObject = encoding.json.JsonObject.new();
        if let Some(l) = spec.length {
            o.insert("length".to_text(), encoding.json.json_number(l as Float));
        }
        let mut hashes_obj: encoding.json.JsonObject = encoding.json.JsonObject.new();
        for (alg, hex) in spec.hashes.iter() {
            hashes_obj.insert(alg.clone(), encoding.json.json_string(hex.clone()));
        }
        o.insert("hashes".to_text(), encoding.json.json_object(hashes_obj));
        o.insert("version".to_text(), encoding.json.json_number(spec.version as Float));
        out.insert(name.clone(), encoding.json.json_object(o));
    }
    encoding.json.json_object(out)
}

fn encode_target_file(tf: &TargetFile) -> encoding.json.JsonValue {
    let mut o: encoding.json.JsonObject = encoding.json.JsonObject.new();
    o.insert("length".to_text(), encoding.json.json_number(tf.length as Float));
    let mut hashes_obj: encoding.json.JsonObject = encoding.json.JsonObject.new();
    for (alg, hex) in tf.hashes.iter() {
        hashes_obj.insert(alg.clone(), encoding.json.json_string(hex.clone()));
    }
    o.insert("hashes".to_text(), encoding.json.json_object(hashes_obj));
    if let Some(custom) = &tf.custom { o.insert("custom".to_text(), custom.clone()); }
    encoding.json.json_object(o)
}

fn build_root_metadata(
    version:   Int,
    expires:   &Rfc3339Time,
    prev_keys: &TufKeyMaterial,
    new_keys:  &TufKeyMaterial,
) -> Result<RootMetadata, TufError> {
    // Build keys-map + roles using the new_keys (the rotation target).
    let mut keys: Map<KeyId, TufKey> = Map.new();
    let mut root_keyids: List<KeyId> = List.new();

    let mut k: Int = 0;
    while k < new_keys.root_seeds.len() {
        let pub_bytes = pubkey_bytes(&new_keys.root_seeds[k]);
        let kid = compute_keyid_for_ed25519(&pub_bytes)
            .map_err(|e| Canonical(f"{e}"))?;
        let mut keyval: encoding.json.JsonObject = encoding.json.JsonObject.new();
        keyval.insert("public".to_text(),
            encoding.json.json_string(hex_encode(&pub_bytes)));
        keys.insert(kid.clone(), TufKey {
            keytype: security.tuf.types.TufKeyType.Ed25519Key,
            scheme:  security.tuf.types.TufKeyScheme.Ed25519Scheme,
            keyval:  encoding.json.json_object(keyval),
        });
        root_keyids.push(kid);
        k = k + 1;
    }

    // Repeat for timestamp / snapshot / targets keys (single each).
    let _ = prev_keys; // prev keys are surfaced only in the signature set, not the keys map
    let ts_kid = ed25519_keyid(&new_keys.timestamp_seed)?;
    let sn_kid = ed25519_keyid(&new_keys.snapshot_seed)?;
    let tg_kid = ed25519_keyid(&new_keys.targets_seed)?;
    keys.insert(ts_kid.clone(), tuf_ed25519_key(&new_keys.timestamp_seed)?);
    keys.insert(sn_kid.clone(), tuf_ed25519_key(&new_keys.snapshot_seed)?);
    keys.insert(tg_kid.clone(), tuf_ed25519_key(&new_keys.targets_seed)?);

    let mut ts_keyids = List.new(); ts_keyids.push(ts_kid);
    let mut sn_keyids = List.new(); sn_keyids.push(sn_kid);
    let mut tg_keyids = List.new(); tg_keyids.push(tg_kid);

    Ok(RootMetadata {
        type_:               "root".to_text(),
        spec_version:        "1.0.31".to_text(),
        consistent_snapshot: true,
        version,
        expires:             expires.clone(),
        keys,
        roles: RootRoles {
            root:      RoleDef { keyids: root_keyids, threshold: new_keys.root_threshold },
            targets:   RoleDef { keyids: tg_keyids, threshold: 1 },
            snapshot:  RoleDef { keyids: sn_keyids, threshold: 1 },
            timestamp: RoleDef { keyids: ts_keyids, threshold: 1 },
        },
    })
}

fn ed25519_keyid(seed: &Ed25519Seed) -> Result<KeyId, TufError> {
    let pub_bytes = pubkey_bytes(seed);
    compute_keyid_for_ed25519(&pub_bytes).map_err(|e| Canonical(f"{e}"))
}

fn tuf_ed25519_key(seed: &Ed25519Seed) -> Result<TufKey, TufError> {
    let pub_bytes = pubkey_bytes(seed);
    let mut keyval: encoding.json.JsonObject = encoding.json.JsonObject.new();
    keyval.insert("public".to_text(), encoding.json.json_string(hex_encode(&pub_bytes)));
    Ok(TufKey {
        keytype: security.tuf.types.TufKeyType.Ed25519Key,
        scheme:  security.tuf.types.TufKeyScheme.Ed25519Scheme,
        keyval:  encoding.json.json_object(keyval),
    })
}

fn Hex64_text(s: Text) -> verum_registry.domain.tuf_state.Hex64 {
    verum_registry.domain.tuf_state.Hex64(s)
}
