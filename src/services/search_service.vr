// =============================================================================
// verum_registry/services/search_service.vr — package search
// =============================================================================
// Spec: §7.2
//
// Wraps MeiliSearch (or any future `core.search.*` adapter) for
// faceted full-text search over the registry index.  Read-only;
// the index is updated asynchronously by `PublishService.phase8_post_publish`.
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LCls,
    lifecycle:     Lifecycle.Theorem("v2.0"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "registry search service — faceted full-text + sort over packages",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.services.search_service;

mount core.*;
mount base.{Result, Ok, Err, Maybe, Some, None, Text};
mount collections.List;
mount core.cog.manifest.LanguageProfile;
mount architecture.types.Lifecycle;
mount database.postgres.row.Row;

mount verum_registry.domain.{
    PackageRecord, PackageScope, SpdxExpression, VerificationLevel,
    SearchError, InvalidQuery, SearchBackendFailed,
};
// `RateLimited` collides across PublishError / SearchError; reach
// the SearchError variant by qualified path at construction sites.
mount verum_registry.domain.errors.RateLimited as SearchRateLimited;

// =============================================================================
// SearchQuery — input shape (refinement-typed pagination)
// =============================================================================

public type SearchQuery is {
    /// Free-text query.
    q: Text,
    /// Faceted filters.
    cve_lifecycle: Maybe<Lifecycle>,
    language_profile: Maybe<LanguageProfile>,
    verification_level_min: Maybe<VerificationLevel>,
    license: Maybe<SpdxExpression>,
    /// Pagination.
    page: Int { >= 0 },
    per_page: Int { >= 1, <= 100 },
    sort: SortMode,
};

public type SortMode is
      SortRelevance
    | SortDownloads
    | SortRecent
    | SortScore;

// =============================================================================
// SearchBackendQuery / SearchIndexedDocument — adapter wire shapes
// =============================================================================
//
// Lightweight projections produced by `render_backend_query` /
// `render_indexed_document` ahead of the call into the concrete
// search adapter (Meilisearch + future SQLite-fts shadow).  They
// exist as a stable boundary between the registry's domain query
// surface and the backend's native dialect.

@derive(Clone, Debug)
public type SearchBackendQuery is {
    text: Text,
};

@derive(Clone, Debug)
public type SearchIndexedDocument is {
    id:                 Text,
    description:        Text,
    keywords:           List<Text>,
    latest_version:     SemVer,
    downloads:          Int,
    score:              Float,
    cve_lifecycle:      Lifecycle,
    language_profile:   LanguageProfile,
    verification_level: VerificationLevel,
};

public fn sort_mode_tag(s: &SortMode) -> Text {
    match s {
        SortRelevance => "relevance".to_text(),
        SortDownloads => "downloads".to_text(),
        SortRecent    => "recent".to_text(),
        SortScore     => "score".to_text(),
    }
}

// =============================================================================
// SearchResults
// =============================================================================

public type SearchResults is {
    /// Matching packages on this page.
    hits: List<PackageRecord>,
    /// Total matches across all pages.
    total: Int,
    /// 0-indexed page number echoed back.
    page: Int,
    /// per_page echoed back.
    per_page: Int,
};

// =============================================================================
// SearchService
// =============================================================================

public type SearchService is {};

implement SearchService {
    pub async fn search(
        &self,
        query: SearchQuery,
    ) -> Result<SearchResults, SearchError>
        using [Search, Cache, Metrics, Logger]
    {
        Metrics.increment("search.requests");
        // Cheap query-validity check.
        if query.q.is_empty() && query.cve_lifecycle.is_none()
            && query.language_profile.is_none() && query.license.is_none() {
            return Err(InvalidQuery("query must include either text or a filter".to_text()));
        }

        // Cache check (anonymous-cacheable).  Cache key embeds the full
        // query shape so distinct queries don't collide.
        let cache_key = render_cache_key(&query);
        if let Ok(Some(cached)) = Cache.get<SearchResults>(&cache_key).await {
            Metrics.increment("search.cache_hits");
            return Ok(cached);
        }

        // Delegate to Search backend.
        let results = Search.search_packages(&render_backend_query(&query))
            .await
            .map_err(|e| SearchBackendFailed(f"{e}"))?;

        // Cache for 60 seconds.  Hot queries dominate; aggressive cache
        // is appropriate for an eventually-consistent search index.
        let _ = Cache.set(&cache_key, &results, Duration.seconds(60)).await;

        Ok(results)
    }

    /// Rebuild / refresh the index for a single package version.  Called
    /// by PublishService after a successful publish.
    pub async fn index_package_version(
        &self,
        version: &PackageVersion,
    ) -> Result<(), SearchError> using [Search, Database] {
        // Look up the package metadata to assemble the indexed document.
        let pkg = self.lookup_package(&version.package_id).await?;
        let doc = render_indexed_document(&pkg, version);
        Search.upsert_indexed_document(&doc)
            .await
            .map_err(|e| SearchBackendFailed(f"{e}"))
    }

    async fn lookup_package(
        &self,
        id: &PackageScope,
    ) -> Result<PackageRecord, SearchError> using [Database] {
        let row_opt = Database.query_one_opt(
            sql#"""SELECT id, description, homepage, repository, license, keywords,
                        latest_version, downloads, score, created_at, updated_at
                  FROM packages WHERE id = $1""",
            (id,),
        ).await.map_err(|e| SearchBackendFailed(f"{e}"))?;
        match row_opt {
            Some(row) => decode_package_row(&row),
            None => Err(SearchBackendFailed(f"package not found: {id}")),
        }
    }
}

// =============================================================================
// Helpers
// =============================================================================

fn render_cache_key(q: &SearchQuery) -> Text {
    f"search:{q.q}:{q.cve_lifecycle:?}:{q.language_profile:?}:{q.verification_level_min:?}:{q.license:?}:{q.page}:{q.per_page}:{sort_mode_tag(&q.sort)}"
}

fn render_backend_query(q: &SearchQuery) -> SearchBackendQuery {
    // Translate to the Search adapter's native query shape.
    SearchBackendQuery {
        text: q.q.clone(),
        // Filters / sort / pagination passed through.
        // Concrete adapter handles the dialect.
    }
}

fn render_indexed_document(pkg: &PackageRecord, ver: &PackageVersion) -> SearchIndexedDocument {
    SearchIndexedDocument {
        id: pkg.id.clone(),
        description: pkg.description.clone(),
        keywords: pkg.keywords.clone(),
        latest_version: ver.version.clone(),
        downloads: pkg.downloads,
        score: pkg.score,
        cve_lifecycle: ver.cve_lifecycle.clone(),
        language_profile: ver.language_profile.clone(),
        verification_level: ver.verification_level.clone(),
    }
}

fn decode_package_row(row: &Row) -> Result<PackageRecord, SearchError> {
    Ok(PackageRecord {
        id: row.get_text("id").map_err(|e| SearchBackendFailed(f"{e}"))?,
        description: row.get_text("description").map_err(|e| SearchBackendFailed(f"{e}"))?,
        homepage: row.get_text_opt("homepage").ok().flatten(),
        repository: row.get_text_opt("repository").ok().flatten(),
        license: row.get_text("license").map_err(|e| SearchBackendFailed(f"{e}"))?,
        keywords: row.get_text_array("keywords").unwrap_or_default(),
        latest_version: base.semver.parse(&row.get_text("latest_version")
            .map_err(|e| SearchBackendFailed(f"{e}"))?)
            .map_err(|e| SearchBackendFailed(f"{e}"))?,
        downloads: row.get_int64("downloads").unwrap_or(0) as Int,
        score: row.get_int("score").unwrap_or(0),
        created_at: row.get_timestamp("created_at").map_err(|e| SearchBackendFailed(f"{e}"))?,
        updated_at: row.get_timestamp("updated_at").map_err(|e| SearchBackendFailed(f"{e}"))?,
        owners: List.new(),  // owners loaded separately
    })
}
