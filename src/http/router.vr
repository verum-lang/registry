// =============================================================================
// verum_registry/http/router.vr — route table
// =============================================================================
// Spec: §8.2
//
// All routes under `/api/v2/...`, plus `/sumdb/`, `/health/`, `/metrics`.
// Path parameters use refined extractors via `core.net.weft.refined_routes`
// where the path component carries a refinement (scope, name, version).
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Theorem("v2.0"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "registry HTTP route table — wires handlers to URL paths",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.http.router;

mount core.*;
mount net.weft.{Router, Method};

mount verum_registry.services.ServiceRegistry;
mount verum_registry.http.handlers.{
    packages, publish, search, sumdb, auth, owners, advisories,
    health as health_handlers,
};

/// Build the full registry router.
public fn make_router(services: ServiceRegistry) -> Router {
    let mut router = Router.new()
        .with_state(services);

    // ===== /api/v2/packages =====
    router = router
        .get("/api/v2/packages/:scope/:name", packages.get_package)
        .get("/api/v2/packages/:scope/:name/versions", packages.list_versions)
        .get("/api/v2/packages/:scope/:name/:version", packages.get_version)
        .get("/api/v2/packages/:scope/:name/:version/source", packages.get_source)
        .get("/api/v2/packages/:scope/:name/:version/manifest", packages.get_manifest)
        .get("/api/v2/packages/:scope/:name/:version/provenance", packages.get_provenance)
        .post("/api/v2/packages", publish.handle_publish)
        .post("/api/v2/packages/:scope/:name/:version/yank", publish.handle_yank)
        .post("/api/v2/packages/:scope/:name/:version/unyank", publish.handle_unyank);

    // Owners
    router = router
        .get("/api/v2/packages/:scope/:name/owners", owners.list_owners)
        .post("/api/v2/packages/:scope/:name/owners", owners.invite_owner)
        .delete("/api/v2/packages/:scope/:name/owners/:user", owners.remove_owner);

    // ===== /api/v2/search =====
    router = router.get("/api/v2/search", search.handle_search);

    // ===== /api/v2/resolve =====
    router = router.post("/api/v2/resolve", search.handle_resolve);

    // ===== /api/v2/auth =====
    router = router
        .post("/api/v2/auth/login", auth.handle_login)
        .post("/api/v2/auth/oidc/discover/:provider", auth.handle_oidc_discover)
        .post("/api/v2/auth/tokens", auth.handle_create_token)
        .delete("/api/v2/auth/tokens/:id", auth.handle_revoke_token);

    // ===== /api/v2/users =====
    router = router.get("/api/v2/users/:username", auth.handle_get_user_profile);

    // ===== /api/v2/advisories =====
    router = router
        .get("/api/v2/advisories", advisories.list_advisories)
        .get("/api/v2/advisories/:id", advisories.get_advisory);

    // ===== /sumdb =====
    router = router
        .get("/sumdb/lookup/:scope/:name@:version", sumdb.handle_lookup)
        .get("/sumdb/latest", sumdb.handle_latest)
        .get("/sumdb/tile/:level/:index", sumdb.handle_tile);

    // ===== /health =====
    router = router
        .get("/health/live", health_handlers.handle_liveness)
        .get("/health/ready", health_handlers.handle_readiness)
        .get("/health/version", health_handlers.handle_version);

    router
}
