// =============================================================================
// verum_registry/http/handlers/search.vr — search + resolve
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Theorem("v2.0"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "search + resolve handlers",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.http.handlers.search;

mount core.*;
mount context.standard.{Logger, Metrics, Cache, Database};
mount base.{Result, Ok, Err, Maybe, Some, None, Text};
mount net.weft.{WeftRequest, Response, StatusCode, Json};
mount verum_registry.services.{SearchService, SearchQuery, SortMode};
mount verum_registry.http.error_response.{render_error, render_simple_error};

// GET /api/v2/search?q=...
public async fn handle_search(req: WeftRequest) -> Response
    using [SearchService, Search, Cache, Metrics, Logger]
{
    let q = req.query_param("q").unwrap_or_else(|| "".to_text());
    let page = req.query_param("page").and_then(|s| s.parse<Int>().ok()).unwrap_or(0);
    let per_page = req.query_param("per_page").and_then(|s| s.parse<Int>().ok()).unwrap_or(20);
    let sort = match req.query_param("sort").unwrap_or_else(|| "relevance".to_text()).as_str() {
        "downloads" => SortMode.SortDownloads,
        "recent"    => SortMode.SortRecent,
        "score"     => SortMode.SortScore,
        _           => SortMode.SortRelevance,
    };
    let query = SearchQuery {
        q, cve_lifecycle: None, language_profile: None,
        verification_level_min: None, license: None,
        page, per_page, sort,
    };
    match SearchService.search(query).await {
        Ok(results) => Response.json(&results),
        Err(e) => {
            Logger.log(Level.Warn, f"search error: {e:?}");
            render_simple_error(
            "invalid_query".to_text(),
            "search failed".to_text()
        )
                .status(StatusCode.BadRequest)
        }
    }
}

// POST /api/v2/resolve — dependency resolver (stubbed pending G5/resolve).
public async fn handle_resolve(req: WeftRequest) -> Response {
    let _ = req;
    render_simple_error(
            "not_implemented".to_text(),
            "dependency resolver pending Stdlib-G5/resolve (pubgrub)".to_text()
        ).status(StatusCode.NotImplemented)
}
