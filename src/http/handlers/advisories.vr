// =============================================================================
// verum_registry/http/handlers/advisories.vr
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Theorem("v2.0"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "security advisory endpoints — list + lookup",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.http.handlers.advisories;

mount core.*;
mount base.{Result, Ok, Err, Maybe, Some, None, Text};
mount net.weft.{WeftRequest, Response, StatusCode};

mount verum_registry.persistence.{
    AdvisoryRepository,
    list_advisories_for_package, lookup_advisory,
};
mount verum_registry.domain.{PackageScope, AdvisoryId};
mount verum_registry.http.error_response.{render_error};

// GET /api/v2/advisories?package=...
public async fn list_advisories(req: WeftRequest) -> Response
    using [AdvisoryRepository, Logger]
{
    let pkg_text = match req.query_param("package") {
        Some(p) => p,
        None    => return render_error("validation_failed".to_text(),
            "missing 'package' query parameter".to_text(), None, None,
        ).status(StatusCode.BadRequest),
    };
    let id: PackageScope = match pkg_text.try_into() {
        Ok(s)  => s,
        Err(_) => return render_error("validation_failed".to_text(),
            "invalid package scope".to_text(), None, None,
        ).status(StatusCode.BadRequest),
    };
    match list_advisories_for_package(&AdvisoryRepository, &id).await {
        Ok(adv) => Response.json(&adv),
        Err(e) => {
            Logger.log(Level.Error, f"list_advisories: {e}");
            render_error("internal_error".to_text(),
                "advisory lookup failed".to_text(), None, None,
            ).status(StatusCode.InternalServerError)
        }
    }
}

// GET /api/v2/advisories/:id
public async fn get_advisory(req: WeftRequest) -> Response
    using [AdvisoryRepository, Logger]
{
    let id_text = req.path_param("id").unwrap_or_else(|| "".to_text());
    let id: AdvisoryId = match id_text.try_into() {
        Ok(i)  => i,
        Err(_) => return render_error("validation_failed".to_text(),
            "invalid advisory id (expected VSEC-YYYY-NNNN)".to_text(), None, None,
        ).status(StatusCode.BadRequest),
    };
    match lookup_advisory(&AdvisoryRepository, &id).await {
        Ok(Some(adv)) => Response.json(&adv),
        Ok(None) => render_error("advisory_not_found".to_text(),
            f"no such advisory: {id}".to_text(), None, None,
        ).status(StatusCode.NotFound),
        Err(_) => render_error("internal_error".to_text(),
            "advisory lookup failed".to_text(), None, None,
        ).status(StatusCode.InternalServerError),
    }
}
