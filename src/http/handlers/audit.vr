// =============================================================================
// verum_registry/http/handlers/audit.vr (spec §9.1, §12)
// =============================================================================
// Routes:
//   GET /api/audit/lifecycle                          — corpus distribution
//   GET /api/audit/anti-patterns                      — corpus AP roster
//   GET /api/audit/anti-patterns/:scope/:name/:version — per-cog AP roster
//   GET /api/audit/cve-bundle/:scope/:name/:version    — dual-audience bundle
//   GET /api/audit/self                               — registry's own audit
//
// All responses are exhaustive auditor-JSON by default.  When the
// `Accept` header includes `text/plain`, the developer summary text
// is returned instead — this powers the `verum audit <cog>` CLI.
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Theorem("canonical"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "HTTP handlers for /api/audit/{lifecycle,anti-patterns,cve-bundle,self}".to_text(),
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.http.handlers.audit;

mount core.*;
mount base.{Result, Ok, Err, Maybe, Some, None, Text, Int};
mount collections.List;
mount net.weft.{WeftRequest, Response, StatusCode};
mount encoding.json.{JsonValue, json_object, json_string, json_array, json_number};

mount verum_registry.audit.{
    LifecycleDistribution, lifecycle_distribution_for_corpus,
    PosetViolation, detect_poset_violations,
    AntiPatternRoster, AntiPatternFinding, AntiPatternId,
    CorpusAntiPatternSummary, summarise_corpus_anti_patterns,
    anti_pattern_roster_for_cog, all_ap_ids,
    CveBundle, render_developer_summary, render_auditor_json,
    SelfAuditResult, run_self_audit,
};
mount verum_registry.audit.anti_patterns.{ap_id_text, ap_name};
mount verum_registry.persistence.cog_audit_repository.CogAuditRepository;
mount verum_registry.http.error_response.render_error;

const POSET_MAX_DEPTH: Int = 8;

// =============================================================================
// GET /api/audit/lifecycle
// =============================================================================

pub async fn lifecycle(_req: WeftRequest) -> Response
    using [Database, Logger]
{
    let dist = match lifecycle_distribution_for_corpus().await {
        Ok(d)  => d,
        Err(e) => return render_error("internal_error".to_text(),
            f"{e}", None, None,
        ).status(StatusCode.InternalServerError),
    };
    let violations = detect_poset_violations(POSET_MAX_DEPTH).await
        .unwrap_or_else(|_| List.new());

    let mut d = encoding.json.JsonObject.new();
    d.insert("theorem".to_text(),       json_number(dist.theorem        as Float));
    d.insert("definition".to_text(),    json_number(dist.definition     as Float));
    d.insert("conditional".to_text(),   json_number(dist.conditional    as Float));
    d.insert("postulate".to_text(),     json_number(dist.postulate      as Float));
    d.insert("hypothesis".to_text(),    json_number(dist.hypothesis     as Float));
    d.insert("interpretation".to_text(),json_number(dist.interpretation as Float));
    d.insert("retracted".to_text(),     json_number(dist.retracted      as Float));
    d.insert("total".to_text(),         json_number(dist.total          as Float));

    let mut arr: List<JsonValue> = List.with_capacity(violations.len());
    let mut i: Int = 0;
    while i < violations.len() {
        let v = &violations[i];
        let mut e = encoding.json.JsonObject.new();
        e.insert("highRankCog".to_text(),       json_string(v.high_rank_cog.clone()));
        e.insert("highRankLifecycle".to_text(), json_string(v.high_rank.clone()));
        e.insert("lowRankCog".to_text(),        json_string(v.low_rank_cog.clone()));
        e.insert("lowRankLifecycle".to_text(),  json_string(v.low_rank.clone()));
        e.insert("depth".to_text(),             json_number(v.depth as Float));
        arr.push(json_object(e));
        i = i + 1;
    }

    let mut obj = encoding.json.JsonObject.new();
    obj.insert("schemaVersion".to_text(), json_string("1.0".to_text()));
    obj.insert("distribution".to_text(), json_object(d));
    obj.insert("posetViolations".to_text(), json_array(arr));
    Response.json(&json_object(obj))
}

// =============================================================================
// GET /api/audit/anti-patterns           — corpus
// GET /api/audit/anti-patterns/:scope/:name/:version  — per-cog
// =============================================================================

pub async fn corpus_anti_patterns(_req: WeftRequest) -> Response
    using [Database, Logger]
{
    let summary = match summarise_corpus_anti_patterns().await {
        Ok(s)  => s,
        Err(e) => return render_error("internal_error".to_text(),
            f"{e}", None, None,
        ).status(StatusCode.InternalServerError),
    };
    let mut obj = encoding.json.JsonObject.new();
    obj.insert("schemaVersion".to_text(), json_string("1.0".to_text()));
    obj.insert("cogsTotal".to_text(),       json_number(summary.cogs_total        as Float));
    obj.insert("cogsWithErrors".to_text(),  json_number(summary.cogs_with_errors  as Float));
    obj.insert("cogsWarningOnly".to_text(), json_number(summary.cogs_warning_only as Float));
    obj.insert("cogsClean".to_text(),       json_number(summary.cogs_clean        as Float));
    let mut counts: List<JsonValue> = List.with_capacity(summary.counts_by_id.len());
    let mut i: Int = 0;
    while i < summary.counts_by_id.len() {
        let (id, n) = &summary.counts_by_id[i];
        let mut e = encoding.json.JsonObject.new();
        e.insert("id".to_text(),    json_string(ap_id_text(id)));
        e.insert("name".to_text(),  json_string(ap_name(id)));
        e.insert("count".to_text(), json_number(*n as Float));
        counts.push(json_object(e));
        i = i + 1;
    }
    obj.insert("perPatternCounts".to_text(), json_array(counts));
    Response.json(&json_object(obj))
}

pub async fn cog_anti_patterns(req: WeftRequest) -> Response
    using [CogAuditRepository, Database, Logger]
{
    let cog_id = match cog_id_from_req(&req) {
        Ok(s)  => s,
        Err(r) => return r,
    };
    let repo = CogAuditRepository {};
    let roster = match repo.fetch_roster(&cog_id).await {
        Ok(Some(r)) => r,
        Ok(None) => return render_error("not_found".to_text(),
            f"no audit record for {cog_id}", None, None,
        ).status(StatusCode.NotFound),
        Err(e) => return render_error("internal_error".to_text(),
            f"{e}", None, None,
        ).status(StatusCode.InternalServerError),
    };
    Response.json(&roster_to_json(&roster))
}

fn roster_to_json(r: &AntiPatternRoster) -> JsonValue {
    let mut obj = encoding.json.JsonObject.new();
    obj.insert("cog".to_text(),          json_string(r.cog.clone()));
    obj.insert("errorCount".to_text(),   json_number(r.error_count   as Float));
    obj.insert("warningCount".to_text(), json_number(r.warning_count as Float));
    let mut arr: List<JsonValue> = List.with_capacity(r.findings.len());
    let mut i: Int = 0;
    while i < r.findings.len() {
        arr.push(finding_to_json(&r.findings[i]));
        i = i + 1;
    }
    obj.insert("findings".to_text(), json_array(arr));
    json_object(obj)
}

fn finding_to_json(f: &AntiPatternFinding) -> JsonValue {
    let mut o = encoding.json.JsonObject.new();
    o.insert("id".to_text(),    json_string(ap_id_text(&f.id)));
    o.insert("name".to_text(),  json_string(ap_name(&f.id)));
    let (verdict, msg) = match &f.verdict {
        verum_registry.audit.AntiPatternVerdict.Ok          => ("ok".to_text(),      None),
        verum_registry.audit.AntiPatternVerdict.Warning(m)  => ("warning".to_text(), Some(m.clone())),
        verum_registry.audit.AntiPatternVerdict.Error(m)    => ("error".to_text(),   Some(m.clone())),
    };
    o.insert("verdict".to_text(), json_string(verdict));
    if let Some(m) = msg { o.insert("message".to_text(), json_string(m)); }
    if let Some(c) = &f.cite { o.insert("cite".to_text(), json_string(c.clone())); }
    json_object(o)
}

// =============================================================================
// GET /api/audit/cve-bundle/:scope/:name/:version
// =============================================================================

pub async fn cog_cve_bundle(req: WeftRequest) -> Response
    using [CogAuditRepository, Database, Logger]
{
    let cog_id = match cog_id_from_req(&req) {
        Ok(s)  => s,
        Err(r) => return r,
    };
    let repo = CogAuditRepository {};
    let bundle = match repo.fetch_cve_bundle(&cog_id).await {
        Ok(Some(b)) => b,
        Ok(None) => return render_error("not_found".to_text(),
            f"no audit record for {cog_id}", None, None,
        ).status(StatusCode.NotFound),
        Err(e) => return render_error("internal_error".to_text(),
            f"{e}", None, None,
        ).status(StatusCode.InternalServerError),
    };

    if accept_text_plain(&req) {
        return Response.text(render_developer_summary(&bundle).text)
            .header("content-type", "text/plain; charset=utf-8");
    }
    Response.json(&render_auditor_json(&bundle).value)
}

// =============================================================================
// GET /api/audit/self  — registry's own bundle
// =============================================================================

pub async fn self_audit(req: WeftRequest) -> Response
    using [Logger]
{
    let result = match run_self_audit().await {
        Ok(r)  => r,
        Err(e) => return render_error("internal_error".to_text(),
            f"{e}", None, None,
        ).status(StatusCode.InternalServerError),
    };
    if accept_text_plain(&req) {
        return Response.text(result.summary.text)
            .header("content-type", "text/plain; charset=utf-8");
    }
    Response.json(&result.auditor_json.value)
}

// =============================================================================
// Helpers
// =============================================================================

fn cog_id_from_req(req: &WeftRequest) -> Result<Text, Response> {
    let scope = req.path_param("scope").unwrap_or_else(|| "".to_text());
    let name  = req.path_param("name").unwrap_or_else(|| "".to_text());
    let ver   = req.path_param("version").unwrap_or_else(|| "".to_text());
    if name.is_empty() || ver.is_empty() {
        return Err(render_error("validation_failed".to_text(),
            "missing scope/name/version".to_text(), None, None,
        ).status(StatusCode.BadRequest));
    }
    let id = if scope.is_empty() { f"{name}@{ver}" }
             else { f"{scope}/{name}@{ver}" };
    Ok(id.to_text())
}

fn accept_text_plain(req: &WeftRequest) -> Bool {
    match req.header("accept") {
        Some(a) => a.contains("text/plain"),
        None    => false,
    }
}
