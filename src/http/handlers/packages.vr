// =============================================================================
// verum_registry/http/handlers/packages.vr — read-side package endpoints
// =============================================================================
// Spec: §8.2  GET /api/v2/packages/:scope/:name {...}
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Theorem("v2.0"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "package read endpoints — metadata, versions, source, manifest, provenance",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.http.handlers.packages;

mount core.*;
mount context.standard.{Logger, Metrics, Cache, Database};
mount base.{Result, Ok, Err, Maybe, Some, None, Text};
mount net.weft.{WeftRequest, Response, StatusCode, refined_routes};
mount base.semver.parse as parse_semver;

mount verum_registry.persistence.{
    PackageRepository, VersionRepository, ObjectStore,
    lookup_package as repo_lookup_package,
    lookup_version, list_versions,
    get_source_archive,
};
mount verum_registry.domain.{PackageScope, SemVer};
mount verum_registry.http.error_response.{render_error, render_simple_error};

// =============================================================================
// GET /:scope/:name — package metadata
// =============================================================================

public async fn get_package(req: WeftRequest) -> Response
    using [PackageRepository, OwnerRepository, AdvisoryRepository, Logger]
{
    let id = match scope_name_param(&req) {
        Ok(s)  => s,
        Err(r) => return r,
    };
    match repo_lookup_package(&PackageRepository, &id).await {
        Ok(Some(pkg)) => Response.json(&pkg),
        Ok(None)      => render_simple_error(
            "package_not_found".to_text(),
            f"package {id} not found".to_text()
        ).status(StatusCode.NotFound),
        Err(e) => {
            Logger.log(Level.Error, f"lookup_package: {e}");
            render_simple_error(
            "internal_error".to_text(),
            "lookup failed".to_text()
        )
                .status(StatusCode.InternalServerError)
        }
    }
}

// =============================================================================
// GET /:scope/:name/versions — version list
// =============================================================================

public async fn list_versions(req: WeftRequest) -> Response
    using [VersionRepository, Logger]
{
    let id = match scope_name_param(&req) { Ok(s) => s, Err(r) => return r };
    let include_yanked = req.query_param("include_yanked")
        .map(|s| s == "true").unwrap_or(false);
    match list_versions(&VersionRepository, &id, include_yanked).await {
        Ok(vs) => Response.json(&vs),
        Err(e) => {
            Logger.log(Level.Error, f"list_versions: {e}");
            render_simple_error(
            "internal_error".to_text(),
            "list failed".to_text()
        )
                .status(StatusCode.InternalServerError)
        }
    }
}

// =============================================================================
// GET /:scope/:name/:version — version metadata
// =============================================================================

public async fn get_version(req: WeftRequest) -> Response
    using [VersionRepository, Logger]
{
    let (id, version) = match scope_name_version_param(&req) { Ok(t) => t, Err(r) => return r };
    match lookup_version(&VersionRepository, &id, &version).await {
        Ok(Some(v)) => Response.json(&v),
        Ok(None)    => render_simple_error(
            "version_not_found".to_text(),
            f"version {version} not found".to_text()
        ).status(StatusCode.NotFound),
        Err(e) => {
            Logger.log(Level.Error, f"lookup_version: {e}");
            render_simple_error(
            "internal_error".to_text(),
            "lookup failed".to_text()
        )
                .status(StatusCode.InternalServerError)
        }
    }
}

// =============================================================================
// GET /:scope/:name/:version/source — 302 to S3 (with signed URL)
// =============================================================================

public async fn get_source(req: WeftRequest) -> Response
    using [PackageRepository, ObjectStore, Logger, Metrics]
{
    let (id, version) = match scope_name_version_param(&req) { Ok(t) => t, Err(r) => return r };
    Metrics.increment("downloads.source");
    // Issue a 302 redirect to a presigned S3 URL.  Streaming the
    // archive bytes through the registry is also supported but the
    // spec defaults to redirect.
    let url = ObjectStore.presigned_source_url(&id, &version, Duration.minutes(15)).await
        .unwrap_or_else(|e| {
            Logger.log(Level.Error, f"presign: {e}");
            "".to_text()
        });
    if url.is_empty() {
        render_simple_error(
            "internal_error".to_text(),
            "source unavailable".to_text()
        )
            .status(StatusCode.InternalServerError)
    } else {
        Response.new()
            .status(StatusCode.Found)
            .header("Location", &url)
    }
}

// =============================================================================
// GET /:scope/:name/:version/manifest — verum.toml
// =============================================================================

public async fn get_manifest(req: WeftRequest) -> Response
    using [VersionRepository, ObjectStore, Logger]
{
    let (id, version) = match scope_name_version_param(&req) { Ok(t) => t, Err(r) => return r };
    // Manifest is recovered by unpacking the source archive's
    // verum.toml entry.  This is rare-path; we serve the archive
    // and let the client re-extract.  (Optimisation: cache extracted
    // manifests in Redis under `manifest:<id>:<version>`.)
    let _ = (id, version);
    render_simple_error(
            "not_implemented".to_text(),
            "manifest extraction served via /source".to_text()
        ).status(StatusCode.NotImplemented)
}

// =============================================================================
// GET /:scope/:name/:version/provenance — DSSE envelope
// =============================================================================

public async fn get_provenance(req: WeftRequest) -> Response
    using [VersionRepository, Logger]
{
    let (id, version) = match scope_name_version_param(&req) { Ok(t) => t, Err(r) => return r };
    match lookup_version(&VersionRepository, &id, &version).await {
        Ok(Some(v)) => match &v.provenance {
            Some(envelope) => Response.text(envelope)
                .header("Content-Type", "application/vnd.dsse.envelope+json"),
            None => render_simple_error(
            "provenance_not_available".to_text(),
            "this version has no provenance attestation".to_text()
        ).status(StatusCode.NotFound),
        },
        Ok(None) => render_simple_error(
            "version_not_found".to_text(),
            f"version {version} not found".to_text()
        ).status(StatusCode.NotFound),
        Err(e) => {
            Logger.log(Level.Error, f"lookup_version: {e}");
            render_simple_error(
            "internal_error".to_text(),
            "lookup failed".to_text()
        )
                .status(StatusCode.InternalServerError)
        }
    }
}

// =============================================================================
// Path-parameter extractors
// =============================================================================

fn scope_name_param(req: &WeftRequest) -> Result<PackageScope, Response> {
    let scope = req.path_param("scope").ok_or_else(|| missing_param("scope"))?;
    let name = req.path_param("name").ok_or_else(|| missing_param("name"))?;
    let combined = if scope.starts_with("@") {
        f"{scope}/{name}".to_text()
    } else {
        name.clone()
    };
    // PackageScope is a Text newtype (`type PackageScope is CogName`); accept any
    // syntactically combined value — registry-side validation happens upstream.
    Ok(combined)
}

fn scope_name_version_param(req: &WeftRequest) -> Result<(PackageScope, SemVer), Response> {
    let id = scope_name_param(req)?;
    let version_text = req.path_param("version")
        .ok_or_else(|| missing_param("version"))?;
    let version = parse_semver(&version_text)
        .map_err(|e| render_simple_error(
            "validation_failed".to_text(),
            f"invalid version: {e}".to_text()
        ).status(StatusCode.BadRequest))?;
    Ok((id, version))
}

fn missing_param(name: &str) -> Response {
    render_simple_error(
            "validation_failed".to_text(),
            f"missing path parameter: {name}".to_text()
        ).status(StatusCode.BadRequest)
}
