// =============================================================================
// verum_registry/http/handlers/sumdb.vr
// =============================================================================
// Spec: §8.2  /sumdb/lookup, /sumdb/latest, /sumdb/tile/:level/:index
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Theorem("v2.0"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "sumdb HTTP endpoints — lookup, tree-head, tile",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.http.handlers.sumdb;

mount core.*;
mount base.{Result, Ok, Err, Maybe, Some, None, Text};
mount net.weft.{WeftRequest, Response, StatusCode};
mount base.semver.{parse as parse_semver};
mount security.transparency_log.TileCoord;

mount verum_registry.services.SumdbService;
mount verum_registry.domain.PackageScope;
mount verum_registry.http.error_response.{render_error};

// GET /sumdb/lookup/:scope/:name@:version
public async fn handle_lookup(req: WeftRequest) -> Response
    using [SumdbService, Database, Cache]
{
    let scope = req.path_param("scope").unwrap_or_else(|| "".to_text());
    let name = req.path_param("name").unwrap_or_else(|| "".to_text());
    let version_text = req.path_param("version").unwrap_or_else(|| "".to_text());
    let combined = if scope.starts_with("@") { f"{scope}/{name}".to_text() } else { name };
    let id: PackageScope = match combined.try_into() {
        Ok(s)  => s,
        Err(_) => return render_error("validation_failed".to_text(),
            "invalid scope/name".to_text(), None, None,
        ).status(StatusCode.BadRequest),
    };
    let version = match parse_semver(&version_text) {
        Ok(v)  => v,
        Err(_) => return render_error("validation_failed".to_text(),
            "invalid version".to_text(), None, None,
        ).status(StatusCode.BadRequest),
    };
    match SumdbService.lookup(&id, &version).await {
        Ok(result) => Response.json(&result)
            .header("Cache-Control", "public, max-age=31536000, immutable"),
        Err(_) => render_error("version_not_in_log".to_text(),
            f"no sumdb entry for {id}@{version}".to_text(), None, None,
        ).status(StatusCode.NotFound),
    }
}

// GET /sumdb/latest
public async fn handle_latest(req: WeftRequest) -> Response
    using [SumdbService, Cache]
{
    let _ = req;
    match SumdbService.latest_tree_head().await {
        Ok(sth) => Response.json(&sth)
            .header("Cache-Control", "public, max-age=60"),
        Err(_) => render_error("internal_error".to_text(),
            "tree head unavailable".to_text(), None, None,
        ).status(StatusCode.InternalServerError),
    }
}

// GET /sumdb/tile/:level/:index
public async fn handle_tile(req: WeftRequest) -> Response
    using [SumdbService, Cache]
{
    let level: Int = req.path_param("level").and_then(|s| s.parse().ok()).unwrap_or(-1);
    let index: Int = req.path_param("index").and_then(|s| s.parse().ok()).unwrap_or(-1);
    if level < 0 || index < 0 {
        return render_error("validation_failed".to_text(),
            "level/index must be non-negative".to_text(), None, None,
        ).status(StatusCode.BadRequest);
    }
    match SumdbService.tile(TileCoord { level, index }).await {
        Ok(tile) => Response.json(&tile)
            .header("Cache-Control", "public, max-age=31536000, immutable"),
        Err(_) => render_error("tile_not_found".to_text(),
            f"tile (level={level}, index={index}) not found".to_text(),
            None, None,
        ).status(StatusCode.NotFound),
    }
}
