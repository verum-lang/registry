// =============================================================================
// verum_registry/http/handlers/webauthn.vr (spec v3.0 §8.2)
// =============================================================================
// Routes:
//   POST /api/v3/auth/webauthn/register/begin     — RegistrationOptions
//   POST /api/v3/auth/webauthn/register/finish    — verify + persist
//   POST /api/v3/auth/webauthn/authenticate/begin — AuthenticationOptions
//   POST /api/v3/auth/webauthn/authenticate/finish— verify + session
//   GET  /api/v3/auth/passkeys                    — list user's passkeys
//   DELETE /api/v3/auth/passkeys/:id              — revoke
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Theorem("v3.0"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "HTTP handlers for WebAuthn registration / authentication / passkey management",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.http.handlers.webauthn;

mount core.*;
mount base.{Result, Ok, Err, Maybe, Some, None, Text, Bool, Int};
mount collections.List;
mount base.ulid.Ulid;
mount net.weft.{WeftRequest, Response, StatusCode};
mount encoding.json.{JsonValue, json_object, json_string, json_array, json_bool};
mount encoding.base64.{
    encode_url_no_pad as b64url_encode,
    decode_url_no_pad as b64url_decode,
};

mount verum_registry.services.webauthn_service.{WebAuthnService, WebAuthnServiceError};
mount verum_registry.services.auth_service.{AuthService, AuthenticatedUser};
mount verum_registry.domain.user.UserId;
mount verum_registry.domain.passkey.Passkey;
mount verum_registry.http.error_response.render_error;
mount security.webauthn.types.{
    AuthenticatorAttestationResponse, AuthenticatorAssertionResponse,
};

// =============================================================================
// Begin / finish — registration
// =============================================================================

/// POST /api/v3/auth/webauthn/register/begin
pub async fn register_begin(req: WeftRequest) -> Response
    using [WebAuthnService, AuthService, Cache, Database, Logger]
{
    let user = match AuthService.session_user(&req).await {
        Ok(u)  => u,
        Err(_) => return render_error("auth_required".to_text(),
            "session required".to_text(), None, None,
        ).status(StatusCode.Unauthorized),
    };
    match WebAuthnService.begin_registration(&user.user).await {
        Ok((challenge_id, options)) => {
            let mut obj = Map.new();
            obj.insert("challengeId".to_text(), json_string(challenge_id));
            obj.insert("publicKey".to_text(), registration_options_to_json(&options));
            Response.json(&json_object(obj))
        }
        Err(e) => {
            Logger.log(Level.Warn, &f"webauthn register/begin: {e}");
            render_error("internal_error".to_text(),
                f"{e}", None, None,
            ).status(StatusCode.InternalServerError)
        }
    }
}

/// POST /api/v3/auth/webauthn/register/finish
pub async fn register_finish(req: WeftRequest) -> Response
    using [WebAuthnService, AuthService, Cache, Database, Logger]
{
    let user = match AuthService.session_user(&req).await {
        Ok(u)  => u,
        Err(_) => return render_error("auth_required".to_text(),
            "session required".to_text(), None, None,
        ).status(StatusCode.Unauthorized),
    };
    let body: RegisterFinishBody = match req.json().await {
        Ok(b)  => b,
        Err(_) => return render_error("validation_failed".to_text(),
            "invalid JSON body".to_text(), None, None,
        ).status(StatusCode.BadRequest),
    };
    let resp = match decode_attestation_response(&body) {
        Ok(r)  => r,
        Err(e) => return render_error("validation_failed".to_text(),
            e, None, None,
        ).status(StatusCode.BadRequest),
    };
    match WebAuthnService.finish_registration(
        &user.user.id, &body.challenge_id, &resp, body.nickname,
    ).await {
        Ok(passkey) => {
            let mut obj = Map.new();
            obj.insert("passkeyId".to_text(), json_string(passkey.id.0.clone()));
            obj.insert("aaguid".to_text(),
                json_string(encoding.hex.encode(&passkey.aaguid)));
            Response.json(&json_object(obj)).status(StatusCode.Created)
        }
        Err(WebAuthnServiceError.WebAuthn(_)) => render_error(
            "webauthn_verification_failed".to_text(),
            "registration response verification failed".to_text(),
            None, None,
        ).status(StatusCode.BadRequest),
        Err(e) => {
            Logger.log(Level.Warn, &f"webauthn register/finish: {e}");
            render_error("internal_error".to_text(),
                f"{e}", None, None,
            ).status(StatusCode.InternalServerError)
        }
    }
}

// =============================================================================
// Begin / finish — authentication
// =============================================================================

/// POST /api/v3/auth/webauthn/authenticate/begin
pub async fn authenticate_begin(req: WeftRequest) -> Response
    using [WebAuthnService, Cache, Database, Logger]
{
    // The body MAY include a username for non-discoverable login.
    let body: AuthBeginBody = req.json().await.unwrap_or_else(|_| AuthBeginBody { username: None });
    let user_handle = match &body.username {
        Some(u) => Some(UserId(u.clone())),
        None    => None,
    };
    let user_handle_ref = user_handle.as_ref();
    match WebAuthnService.begin_authentication(user_handle_ref).await {
        Ok((challenge_id, options)) => {
            let mut obj = Map.new();
            obj.insert("challengeId".to_text(), json_string(challenge_id));
            obj.insert("publicKey".to_text(), authentication_options_to_json(&options));
            Response.json(&json_object(obj))
        }
        Err(e) => {
            Logger.log(Level.Warn, &f"webauthn auth/begin: {e}");
            render_error("internal_error".to_text(),
                f"{e}", None, None,
            ).status(StatusCode.InternalServerError)
        }
    }
}

/// POST /api/v3/auth/webauthn/authenticate/finish
pub async fn authenticate_finish(req: WeftRequest) -> Response
    using [WebAuthnService, AuthService, Cache, Database, Logger]
{
    let body: AuthFinishBody = match req.json().await {
        Ok(b)  => b,
        Err(_) => return render_error("validation_failed".to_text(),
            "invalid JSON body".to_text(), None, None,
        ).status(StatusCode.BadRequest),
    };
    let credential_id = match b64url_decode(&body.credential_id_b64) {
        Ok(b) => b,
        Err(_) => return render_error("validation_failed".to_text(),
            "credentialId not base64url".to_text(), None, None,
        ).status(StatusCode.BadRequest),
    };
    let assertion = match decode_assertion_response(&body) {
        Ok(r)  => r,
        Err(e) => return render_error("validation_failed".to_text(),
            e, None, None,
        ).status(StatusCode.BadRequest),
    };

    match WebAuthnService.finish_authentication(
        &body.challenge_id, &credential_id, &assertion,
    ).await {
        Ok((user_id, _result)) => {
            let session_token = AuthService.issue_session_token(&user_id).await
                .unwrap_or_else(|_| "".to_text());
            let mut obj = Map.new();
            obj.insert("userId".to_text(), json_string(user_id.0.clone()));
            obj.insert("sessionToken".to_text(), json_string(session_token));
            Response.json(&json_object(obj))
        }
        Err(WebAuthnServiceError.WebAuthn(_)) | Err(WebAuthnServiceError.UnknownCredential)
        | Err(WebAuthnServiceError.ChallengeMismatch) | Err(WebAuthnServiceError.InvalidChallenge) => render_error(
            "webauthn_verification_failed".to_text(),
            "authentication failed".to_text(),
            None, None,
        ).status(StatusCode.Unauthorized),
        Err(e) => {
            Logger.log(Level.Warn, &f"webauthn auth/finish: {e}");
            render_error("internal_error".to_text(),
                f"{e}", None, None,
            ).status(StatusCode.InternalServerError)
        }
    }
}

// =============================================================================
// Passkey management
// =============================================================================

/// GET /api/v3/auth/passkeys
pub async fn list_passkeys(req: WeftRequest) -> Response
    using [WebAuthnService, AuthService, Database, Logger]
{
    let user = match AuthService.session_user(&req).await {
        Ok(u)  => u,
        Err(_) => return render_error("auth_required".to_text(),
            "session required".to_text(), None, None,
        ).status(StatusCode.Unauthorized),
    };
    match WebAuthnService.list_passkeys(&user.user.id).await {
        Ok(pks) => {
            let mut arr: List<JsonValue> = List.with_capacity(pks.len());
            let mut i: Int = 0;
            while i < pks.len() {
                arr.push(passkey_summary_to_json(&pks[i]));
                i = i + 1;
            }
            Response.json(&json_array(arr))
        }
        Err(e) => {
            Logger.log(Level.Warn, &f"list_passkeys: {e}");
            render_error("internal_error".to_text(),
                f"{e}", None, None,
            ).status(StatusCode.InternalServerError)
        }
    }
}

/// DELETE /api/v3/auth/passkeys/:id
pub async fn revoke_passkey(req: WeftRequest) -> Response
    using [WebAuthnService, AuthService, Database, Logger]
{
    let user = match AuthService.session_user(&req).await {
        Ok(u)  => u,
        Err(_) => return render_error("auth_required".to_text(),
            "session required".to_text(), None, None,
        ).status(StatusCode.Unauthorized),
    };
    let id_text = req.path_param("id").unwrap_or_else(|| "".to_text());
    let pk_id = match Ulid.parse(&id_text) {
        Ok(u)  => u,
        Err(_) => return render_error("validation_failed".to_text(),
            "invalid passkey id".to_text(), None, None,
        ).status(StatusCode.BadRequest),
    };
    match WebAuthnService.revoke_passkey(&user.user.id, &pk_id).await {
        Ok(())  => Response.text("revoked").status(StatusCode.NoContent),
        Err(WebAuthnServiceError.UnknownCredential) => render_error(
            "passkey_not_found".to_text(),
            "no such passkey".to_text(), None, None,
        ).status(StatusCode.NotFound),
        Err(e) => {
            Logger.log(Level.Warn, &f"revoke_passkey: {e}");
            render_error("internal_error".to_text(),
                f"{e}", None, None,
            ).status(StatusCode.InternalServerError)
        }
    }
}

// =============================================================================
// Wire DTOs + JSON helpers
// =============================================================================

@derive(Deserialize)
type RegisterFinishBody is {
    challenge_id:        Text,
    /// base64url-encoded clientDataJSON.
    client_data_json:    Text,
    /// base64url-encoded attestationObject.
    attestation_object:  Text,
    transports:          List<Text>,
    nickname:            Maybe<Text>,
};

@derive(Deserialize, Default)
type AuthBeginBody is {
    username: Maybe<Text>,
};

@derive(Deserialize)
type AuthFinishBody is {
    challenge_id:           Text,
    /// base64url credentialId.
    credential_id_b64:      Text,
    client_data_json:       Text,
    authenticator_data:     Text,
    signature:              Text,
    user_handle:            Maybe<Text>,
};

fn decode_attestation_response(body: &RegisterFinishBody) -> Result<AuthenticatorAttestationResponse, Text> {
    let cd = b64url_decode(&body.client_data_json)
        .map_err(|e| f"clientDataJSON: {e}")?;
    let att = b64url_decode(&body.attestation_object)
        .map_err(|e| f"attestationObject: {e}")?;
    Ok(AuthenticatorAttestationResponse {
        client_data_json:   cd,
        attestation_object: att,
        transports:         body.transports.clone(),
    })
}

fn decode_assertion_response(body: &AuthFinishBody) -> Result<AuthenticatorAssertionResponse, Text> {
    let cd = b64url_decode(&body.client_data_json)
        .map_err(|e| f"clientDataJSON: {e}")?;
    let auth_data = b64url_decode(&body.authenticator_data)
        .map_err(|e| f"authenticatorData: {e}")?;
    let sig = b64url_decode(&body.signature)
        .map_err(|e| f"signature: {e}")?;
    let user_handle = match &body.user_handle {
        Some(uh) => Some(b64url_decode(uh).map_err(|e| f"userHandle: {e}")?),
        None     => None,
    };
    Ok(AuthenticatorAssertionResponse {
        client_data_json:   cd,
        authenticator_data: auth_data,
        signature:          sig,
        user_handle,
    })
}

fn registration_options_to_json(o: &security.webauthn.register.RegistrationOptions) -> JsonValue {
    let mut obj = Map.new();
    obj.insert("challenge".to_text(), json_string(b64url_encode(&o.challenge)));
    obj.insert("rpId".to_text(),      json_string(o.rp.id.clone()));
    obj.insert("rpName".to_text(),    json_string(o.rp.name.clone()));
    let mut user_obj = Map.new();
    user_obj.insert("id".to_text(),          json_string(b64url_encode(&o.user.id)));
    user_obj.insert("name".to_text(),        json_string(o.user.name.clone()));
    user_obj.insert("displayName".to_text(), json_string(o.user.display_name.clone()));
    obj.insert("user".to_text(), json_object(user_obj));
    let mut params: List<JsonValue> = List.new();
    let mut i: Int = 0;
    while i < o.pub_key_cred_params.len() {
        let mut p = Map.new();
        p.insert("type".to_text(), json_string("public-key".to_text()));
        p.insert("alg".to_text(),  encoding.json.json_number(o.pub_key_cred_params[i].cose_alg as Float));
        params.push(json_object(p));
        i = i + 1;
    }
    obj.insert("pubKeyCredParams".to_text(), json_array(params));
    json_object(obj)
}

fn authentication_options_to_json(o: &security.webauthn.authenticate.AuthenticationOptions) -> JsonValue {
    let mut obj = Map.new();
    obj.insert("challenge".to_text(), json_string(b64url_encode(&o.challenge)));
    obj.insert("rpId".to_text(),      json_string(o.rp_id.clone()));
    let mut allow: List<JsonValue> = List.new();
    let mut i: Int = 0;
    while i < o.allow_credentials.len() {
        let mut e = Map.new();
        e.insert("type".to_text(), json_string("public-key".to_text()));
        e.insert("id".to_text(), json_string(b64url_encode(&o.allow_credentials[i].credential_id)));
        allow.push(json_object(e));
        i = i + 1;
    }
    obj.insert("allowCredentials".to_text(), json_array(allow));
    json_object(obj)
}

fn passkey_summary_to_json(p: &Passkey) -> JsonValue {
    let mut obj = Map.new();
    obj.insert("id".to_text(), json_string(p.id.0.clone()));
    obj.insert("aaguid".to_text(), json_string(encoding.hex.encode(&p.aaguid)));
    obj.insert("nickname".to_text(),
        match &p.nickname {
            Some(n) => json_string(n.clone()),
            None    => encoding.json.json_null(),
        });
    obj.insert("attestationFormat".to_text(),
        json_string(security.webauthn.types.attestation_format_to_text(&p.attestation_format)));
    obj.insert("backupEligible".to_text(), json_bool(p.backup_eligible));
    obj.insert("backupState".to_text(),    json_bool(p.backup_state));
    obj.insert("createdAt".to_text(),
        json_string(time.rfc3339.format_rfc3339(&p.created_at)));
    obj.insert("lastUsedAt".to_text(),
        match &p.last_used_at {
            Some(t) => json_string(time.rfc3339.format_rfc3339(t)),
            None    => encoding.json.json_null(),
        });
    json_object(obj)
}
