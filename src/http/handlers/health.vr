// =============================================================================
// verum_registry/http/handlers/health.vr — health probes
// =============================================================================
// Spec: §8.2  /health/{live, ready, version}
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LFnd,
    lifecycle:     Lifecycle.Theorem("v2.0"),
    declarations: ShapeDeclarations {
        purpose: Some(Purpose {
            role: "Kubernetes-style health endpoints",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate: Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring: Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:   Some(ExecutabilitySense.StructuralReadiness),
        self_reference: None,
    },
)
module verum_registry.http.handlers.health;

mount core.*;
mount base.{Result, Ok, Err, Text};
mount net.weft.{WeftRequest, Response, StatusCode};

// GET /health/live — process is up.
public async fn handle_liveness(req: WeftRequest) -> Response {
    let _ = req;
    Response.text("OK")
}

// GET /health/ready — all dependencies are reachable.
public async fn handle_readiness(req: WeftRequest) -> Response
    using [Database, Storage, Cache, Search]
{
    let _ = req;
    let mut failures: List<Text> = List.new();

    if let Err(e) = Database.ping().await { failures.push(f"postgres: {e}"); }
    if let Err(e) = Storage.head_bucket().await { failures.push(f"s3: {e}"); }
    if let Err(e) = Cache.ping().await { failures.push(f"redis: {e}"); }
    if let Err(e) = Search.health().await { failures.push(f"meilisearch: {e}"); }

    if failures.is_empty() {
        Response.text("READY")
    } else {
        Response.json(&json! {{
            "ready": false,
            "failures": failures,
        }}).status(StatusCode.ServiceUnavailable)
    }
}

// GET /health/version — registry build info.
public async fn handle_version(req: WeftRequest) -> Response {
    let _ = req;
    Response.json(&json! {{
        "registry":     "verum-registry",
        "spec":         "v2.0",
        "verum_stdlib": @env("VERUM_STDLIB_VERSION", "unknown"),
        "build":        @env("CARGO_PKG_VERSION", "unknown"),
        "git_sha":      @env("GIT_SHA", "unknown"),
    }})
}
